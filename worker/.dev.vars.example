# Copy this file to `.dev.vars` and fill in real values.
# `.dev.vars` is gitignored. Never commit it.
#
# Wrangler reads .dev.vars for local `wrangler dev` runs.
# Production values are set as Worker secrets via `wrangler secret put NAME`
# (or pasted in the Cloudflare dashboard → Worker → Settings → Variables).

# Railway Postgres connection string. Needed locally for `wrangler dev` and
# for the initial DDL run via psql. In production, the Worker reads through
# the Hyperdrive binding (env.WAITLIST_DB.connectionString), so this var is
# only used at dev time.
RAILWAY_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# Resend API key. Scope: Sending access, restricted to sur9e.com.
# Generate at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HMAC secret used to sign confirmation links in the welcome email.
# Generate with: openssl rand -hex 32
# Treat as a secret — rotating it invalidates all outstanding confirmation
# links, so only rotate when you're OK with that.
CONFIRM_SECRET=replace_with_64_hex_chars_from_openssl_rand_hex_32
