# Copy this file to `.dev.vars` and fill in real values.
# `.dev.vars` is gitignored. Never commit it.
#
# Wrangler reads .dev.vars for local `wrangler dev` runs.
# Production values are set as Worker secrets via `wrangler secret put NAME`
# (or pasted in the Cloudflare dashboard → Worker → Settings → Variables).

# Railway Postgres connection string. Needed locally for `wrangler dev` and
# for the initial DDL run via the init-db script. In production, the Worker
# reads through the Hyperdrive binding (env.SUBSCRIBE_DB.connectionString), so
# this var is only used at dev time.
RAILWAY_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# Resend API key. Scope: Sending access, restricted to sur9e.com.
# Generate at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HMAC secret used to sign one-click unsubscribe links.
# Generate with: openssl rand -hex 32
# CUTOVER: set this to the OLD worker's CONFIRM_SECRET value, so unsubscribe
# links already mailed under /api/waitlist/unsubscribe keep verifying.
# Rotating it invalidates all outstanding unsubscribe links.
UNSUBSCRIBE_SECRET=replace_with_64_hex_chars_from_openssl_rand_hex_32

# Where to send "new subscriber" admin ping emails. Optional — if unset, the
# Worker logs the signup but skips sending the notification. Useful for
# getting an inbox ping every time someone subscribes (or resubscribes after
# a previous unsubscribe).
ADMIN_NOTIFY_EMAIL=you@example.com
