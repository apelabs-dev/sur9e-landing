---
// Standalone fidelity test page for the vendored read-only report viewer.
// Build-time (Node) parse of the real, user-approved Sift report .md into a
// ReportR, then renders it through the <ReportCard> React island on a plain
// white page so 1:1 fidelity vs. the product can be judged.
//
// NOT linked from the site. Reachable at /_reportcard-test during dev/build.

import ReportCard from '../report-vendor/ReportCard';
import { loadReport } from '../report-vendor/load-report';

import '../report-vendor/styles/tokens.css';
import '../report-vendor/styles/report-light.css';
import '../report-vendor/styles/chrome.css';
import '../report-vendor/styles/report-hero.css';
import '../report-vendor/styles/report-snapshot.css';
import '../report-vendor/styles/report-inline.css';
import '../report-vendor/styles/tiptap-editor.css';

const report = loadReport();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ReportCard fidelity test</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* General Sans — loaded locally (same files the landing's tokens.css uses).
         Declared here because this standalone page does not import the landing
         tokens.css; the vendored tokens.css has no @font-face. */
      @font-face {
        font-family: "General Sans";
        src: url("/fonts/general-sans/GeneralSans-Regular.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "General Sans";
        src: url("/fonts/general-sans/GeneralSans-Medium.woff2") format("woff2");
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "General Sans";
        src: url("/fonts/general-sans/GeneralSans-Semibold.woff2") format("woff2");
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "General Sans";
        src: url("/fonts/general-sans/GeneralSans-Bold.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
      }
      .reportcard-test-stage {
        max-width: 980px;
        margin: 0 auto;
        padding: 32px 24px 96px;
      }
    </style>
  </head>
  <body>
    <main class="reportcard-test-stage">
      <ReportCard client:load report={report} />
    </main>
  </body>
</html>
