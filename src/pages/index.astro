---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
---
<Base>
<a class="skip-link" href="#top">Skip to content</a>

<!-- ============== NAV (merged from v2) ============== -->
<Nav />


<main id="main">

<!-- ============== SECTION 1 · HERO ============== -->
<Hero />

<!-- ============== SECTION 2 · HOW IT WORKS ============== -->
<HowItWorks />


<!-- ============== SECTION 3 · FEATURES ============== -->
<section class="features" id="features">
  <div class="wrap">
    <div class="section-head features-head reveal">
      <span class="eyebrow">Not another job search tool</span>
      <h2>Other tools fix resumes.<br /><span class="accent">Sur9e scores the job.</span></h2>
      <p>Keyword matchers check if a resume fits a JD. Sur9e checks if the role is worth the time — against career history, goals, and dealbreakers.</p>
    </div>

    <div class="feature-list">

      <!-- F1: Evaluate -->
      <article class="feature reveal tier-low">
        <div class="feature-copy">
          <div class="feature-icon g1" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 14 16 10"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg></div>
          <h3>Reasoning you can read, <em>not a match percentage</em></h3>
          <p>Every role scored across <span class="accent">10 weighted dimensions</span> against the CV, projects, and career signals. Full reasoning for why it fits — or doesn't. Not "78% match."</p>
          <div class="tag-row">
            <span class="pill">10 dimensions</span>
            <span class="pill">Comp analysis</span>
            <span class="pill">Dealbreaker flags</span>
            <span class="pill">Archetype detection</span>
          </div>
        </div>
        <div class="feature-shot">
          <!-- Mobile-only report card (mirrors desktop .shot-report) -->
          <div class="shot-m shot-m-report" aria-hidden="true">
            <div class="shot-chrome">
              <span class="d"></span><span class="d"></span><span class="d"></span>
              <span class="crumbs">workspace / offers / report 0617</span>
            </div>
            <div class="shot-m-body">
              <div class="shot-m-row">
                <div class="mark">D</div>
                <div style="flex:1; min-width:0;">
                  <h4>Deepgram</h4>
                  <p class="role">Solutions Architect (Post-Sales SE)</p>
                </div>
                <div style="text-align:right;">
                  <div class="shot-m-score"><span class="num">4.3</span><span class="denom">/5</span></div>
                  <div class="shot-m-segbar" style="width:96px; margin-left:auto;">
                    <span class="seg on"></span><span class="seg on"></span><span class="seg on"></span><span class="seg on"></span><span class="seg"></span>
                  </div>
                </div>
              </div>
              <p class="meta" style="margin-top: 10px;">$140K–$200K · Remote EST/PST · Series C · Apr 30</p>
              <p class="shot-m-lede">Strong fit. CV maps to every must-have — 20+ enterprise partners and full SE cycle map dead-center. Voice AI is the only gap, but role is support-focused.</p>
              <hr class="shot-m-divider" />
              <div class="shot-m-dims">
                <div class="shot-m-dim"><span>CV match</span><span class="bar"><span style="width:90%"></span></span><span class="v">4.5</span></div>
                <div class="shot-m-dim"><span>Seniority</span><span class="bar"><span style="width:84%"></span></span><span class="v">4.2</span></div>
                <div class="shot-m-dim"><span>Comp</span><span class="bar"><span style="width:80%"></span></span><span class="v">4.0</span></div>
                <div class="shot-m-dim warn"><span>Domain</span><span class="bar"><span style="width:76%"></span></span><span class="v">3.8</span></div>
                <div class="shot-m-dim"><span>Legit / Geo</span><span class="bar"><span style="width:100%"></span></span><span class="v">5.0</span></div>
              </div>
            </div>
          </div>
          <div class="shot shot-report">
            <div class="shot-chrome">
              <span class="d"></span><span class="d"></span><span class="d"></span>
              <span class="crumbs">workspace / offers / report 0617</span>
            </div>
            <div style="padding: 20px 24px 24px;" class="report-body">
              <div class="row1">
                <div>
                  <div class="id-row">
                    <div class="mark">D</div>
                    <div>
                      <h4>Deepgram</h4>
                      <p class="role">Solutions Architect (Post-Sales SE)</p>
                    </div>
                  </div>
                  <div class="meta">
                    <span>$140K–$200K</span><span class="sep">·</span>
                    <span>Remote · EST/PST</span><span class="sep">·</span>
                    <span>Series C</span><span class="sep">·</span>
                    <span>Apr 30, 2026</span>
                  </div>
                </div>
                <div class="score-block">
                  <div class="score-num">4.3<span class="denom">/5</span></div>
                  <div class="bar">
                    <span class="seg on"></span><span class="seg on"></span><span class="seg on"></span><span class="seg on"></span><span class="seg"></span>
                  </div>
                </div>
              </div>
              <div class="lede">Strong fit. CV maps to every must-have — 20+ enterprise partners and full SE cycle map dead-center. Voice AI is the only gap, but role is support-focused, not voice-engineering.</div>
              <div class="dim-list" style="margin-top: 14px;">
                <div class="dim"><span class="label">CV match</span><span class="meter"><span data-w="90" style="width:90%"></span></span><span class="v">4.5</span></div>
                <div class="dim"><span class="label">Seniority</span><span class="meter"><span data-w="84" style="width:84%"></span></span><span class="v">4.2</span></div>
                <div class="dim"><span class="label">Comp</span><span class="meter"><span data-w="80" style="width:80%"></span></span><span class="v">4.0</span></div>
                <div class="dim warn"><span class="label">Domain</span><span class="meter"><span data-w="76" style="width:76%"></span></span><span class="v">3.8</span></div>
                <div class="dim"><span class="label">Legit / Geo</span><span class="meter"><span data-w="100" style="width:100%"></span></span><span class="v">5.0</span></div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- F2: Connect -->
      <article class="feature flip reveal tier-mid">
        <div class="feature-copy">
          <div class="feature-icon g2" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="7" r="4"/><path d="M10.3 15H7a4 4 0 0 0-4 4v2"/><circle cx="17" cy="17" r="3"/><path d="m21 21-1.9-1.9"/></svg></div>
          <h3>Find <em>the person</em> behind the posting</h3>
          <p>Every open role gets buried under <span style="color: var(--score-low)">400+</span> resumes nobody reads. Sur9e skips the pile — finds the hiring manager and drafts the warm intro, grounded in real experience, not a template.</p>
          <div class="tag-row">
            <span class="pill">HM discovery</span>
            <span class="pill">LinkedIn outreach</span>
            <span class="pill">Warm-path messaging</span>
          </div>
        </div>
        <div class="feature-shot">
          <!-- Mobile-only outreach card (mirrors desktop .shot-outreach) -->
          <div class="shot-m shot-m-outreach" aria-hidden="true">
            <div class="shot-chrome">
              <span class="d"></span><span class="d"></span><span class="d"></span>
              <span class="crumbs">outreach / deepgram / sr. sa</span>
            </div>
            <div class="shot-m-body">
              <div class="shot-m-row">
                <div class="shot-m-avatar">VP</div>
                <div style="flex:1; min-width:0;">
                  <h4>VP of Solutions Engineering</h4>
                  <p class="meta">Deepgram · Hiring manager · 9 yrs at company</p>
                  <p class="meta" style="opacity:0.75;">linkedin.com/in/[redacted] · SF Bay · 850 conn.</p>
                </div>
                <span class="shot-m-verified">verified</span>
              </div>
              <div class="shot-m-tabs">
                <span class="active">LinkedIn message</span>
                <span>Email</span>
                <span>Mutual</span>
              </div>
              <div class="shot-m-draft">
                <p>Hi — I saw the Solutions Architect post and wanted to skip the resume pile.</p>
                <p>I shipped <span class="hl">3 production AI systems at Acme Corp</span> — a support bot (+18% deflection), a cart-recovery agent (14% revenue recovered), and an internal Q&amp;A search (-45% find-time).</p>
              </div>
              <div class="shot-m-actions">
                <span class="btn-send">Send via LinkedIn</span>
                <span class="btn-ghost">Edit draft</span>
              </div>
            </div>
          </div>
          <div class="shot shot-outreach">
            <div class="shot-chrome">
              <span class="d"></span><span class="d"></span><span class="d"></span>
              <span class="crumbs">outreach / deepgram / sr. sa</span>
            </div>
            <div class="outreach-body">
              <div class="head-row">
                <div class="avatar">VP</div>
                <div style="flex:1;">
                  <p class="hm-name">VP of Solutions Engineering <span class="verified">● verified</span></p>
                  <p class="hm-title">Deepgram · Hiring manager · 9 yrs at company</p>
                  <p class="hm-meta">linkedin.com/in/[redacted] · SF Bay Area · 850 conn.</p>
                </div>
              </div>
              <div class="channel-tabs">
                <span class="active">LinkedIn message</span>
                <span>Email</span>
                <span>Mutual</span>
              </div>
              <div class="draft">
                <p>Hi — I saw the Solutions Architect post and wanted to skip the resume pile.</p>
                <p>I shipped <span class="hl">3 production AI systems at Acme Corp</span> — a customer support bot (+18% deflection), a cart-recovery agent (14% revenue recovered), and an internal Q&A search (-45% find-time) — and ran the full SE cycle for 20+ enterprise partners.</p>
                <p>Would 15 minutes next week be worth it? I'd rather hear your take on the support/automation split than guess from the JD.</p>
              </div>
              <div class="actions">
                <span class="btn-send">Send via LinkedIn</span>
                <span class="btn-ghost">Edit draft</span>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- F3: Track -->
      <article class="feature reveal tier-high">
        <div class="feature-copy">
          <div class="feature-icon g3" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M8 7v7"/><path d="M12 7v4"/><path d="M16 7v9"/></svg></div>
          <h3>Score from <em>any job page</em>. Track everything.</h3>
          <p>Chrome extension scores roles on LinkedIn, Greenhouse, Lever, Indeed. Every score flows into the pipeline. Kanban tracker, follow-up alerts, rejection-pattern detection. <span class="accent">No spreadsheets.</span></p>
          <div class="tag-row">
            <span class="pill">Chrome extension</span>
            <span class="pill">Pipeline inbox</span>
            <span class="pill">Kanban tracker</span>
            <span class="pill">Follow-ups</span>
          </div>
        </div>
        <div class="feature-shot">
          <!-- Mobile-only pipeline card (mirrors desktop .shot-pipeline) -->
          <div class="shot-m shot-m-pipeline" aria-hidden="true">
            <div class="shot-chrome">
              <span class="d"></span><span class="d"></span><span class="d"></span>
              <span class="crumbs">workspace / offers / kanban</span>
            </div>
            <div class="shot-m-body">
              <div class="shot-m-funnel">
                <div class="shot-m-fstep"><span class="lbl"><span class="d" style="background:#7a5f1c;"></span>Applied</span><span class="v">18</span><span class="c">100%</span></div>
                <div class="shot-m-fstep"><span class="lbl"><span class="d" style="background:#2f6776;"></span>Responded</span><span class="v">7</span><span class="c">39%</span></div>
                <div class="shot-m-fstep"><span class="lbl"><span class="d" style="background:#5e3f8a;"></span>Interview</span><span class="v">4</span><span class="c">57%</span></div>
                <div class="shot-m-fstep"><span class="lbl"><span class="d" style="background:#3d5d3a;"></span>Offer</span><span class="v">1</span><span class="c">25%</span></div>
              </div>
              <div class="shot-m-pcards">
                <div class="shot-m-pcard">
                  <div class="co">Stripe</div>
                  <div class="sc">4.6</div>
                  <div class="ro">Staff Eng, Payments</div>
                  <div class="pmeta">$280K–$320K · Remote · Applied</div>
                </div>
                <div class="shot-m-pcard">
                  <div class="co">Anthropic</div>
                  <div class="sc">4.8</div>
                  <div class="ro">Forward Deploy</div>
                  <div class="pmeta">$200K–$300K · SF · Responded</div>
                </div>
                <div class="shot-m-pcard">
                  <div class="co">Pinterest</div>
                  <div class="sc">4.4</div>
                  <div class="ro">AI Sol. Engineer</div>
                  <div class="pmeta">Onsite Thu · Interview</div>
                </div>
                <div class="shot-m-pcard">
                  <div class="co">Rally</div>
                  <div class="sc">4.5</div>
                  <div class="ro">Customer Eng Lead</div>
                  <div class="pmeta">$240K–$280K · Hybrid · Offer</div>
                </div>
              </div>
            </div>
          </div>
          <div class="shot shot-pipeline">
            <div class="shot-chrome">
              <span class="d"></span><span class="d"></span><span class="d"></span>
              <span class="crumbs">workspace / offers / kanban</span>
            </div>
            <div style="padding: 18px 20px 20px;" class="pipeline-body">
              <div class="funnel">
                <div class="fstep">
                  <div class="l"><span class="d" style="background:#7a5f1c;"></span>Applied</div>
                  <div><span class="v">18</span><span class="c">100%</span></div>
                </div>
                <div class="fstep">
                  <div class="l"><span class="d" style="background:#2f6776;"></span>Responded</div>
                  <div><span class="v">7</span><span class="c">39%</span></div>
                </div>
                <div class="fstep">
                  <div class="l"><span class="d" style="background:#5e3f8a;"></span>Interview</div>
                  <div><span class="v">4</span><span class="c">57%</span></div>
                </div>
                <div class="fstep">
                  <div class="l"><span class="d" style="background:#3d5d3a;"></span>Offer</div>
                  <div><span class="v">1</span><span class="c">25%</span></div>
                </div>
              </div>
              <div class="board">
                <div>
                  <div class="col-h"><span class="d" style="background:#7a5f1c;"></span>Applied<span class="ct">18</span></div>
                  <div class="pcard">
                    <div class="top">
                      <div><div class="co">Stripe</div><div class="ro">Staff Eng, Payments</div></div>
                      <div class="sc h">4.6</div>
                    </div>
                    <div class="pmeta">$280K–$320K · Remote</div>
                  </div>
                  <div class="pcard">
                    <div class="top">
                      <div><div class="co">Linear</div><div class="ro">Senior Product Eng</div></div>
                      <div class="sc h">4.3</div>
                    </div>
                    <div class="pmeta">$220K–$260K · NYC</div>
                  </div>
                </div>
                <div>
                  <div class="col-h"><span class="d" style="background:#2f6776;"></span>Responded<span class="ct">7</span></div>
                  <div class="pcard">
                    <div class="top">
                      <div><div class="co">Deepgram</div><div class="ro">Sr. Sol. Architect</div></div>
                      <div class="sc h">4.4</div>
                    </div>
                    <div class="pmeta">$200K–$260K · Remote</div>
                  </div>
                  <div class="pcard">
                    <div class="top">
                      <div><div class="co">Anthropic</div><div class="ro">Forward Deploy</div></div>
                      <div class="sc h">4.8</div>
                    </div>
                    <div class="pmeta">$200K–$300K · SF</div>
                  </div>
                </div>
                <div>
                  <div class="col-h"><span class="d" style="background:#5e3f8a;"></span>Interview<span class="ct">4</span></div>
                  <div class="pcard">
                    <div class="top">
                      <div><div class="co">Pinterest</div><div class="ro">AI Sol. Engineer</div></div>
                      <div class="sc h">4.4</div>
                    </div>
                    <div class="pmeta">Onsite Thu</div>
                  </div>
                  <div class="pcard">
                    <div class="top">
                      <div><div class="co">Vercel</div><div class="ro">Sr. Platform Eng</div></div>
                      <div class="sc h">4.2</div>
                    </div>
                    <div class="pmeta">Phone screen Fri</div>
                  </div>
                </div>
                <div>
                  <div class="col-h"><span class="d" style="background:#3d5d3a;"></span>Offer<span class="ct">1</span></div>
                  <div class="pcard">
                    <div class="top">
                      <div><div class="co">Rally</div><div class="ro">Customer Eng Lead</div></div>
                      <div class="sc h">4.5</div>
                    </div>
                    <div class="pmeta">$240K–$280K · Hybrid</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- F4: Prep -->
      <article class="feature flip reveal tier-accent">
        <div class="feature-copy">
          <div class="feature-icon g4" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V7"/><path d="m16 12 2 2 4-4"/><path d="M22 6V4a1 1 0 0 0-1-1h-5a4 4 0 0 0-4 4 4 4 0 0 0-4-4H3a1 1 0 0 0-1 1v13a1 1 0 0 0 1 1h6a3 3 0 0 1 3 3 3 3 0 0 1 3-3h6a1 1 0 0 0 1-1v-1.3"/></svg></div>
          <h3>Walk in <em>ready</em>, not nervous</h3>
          <p>Custom cheat sheets for every interview round — technical, behavioral, hiring manager. Built against real projects, the company's interview loop, and a personal story bank. <span class="accent">The competitors don't go this deep.</span></p>
          <div class="tag-row">
            <span class="pill">Interview prep</span>
            <span class="pill">STAR stories</span>
            <span class="pill">Company research</span>
            <span class="pill">Rejection patterns</span>
          </div>
        </div>
        <div class="feature-shot">
          <!-- Mobile-only prep card (mirrors desktop .shot-prep) -->
          <div class="shot-m shot-m-prep" aria-hidden="true">
            <div class="shot-chrome">
              <span class="d"></span><span class="d"></span><span class="d"></span>
              <span class="crumbs">prep / pinterest / ai sol. engineer</span>
            </div>
            <div class="shot-m-body">
              <h4>Interview prep · Pinterest</h4>
              <p class="meta" style="margin-top: 4px;">AI Solutions Engineer · Onsite Thu May 8</p>
              <div class="shot-m-stats" style="grid-template-columns: repeat(4, 1fr);">
                <div class="shot-m-stat"><span class="v">4</span><span class="lbl">rounds</span></div>
                <div class="shot-m-stat"><span class="v">~21d</span><span class="lbl">end-to-end</span></div>
                <div class="shot-m-stat"><span class="v">~50%</span><span class="lbl">positive</span></div>
                <div class="shot-m-stat"><span class="v">3.1</span><span class="lbl">difficulty</span></div>
              </div>
              <div class="shot-m-rounds">
                <div class="shot-m-round">
                  <span class="tag">T</span>
                  <span class="label">Technical · Production AI design</span>
                  <span class="ct">3 stories</span>
                </div>
                <div class="shot-m-star">
                  <span class="shot-m-star-tag">STAR · PRODUCTION RAG</span>
                  <p><b>Customer support bot at Acme Corp</b> — Ingestion → vector store → LLM retrieval + rerank → FastAPI/Docker/AWS. <b>Result:</b> +18% deflection, −30% tickets in 60 days — internal AI template.</p>
                </div>
                <div class="shot-m-round">
                  <span class="tag">B</span>
                  <span class="label">Behavioral · Ambiguity + ownership</span>
                  <span class="ct">5 stories</span>
                </div>
                <div class="shot-m-round">
                  <span class="tag">H</span>
                  <span class="label">Hiring manager · AI Solutions lead</span>
                  <span class="ct">3 points</span>
                </div>
              </div>
            </div>
          </div>
          <div class="shot shot-prep">
            <div class="shot-chrome">
              <span class="d"></span><span class="d"></span><span class="d"></span>
              <span class="crumbs">prep / pinterest / ai sol. engineer</span>
            </div>
            <div style="padding: 22px 24px;" class="prep-body">
              <h4>Interview prep · Pinterest</h4>
              <div class="sub">AI SOLUTIONS ENGINEER · ONSITE THU MAY 8</div>

              <div class="prep-hero">
                <div class="ph-cell">
                  <div class="ph-v">4</div>
                  <div class="ph-l">rounds</div>
                </div>
                <div class="ph-cell">
                  <div class="ph-v">~21–28d</div>
                  <div class="ph-l">end-to-end</div>
                </div>
                <div class="ph-cell">
                  <div class="ph-v">~50%</div>
                  <div class="ph-l">positive (glassdoor)</div>
                </div>
                <div class="ph-cell">
                  <div class="ph-dots">
                    <span class="on"></span><span class="on"></span><span class="on"></span><span></span><span></span>
                  </div>
                  <div class="ph-l">difficulty (3.1/5)</div>
                </div>
              </div>

              <div class="accordion">
                <div class="acc-item open">
                  <div class="acc-head">
                    <div class="t"><span class="ico">T</span>Technical round · Production AI design</div>
                    <div class="ct">3 stories ↓</div>
                  </div>
                  <div class="acc-body">
                    <div class="star-card">
                      <div class="star-tag">STAR · production RAG</div>
                      <div class="ti">Customer support bot at Acme Corp</div>
                      <div class="bd"><b>Situation:</b> Customers bouncing on onboarding, support tickets flooding queue. <b>Action:</b> Ingestion → vector store → LLM retrieval + rerank → FastAPI/Docker/AWS, golden-set eval. <b>Result:</b> +18% deflection, -30% tickets in 60 days — became internal AI template.</div>
                    </div>
                    <div class="star-card">
                      <div class="star-tag">STAR · agentic recovery</div>
                      <div class="ti">Cart-recovery agent</div>
                      <div class="bd"><b>Result:</b> Recovered 14% of stalled carts, 2.5× industry-baseline response rate. Compliance handled end-to-end.</div>
                    </div>
                  </div>
                </div>
                <div class="acc-item">
                  <div class="acc-head">
                    <div class="t"><span class="ico">B</span>Behavioral · ambiguity + ownership</div>
                    <div class="ct">5 stories ↓</div>
                  </div>
                </div>
                <div class="acc-item">
                  <div class="acc-head">
                    <div class="t"><span class="ico">H</span>Hiring manager · AI Solutions lead</div>
                    <div class="ct">3 talking points ↓</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<!-- ============== SECTION 4A · COMPARISON ============== -->
<section class="compare" id="compare">
  <div class="compare-wrap">
    <div class="section-head reveal">
      <span class="eyebrow">How Sur9e compares</span>
      <h2>Others fix one piece.<br /><span class="accent">Sur9e</span> covers everything.</h2>
      <p>Most tools fix the resume or spam applications. <span class="accent">Sur9e</span> judges the job, finds the hiring manager, and preps for the interview.</p>
    </div>

    <div class="compare-table-wrap reveal">
      <table class="cmp">
        <colgroup>
