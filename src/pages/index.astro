---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Compare from '../components/Compare.astro';
---
<Base>
<a class="skip-link" href="#top">Skip to content</a>

<!-- ============== NAV (merged from v2) ============== -->
<Nav />


<main id="main">

<!-- ============== SECTION 1 · HERO ============== -->
<Hero />

<!-- ============== SECTION 2 · HOW IT WORKS ============== -->
<HowItWorks />


<!-- ============== SECTION 3 · FEATURES ============== -->
<Features />

<!-- ============== SECTION 4A · COMPARISON ============== -->
<Compare />

<!-- ============== SECTION 4B · VOC ============== -->
<section class="voc" id="backstory">
  <div class="section-head reveal">
    <span class="eyebrow" style="color:#ff7a44;">Backstory</span>
    <h2><span style="color: var(--tier-low)">250</span> applications is normal now.<br /><span style="color: var(--text-dark-muted)">The <span class="accent">stories</span> below say why.</span></h2>
    <p>The reviews below are real complaints pulled from <span class="accent">G2, Trustpilot, and Reddit</span> — about <em>other</em> job-search tools. Sur9e was built because of them, not in spite of them.</p>
  </div>

  <div class="review-grid">
    <div class="review pain reveal">
      <div class="q-mark">&ldquo;</div>
      <p>Applied to 100+ jobs using a Jobscan-optimized resume with high match rates. <em>Zero responses.</em></p>
      <div class="q-attr">
        <div class="q-avatar q-avatar-src"><img src="https://www.google.com/s2/favicons?domain=g2.com&sz=64" alt="G2" loading="lazy" width="32" height="32" /></div>
        <div class="q-info">
          <div class="q-role">Product Manager · 4 yrs exp</div>
          <div class="q-detail">G2 · 6 months in</div>
        </div>
      </div>
    </div>
    <div class="review pain reveal">
      <div class="q-mark">&ldquo;</div>
      <p>One screening call from <em>~700 auto-applications.</em> Three from 200 I sent manually.</p>
      <div class="q-attr">
        <div class="q-avatar q-avatar-src"><img src="https://www.google.com/s2/favicons?domain=trustpilot.com&sz=64" alt="Trustpilot" loading="lazy" width="32" height="32" /></div>
        <div class="q-info">
          <div class="q-role">Data Engineer · Senior</div>
          <div class="q-detail">Trustpilot · 3 months in</div>
        </div>
      </div>
    </div>
    <div class="review pain reveal">
      <div class="q-mark">&ldquo;</div>
      <p>It auto-applied me to 300 jobs. <em>Half were Senior Director roles. I'm a Junior.</em></p>
      <div class="q-attr">
        <div class="q-avatar q-avatar-src"><img src="https://www.google.com/s2/favicons?domain=trustpilot.com&sz=64" alt="Trustpilot" loading="lazy" width="32" height="32" /></div>
        <div class="q-info">
          <div class="q-role">Software Engineer · Jr</div>
          <div class="q-detail">Trustpilot · 5 weeks in</div>
        </div>
      </div>
    </div>
    <div class="review pain reveal">
      <div class="q-mark">&ldquo;</div>
      <p>Half my cover letters had <em>my last name misspelled</em> despite the right info on my profile.</p>
      <div class="q-attr">
        <div class="q-avatar q-avatar-src"><img src="https://www.google.com/s2/favicons?domain=trustpilot.com&sz=64" alt="Trustpilot" loading="lazy" width="32" height="32" /></div>
        <div class="q-info">
          <div class="q-role">UX Designer · 6 yrs exp</div>
          <div class="q-detail">Trustpilot · 2 months in</div>
        </div>
      </div>
    </div>
    <div class="review pain reveal">
      <div class="q-mark">&ldquo;</div>
      <p>They published my personal info publicly on their forum — <em>disguised as a support ticket.</em></p>
      <div class="q-attr">
        <div class="q-avatar q-avatar-src"><img src="https://www.google.com/s2/favicons?domain=trustpilot.com&sz=64" alt="Trustpilot" loading="lazy" width="32" height="32" /></div>
        <div class="q-info">
          <div class="q-role">Marketing · Mid</div>
          <div class="q-detail">Trustpilot · 1 month in</div>
        </div>
      </div>
    </div>
    <div class="review hope reveal">
      <div class="q-mark">&ldquo;</div>
      <p>Direct outreach to <em>20 hiring managers beats 100 cold applications.</em> The tools are optimizing the wrong thing.</p>
      <div class="q-attr">
        <div class="q-avatar q-avatar-src"><img src="https://www.google.com/s2/favicons?domain=reddit.com&sz=64" alt="Reddit" loading="lazy" width="32" height="32" /></div>
        <div class="q-info">
          <div class="q-role">Software Engineer · Sr</div>
          <div class="q-detail">r/cscareerquestions · hired</div>
        </div>
      </div>
    </div>
  </div>

  <div class="stat-row-intro reveal">And here's the data behind the noise</div>
  <div class="stat-row reveal">
    <div class="stat red">
      <div class="num">2%</div>
      <div class="lbl">Interview rate from auto-apply tools</div>
    </div>
    <div class="stat amb">
      <div class="num">53%</div>
      <div class="lbl">Of hiring managers reject obvious AI applications</div>
    </div>
    <div class="stat grn">
      <div class="num">70%</div>
      <div class="lbl">Of jobs filled through networking &amp; outreach</div>
    </div>
    <div class="stat acc">
      <div class="num">1</div>
      <div class="lbl">Tool that finds the HM and helps you connect</div>
    </div>
  </div>
</section>

<!-- ============== SECTION 4C · FAQ ============== -->
<section class="faq" id="faq">
  <div class="section-head reveal">
    <span class="eyebrow">FAQ · 5 questions</span>
    <h2>Common questions, answered.</h2>
    <p>The objections that come up most. If something is missing, <a class="faq-contact-link" href="mailto:hello@sur9e.com">contacting us</a> is the easiest way to ask.</p>
  </div>
  <div class="faq-list reveal">
    <details class="faq-item">
      <summary>Is this just another AI resume optimizer? <span class="chev" aria-hidden="true"></span></summary>
      <div class="faq-a">Resume optimizers run keyword matches on every posting and tell you what to bolt onto your CV. Sur9e leads with the job evaluation — does this role even deserve an application? For the ones that do, Sur9e will also tailor a CV for that specific posting, grounded in real experience and the role's actual signals. Score the job first, write to it second.</div>
    </details>
    <details class="faq-item">
      <summary>Does Sur9e auto-apply for me? <span class="chev" aria-hidden="true"></span></summary>
      <div class="faq-a">Never. By design. Auto-application has a 2% callback rate and 53% of hiring managers reject obviously-AI applications. The Sur9e bet is the opposite direction: fewer applications, better fit, warmer paths.</div>
    </details>
    <details class="faq-item">
      <summary>What data does Sur9e need? <span class="chev" aria-hidden="true"></span></summary>
      <div class="faq-a">A CV, a short profile — goals, salary floor, dealbreakers, projects worth surfacing. Roughly 10 minutes to set up. Everything stays in the account.</div>
    </details>
    <details class="faq-item">
      <summary>When does it launch? <span class="chev" aria-hidden="true"></span></summary>
      <div class="faq-a">Q4 2026. Joining the waitlist gets the email the day it ships.</div>
    </details>
    <details class="faq-item">
      <summary>Is it really free? <span class="chev" aria-hidden="true"></span></summary>
      <div class="faq-a">Yes, at launch. The free tier covers job evaluation. Paid tiers come later for power users — the free tier stays.</div>
    </details>
  </div>
</section>

<!-- ============== SECTION 5 · WAITLIST + FOOTER ============== -->
<section class="waitlist" id="waitlist">
  <div class="waitlist-inner reveal">
    <h2>Your job search deserves better tools.<br /><span class="waitlist-sub">Be first when Sur9e ships.</span></h2>
    <p>Evaluates jobs, finds the hiring manager, drafts the intro, preps the interview. Built from a real career profile, not a template.</p>
    <label for="waitlist-email" class="email-label">Your email</label>
    <form class="email-form" id="emailForm" novalidate>
      <input
        id="waitlist-email"
        type="email"
        name="email"
        placeholder="you@example.com…"
        required
        autocomplete="email"
        inputmode="email"
        enterkeyhint="send"
        spellcheck="false"
      />
      <button type="submit" data-label="Join the waitlist" data-busy="Joining…">Join the waitlist</button>
    </form>
    <p class="email-thanks" id="emailThanks" tabindex="-1" role="status" aria-live="polite">✓ You're on the list. We'll be in touch.</p>
    <ul class="waitlist-pills" aria-label="Promise">
      <li><span class="wp-check">✓</span> Free to start</li>
      <li><span class="wp-check">✓</span> Launching Q4 2026</li>
      <li><span class="wp-check">✓</span> No spam, ever</li>
    </ul>
  </div>
</section>

</main>

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-row">
      <div class="footer-brand">
        <img src="assets/sur9e-wordmark-white.svg" alt="Sur9e" width="120" height="26" translate="no" />
        <span class="pronunciation"><span translate="no">Sur9e</span> (rhymes with surge)</span>
        <span class="tag">Know which jobs are worth your time.</span>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        <a href="#how">How it works</a>
        <a href="#features">Features</a>
        <a href="#compare">Compare</a>
        <a href="#backstory">Backstory</a>
        <a href="#faq">FAQ</a>
        <a href="mailto:hello@sur9e.com">Contact</a>
      </nav>
    </div>
    <div class="footer-divider">
      <div class="footer-bottom">
        <span>© <span id="footer-year">2026</span> Sur9e. All rights reserved.</span>
        <div class="footer-bottom-links">
          <a href="mailto:hello@sur9e.com">hello@sur9e.com</a>
        </div>
      </div>
    </div>
  </div>
  <a href="#top" class="to-top" id="toTop" aria-label="Back to top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
  </a>
</footer>
</Base>
