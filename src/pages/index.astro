---
import Backstory from '../components/Backstory.astro';
import Closing from '../components/Closing.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Nav from '../components/Nav.astro';
import WhatItDoes from '../components/WhatItDoes.astro';
import Base from '../layouts/Base.astro';
---

<Base>
  <!-- Skip link now lives in Base.astro (targets #main below). -->
  <Nav />

  <main id="main">
    <!-- ============== SECTION 1 · HERO ============== -->
    <Hero />

    <!-- ============== SECTION 2 · HOW IT WORKS ============== -->
    <HowItWorks />

    <!-- ============== SECTION 3 · WHAT IT DOES ============== -->
    <WhatItDoes />

    <!-- ============== SECTION 4 · BACKSTORY (WHY WE BUILT IT) ============== -->
    <Backstory />

    <!-- ============== SECTION 5 · FAQ ============== -->
    <Faq />

    <!-- ============== SECTION 6 · CLOSING (GET STARTED) ============== -->
    <Closing />
  </main>

  <Footer />
</Base>
