<!-- ============== SECTION 1 · HERO ============== -->
<section class="hero" id="top">
  <div class="hero-cards" role="group" aria-label="Sample job evaluations — drag to bounce">
    <div class="float-card f1 score-low">
      <div class="fc-head"><div class="fc-mark"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M2.886 4.18A11.982 11.982 0 0 1 11.99 0C18.624 0 24 5.376 24 12.009c0 3.64-1.62 6.903-4.18 9.105L2.887 4.18ZM1.817 5.626l16.556 16.556c-.524.33-1.075.62-1.65.866L.951 7.277c.247-.575.537-1.126.866-1.65ZM.322 9.163l14.515 14.515c-.71.172-1.443.282-2.195.322L0 11.358a12 12 0 0 1 .322-2.195Zm-.17 4.862 9.823 9.824a12.02 12.02 0 0 1-9.824-9.824Z"/></svg></div><div><div class="fc-co">Linear</div><div class="fc-role">Mid · Generalist</div></div></div>
      <div class="fc-score"><div class="fc-num">1.4</div><div class="fc-denom">/ 5.0</div></div>
      <div class="fc-bar"><span class="on"></span><span></span><span></span><span></span><span></span></div>
      <div class="fc-tag">Pass · 4 dealbreakers</div>
    </div>
    <div class="float-card f2 score-mid">
      <div class="fc-head"><div class="fc-mark"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.459 4.208c.746.606 1.026.56 2.428.466l13.215-.793c.28 0 .047-.28-.046-.326L17.86 1.968c-.42-.326-.981-.7-2.055-.607L3.01 2.295c-.466.046-.56.28-.374.466zm.793 3.08v13.904c0 .747.373 1.027 1.214.98l14.523-.84c.841-.046.935-.56.935-1.167V6.354c0-.606-.233-.933-.748-.887l-15.177.887c-.56.047-.747.327-.747.933zm14.337.745c.093.42 0 .84-.42.888l-.7.14v10.264c-.608.327-1.168.514-1.635.514-.748 0-.935-.234-1.495-.933l-4.577-7.186v6.952L12.21 19s0 .84-1.168.84l-3.222.186c-.093-.186 0-.653.327-.746l.84-.233V9.854L7.822 9.76c-.094-.42.14-1.026.793-1.073l3.456-.233 4.764 7.279v-6.44l-1.215-.139c-.093-.514.28-.887.747-.933zM1.936 1.035l13.31-.98c1.634-.14 2.055-.047 3.082.7l4.249 2.986c.7.513.934.653.934 1.213v16.378c0 1.026-.373 1.634-1.68 1.726l-15.458.934c-.98.047-1.448-.093-1.962-.747l-3.129-4.06c-.56-.747-.793-1.306-.793-1.96V2.667c0-.839.374-1.54 1.447-1.632z"/></svg></div><div><div class="fc-co">Notion</div><div class="fc-role">Sr. Backend</div></div></div>
      <div class="fc-score"><div class="fc-num">3.1</div><div class="fc-denom">/ 5.0</div></div>
      <div class="fc-bar"><span class="on"></span><span class="on"></span><span class="on"></span><span></span><span></span></div>
      <div class="fc-tag">Maybe · comp gap</div>
    </div>
    <div class="float-card f3 score-high">
      <div class="fc-head"><div class="fc-mark"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.3041 3.541h-3.6718l6.696 16.918H24Zm-10.6082 0L0 20.459h3.7442l1.3693-3.5527h7.0052l1.3693 3.5528h3.7442L10.5363 3.5409Zm-.3712 10.2232 2.2914-5.9456 2.2914 5.9456Z"/></svg></div><div><div class="fc-co">Anthropic</div><div class="fc-role">Sr. Software Eng</div></div></div>
      <div class="fc-score"><div class="fc-num">4.2</div><div class="fc-denom">/ 5.0</div></div>
      <div class="fc-bar"><span class="on"></span><span class="on"></span><span class="on"></span><span class="on"></span><span></span></div>
      <div class="fc-tag">Apply · strong fit</div>
    </div>
    <div class="float-card f4 score-mid">
      <div class="fc-head"><div class="fc-mark"><svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 1.608 12 20.784H0Z"/></svg></div><div><div class="fc-co">Vercel</div><div class="fc-role">Staff · Platform</div></div></div>
      <div class="fc-score"><div class="fc-num">2.8</div><div class="fc-denom">/ 5.0</div></div>
      <div class="fc-bar"><span class="on"></span><span class="on"></span><span></span><span></span><span></span></div>
      <div class="fc-tag">Skip · culture flag</div>
    </div>
  </div>
  <div class="hero-inner">
    <div class="funnel-stats">
      <p class="fs-eyebrow">A typical year of applying</p>
      <div class="fs-row">
        <div class="fs-cell"><span class="fs-num s-low" data-target="250" data-speed="fast">0</span><span class="fs-lbl">applications</span></div>
        <div class="fs-cell"><span class="fs-num s-mid" data-target="12" data-speed="mid">0</span><span class="fs-lbl">callbacks</span></div>
        <div class="fs-cell"><span class="fs-num s-high" data-target="4" data-speed="slow">0</span><span class="fs-lbl">interviews</span></div>
      </div>
      <p class="fs-line">You already know this math is broken.</p>
    </div>
    <h1>Know which roles are worth your time <span class="hero-dash">—</span><br /><em>before you apply.</em></h1>
    <p class="hero-sub">Every role scored against your experience, goals, and dealbreakers — in 30 seconds.</p>
    <div class="cta-row">
      <a href="#waitlist" class="btn btn-primary">Join the waitlist</a>
      <a href="#how" class="btn btn-secondary">See how it works ↓</a>
    </div>
    <p class="hero-trust">Free to start · Launching Q4 2026 · No spam, ever.</p>
  </div>
</section>

<div class="hero-bridge" aria-hidden="true"></div>

<!-- ============== SECTION 2 · HOW IT WORKS ============== -->
<section class="section" id="how">
  <div class="section-head reveal">
    <span class="eyebrow">How it works</span>
    <h2>Three steps, <span class="accent">thirty seconds</span>.</h2>
    <p>From a URL to a decision — without applying first to find out.</p>
  </div>

  <div class="wrap">
    <div class="steps">
      <div class="step reveal tier-low" data-step="1">
        <span class="tier-band" aria-hidden="true"></span>
        <div class="step-num">Step 1</div>
        <h3>Drop a link</h3>
        <p>Paste a URL. Score from the page with the Chrome extension. Or let Sur9e surface best-fit roles from Greenhouse, Lever, and more.</p>
      </div>
      <div class="step reveal tier-mid" data-step="2">
        <span class="tier-band" aria-hidden="true"></span>
        <div class="step-num">Step 2</div>
        <h3>Read the score</h3>
        <p>30 seconds. Scored against the CV, comp targets, dealbreakers, and career goals. With reasoning, not just a number.</p>
      </div>
      <div class="step reveal tier-high" data-step="3">
        <span class="tier-band" aria-hidden="true"></span>
        <div class="step-num">Step 3</div>
        <h3>Pick or pass</h3>
        <p>Apply with confidence — or move on. The second-guessing stops.</p>
      </div>
    </div>

    <!-- Animated demo -->
    <div class="demo-frame reveal" id="demoFrame" role="region" aria-label="Animated demo of evaluating a job posting">
      <button type="button" class="demo-pause" id="demoPause" aria-pressed="false" aria-label="Pause demo animation">
        <svg class="pause-glyph" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
        <svg class="play-glyph" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7L8 5z"/></svg>
      </button>
      <!-- Browser chrome -->
      <div class="demo-chrome" aria-hidden="true">
        <span class="dot close" title="Close"></span>
        <span class="dot minimize" title="Minimize"></span>
        <span class="dot maximize" title="Expand"></span>
        <span class="url">app.sur9e.com/score</span>
        <span class="meta"><span class="meta-full">demo · live preview</span><span class="meta-short">demo</span></span>
      </div>

      <!-- Mobile-only animated demo — 3 phases on 8s loop, mirrors desktop -->
      <div class="demo-mobile" aria-hidden="true">
        <!-- Phase 1: Paste a job URL (mirrors desktop .phase-1) -->
        <div class="m-phase m-phase-1">
          <div class="m-label">Paste a job URL</div>
          <div class="m-input-wrap">
            <span class="m-url-text">
              <span class="m-placeholder">anthropic.com/jobs/4985877008</span>
              <span class="m-typed">anthropic.com/jobs/4985877008</span><span class="m-cursor"></span>
            </span>
            <span class="m-score-btn">Score →</span>
          </div>
          <span class="m-demo-cursor" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M5.5 3.21V20.79c0 .45.54.67.85.35l4.86-4.86a.5.5 0 0 1 .35-.15h6.87a.5.5 0 0 0 .35-.85L6.35 2.86a.5.5 0 0 0-.85.35Z" stroke="rgba(0,0,0,0.5)" stroke-width="1.2"/></svg>
            <span class="m-click-ring"></span>
          </span>
        </div>

        <!-- Phase 2: Loading modal (mirrors desktop .loader-card) -->
        <div class="m-phase m-phase-2">
          <div class="m-loader-card">
            <div class="m-loader-bar"><span class="m-loader-fill"></span></div>
            <div class="m-loader-head">
              <span class="m-loader-dot"></span>
              <span class="m-loader-title">Evaluating <span class="m-loader-target">— Anthropic · FDE, Applied AI</span></span>
              <span class="m-loader-sub">0:03</span>
            </div>
            <ul class="m-loader-phases">
              <li>Reading job description…</li>
              <li>Matching against your profile…</li>
              <li>Evaluating fit across 10 dimensions…</li>
              <li>Generating reasoning…</li>
            </ul>
          </div>
        </div>

        <!-- Phase 3: Report (mirrors desktop .phase-3 / .rpt-hero / .snapshot-merged) -->
        <div class="m-phase m-phase-3">
          <div class="m-rpt-eyebrow">
            <span class="m-rpt-pill">Evaluated</span>
            <span class="m-e-dot"></span>
            <span>Applied AI · Forward Deployed</span>
          </div>

          <div class="m-rpt-id-row">
            <div class="m-company-mark">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.3041 3.541h-3.6718l6.696 16.918H24Zm-10.6082 0L0 20.459h3.7442l1.3693-3.5527h7.0052l1.3693 3.5528h3.7442L10.5363 3.5409Zm-.3712 10.2232 2.2914-5.9456 2.2914 5.9456Z"/></svg>
            </div>
            <div style="min-width: 0; flex: 1;">
              <h3>Anthropic</h3>
              <p class="m-rpt-role">Forward Deployed Engineer, Applied AI</p>
            </div>
          </div>

          <div class="m-rpt-meta-strip">
            <span>Hybrid · 8 cities</span><span class="m-sep">·</span>
            <span>Mid-Senior</span><span class="m-sep">·</span>
            <span>$200K–$300K</span>
          </div>

          <div class="m-rpt-score-row">
            <div class="m-score-block">
              <div class="m-score-numeral">4.8<span class="m-denom">/5</span></div>
              <div class="m-score-bar">
                <span class="seg on"></span><span class="seg on"></span><span class="seg on"></span><span class="seg on"></span><span class="seg on"></span>
              </div>
            </div>
            <div class="m-score-tags">
              <span class="m-legit-pill">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z"/></svg>
                High confidence
              </span>
              <span class="m-archetype-tag">Scored by Evaluation AI</span>
            </div>
          </div>

          <div class="m-rpt-block-head">
            <h4 class="m-rpt-block-title">Snapshot</h4>
            <span class="m-rpt-block-meta">Decide in 30 seconds</span>
          </div>
          <p class="m-rpt-lede">3 production AI systems map dead-center to the FDE archetype. Comp is top-of-market. The MCP gap is closeable in a 2-day Claude API demo.</p>

          <div class="m-snapshot">
            <div class="m-matrix-label">Score breakdown</div>
            <div class="m-gap-card match">
              <div class="m-gap-sev-bar"></div>
              <div class="m-gap-body">
                <div class="m-gap-title">Strongest match</div>
                <div class="m-gap-mit"><strong>Production AI at scale</strong> — 3 shipped systems in fintech, full SE cycle, RAG template went internal-standard.</div>
              </div>
              <span class="m-sev low">match</span>
            </div>
            <div class="m-gap-card watch">
              <div class="m-gap-sev-bar"></div>
              <div class="m-gap-body">
                <div class="m-gap-title">Watch-out</div>
                <div class="m-gap-mit"><strong>MCP servers</strong> — JD lists explicitly. Closeable with a 2-day Claude API demo.</div>
              </div>
              <span class="m-sev high">watch</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Animated cursor — glides to Score button and clicks before Phase 2 begins -->
      <span class="demo-cursor" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M5.5 3.21V20.79c0 .45.54.67.85.35l4.86-4.86a.5.5 0 0 1 .35-.15h6.87a.5.5 0 0 0 .35-.85L6.35 2.86a.5.5 0 0 0-.85.35Z" stroke="rgba(0,0,0,0.5)" stroke-width="1.2"/></svg>
        <span class="click-ring"></span>
      </span>

      <!-- Phase 1: URL input -->
      <div class="phase phase-1">
        <div class="label">Paste a job URL</div>
        <div class="input-wrap">
          <span class="url-text">
            <span class="placeholder">https://job-boards.greenhouse.io/anthropic/jobs/4985877008</span>
