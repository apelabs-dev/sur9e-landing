---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Off the chart · Sur9e">
  <main class="nf" id="main">
    <canvas class="nf-stars" data-nf-stars aria-hidden="true"></canvas>
    <div class="nf-inner">
      <h1 class="nf-title">404 — Off the chart.</h1>
      <p class="nf-sub">Nothing here was worth applying to anyway.</p>
      <a class="nf-home" href="/">← Back to charted space</a>
    </div>
  </main>
</Base>

<script>
  // Self-contained starfield for the 404 (frozen under reduced motion — one
  // static frame, no RAF loop). No telemetry, no other behaviour.
  (function () {
    const canvas = document.querySelector('[data-nf-stars]');
    if (!(canvas instanceof HTMLCanvasElement) || !canvas.getContext) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    let field = [];
    let w = 0;
    let h = 0;

    const build = () => {
      const r = canvas.parentElement.getBoundingClientRect();
      w = r.width;
      h = r.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.floor((w * h) / 9000);
      field = Array.from({ length: n }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 1.1 + 0.3,
        o: Math.random(),
        sp: Math.random() * 0.014 + 0.003,
        d: Math.random() < 0.5 ? 1 : -1,
      }));
    };

    const paint = (twinkle) => {
      ctx.clearRect(0, 0, w, h);
      for (const s of field) {
        if (twinkle) {
          s.o += s.sp * s.d;
          if (s.o > 1) {
            s.o = 1;
            s.d = -1;
          }
          if (s.o < 0.15) {
            s.o = 0.15;
            s.d = 1;
          }
        }
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, 7);
        ctx.fillStyle = `rgba(244,244,245,${twinkle ? s.o : 0.55 * s.o + 0.18})`;
        ctx.fill();
      }
    };

    build();
    if (reduce) {
      paint(false);
    } else {
      const tick = () => {
        paint(true);
        requestAnimationFrame(tick);
      };
      tick();
    }

    let rt;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = setTimeout(() => {
        build();
        if (reduce) paint(false);
      }, 150);
    });
  })();
</script>

<style>
  .nf {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 64px 24px;
    background:
      radial-gradient(
        circle at 50% 30%,
        color-mix(in oklab, var(--beauty-ember), transparent 84%),
        transparent 460px
      ),
      linear-gradient(180deg, #080808, #12100e 55%, #1b1410);
    color: var(--text-dark);
  }
  .nf-stars {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .nf-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 560px;
  }
  .nf-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--text-dark-hi);
    margin: 0 0 14px;
  }
  .nf-sub {
    font-family: var(--font-display);
    font-size: clamp(15px, 2.4vw, 18px);
    color: var(--text-dark-muted);
    margin: 0 0 32px;
    text-wrap: balance;
  }
  .nf-home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border: 1px solid var(--border-dark-strong);
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-dark-2);
    transition:
      border-color var(--dur-quick),
      color var(--dur-quick),
      background var(--dur-quick);
  }
  .nf-home:hover {
    border-color: var(--accent-dark);
    color: #fff;
    background: rgba(255, 255, 255, 0.03);
  }
  .nf-home:focus-visible {
    outline: 2px solid var(--accent-dark);
    outline-offset: 3px;
  }
</style>
