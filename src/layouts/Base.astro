---
const defaultTitle = 'Sur9e — open-source, self-hosted AI job search toolkit';
const { title = defaultTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#0a0a0b"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="theme-color" content="#faf9f6" />
    <title translate="no">{title}</title>
    <meta
      name="description"
      content="Free, self-hosted AI job-hunt toolkit that runs inside your coding agent. Screens roles cheap, evaluates deep, tailors CVs, and never auto-submits."
    />
    <meta
      property="og:title"
      content="Sur9e — open-source, self-hosted AI job search toolkit"
    />
    <meta
      property="og:description"
      content="Free, self-hosted AI job-hunt toolkit that runs inside your coding agent. Screens roles cheap, evaluates deep, tailors CVs, and never auto-submits."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sur9e.com/" />
    <meta
      property="og:image"
      content="https://sur9e.com/assets/icon-logo.svg"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Sur9e — open-source, self-hosted AI job search toolkit"
    />
    <meta
      name="twitter:description"
      content="Free, self-hosted AI job-hunt toolkit that runs inside your coding agent. Screens roles cheap, evaluates deep, tailors CVs, and never auto-submits."
    />
    <meta
      name="twitter:image"
      content="https://sur9e.com/assets/icon-logo.svg"
    />
    <link rel="canonical" href="https://sur9e.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Sur9e',
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web',
        description:
          'AI-powered job evaluation. Score any role against your CV in 30 seconds.',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      })}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script>
      import { initRevealOnScroll } from '../scripts/reveal-on-scroll.js';
      initRevealOnScroll();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';
</style>
