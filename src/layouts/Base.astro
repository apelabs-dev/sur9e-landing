---
const defaultTitle = 'sur9e — open-source, self-hosted AI job search toolkit';
const defaultDescription =
  'Free, self-hosted AI job-hunt toolkit that runs inside your coding agent. Screens roles cheap, evaluates deep, tailors CVs, and never auto-submits.';
const {
  title = defaultTitle,
  description = defaultDescription,
  canonical = new URL(Astro.url.pathname, 'https://sur9e.com').href,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#0a0a0b"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="theme-color" content="#faf9f6" />
    <!-- Preload the above-the-fold display weights (hero H1 = Semibold, funnel
         numerals = Bold) so they paint in General Sans on first render. Without
         this, font-display:swap re-lays-out the hero when the font arrives,
         shifting the centered .hero-aura → Cumulative Layout Shift. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/general-sans/GeneralSans-Semibold.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/general-sans/GeneralSans-Bold.woff2"
      crossorigin
    />
    <title translate="no">{title}</title>
    <!-- Above-the-fold visual (How it works) is eager-loaded; preload it so the
         browser starts the request during head parsing instead of at body parse. -->
    <link
      rel="preload"
      as="image"
      href="/assets/download-box-icon-ai-sparkle-transparent.webp"
      fetchpriority="high"
    />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://sur9e.com/og-v4.png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://sur9e.com/og-v4.png" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Body face is self-hosted (variable Inter, latin subset) so the critical
         path has no cross-origin stylesheet and no third-party font request. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter/inter-var.woff2"
      crossorigin
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'sur9e',
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'macOS, Linux, Windows',
        description:
          'Open-source, self-hosted AI job-hunt toolkit that runs inside your AI coding agent. Screens roles cheap, evaluates deep, and never auto-submits.',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      })}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script>
      import { initRevealOnScroll } from '../scripts/reveal-on-scroll.js';
      initRevealOnScroll();

      // The ONLY thing this site ever logs — no analytics, telemetry, or
      // tracking scripts ship anywhere on the page.
      console.log(
        '%cNo telemetry. This line is the only thing we will ever log.',
        'color:#ff6a2a;font:600 12px ui-monospace,monospace;',
      );
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/fonts.css';
  @import '../styles/tokens.css';
</style>
