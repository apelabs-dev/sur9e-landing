---
// SECTION 03 · "What it does" — a DARK celestial map of the product journey.
// A recolored twinkling starfield (vanilla canvas, see scripts/what-it-does.js)
// sits behind a vertical Scout→Judge→Apply→Win constellation. As the section
// scrolls, the route fills solid stage-by-stage and each stage's illustrated
// "paper" card reveals; hover / focus / tap a star to reveal it on demand.
// Dimmer platform-trait stars carry text tooltips. Copy is canonical here.

// Journey stages (badge · headline · detail) — copy-FINAL §3, verbatim.
const stages = [
  {
    n: 1,
    side: 'tl',
    x: '38%',
    y: '8.65%',
    key: 'Scout',
    title: 'Fresh roles land on your desk.',
    detail:
      'Scheduled scans pull new listings from 8 ATS boards and public LinkedIn. On your machine, zero AI tokens.',
    img: '/assets/discovery-radar-transparent.png',
  },
  {
    n: 2,
    side: 'tr',
    x: '62%',
    y: '28.85%',
    key: 'Judge',
    title: 'Measured against your real profile, not keywords.',
    detail:
      'A cheap screen kills bad fits first. Survivors get the deep, scored evaluation, ranked against your real experience.',
    img: '/assets/score-evaluate-gauge-transparent.png',
  },
  {
    n: 3,
    side: 'tl',
    x: '40%',
    y: '50%',
    key: 'Apply',
    title: 'Every shot tailored. Never auto-sent.',
    detail:
      'Tailors your CV, drafts the cover letter, fills the form in your own browser. Then it stops. You hit Submit.',
    img: '/assets/tailored-submit-transparent.png',
  },
  {
    n: 4,
    side: 'tr',
    x: '62%',
    y: '69.23%',
    key: 'Win',
    title: 'The part most people skip.',
    detail:
      'Outreach drafts, interview prep, follow-ups, negotiation briefs. Rejections are analyzed for patterns, not deleted in shame.',
    img: '/assets/payoff-trophy-transparent.png',
  },
];

// Platform-trait stars (off the route, scattered in the margins) — §3 verbatim.
const traits = [
  {
    x: '9%',
    y: '16%',
    side: 'l',
    label: 'web UI',
    tip: 'A local web UI on the same files: pipeline, reports, spend, at localhost:3000.',
  },
  {
    x: '91%',
    y: '12%',
    side: 'r',
    label: '3 CLIs',
    tip: 'Runs in Claude Code, Codex, or OpenCode. Your subscription, your choice.',
  },
  {
    x: '8%',
    y: '62%',
    side: 'l',
    label: 'self-hosted',
    tip: 'Self-hosted, MIT. Your data never leaves your machine.',
  },
  {
    x: '92%',
    y: '72%',
    side: 'r',
    label: 'live cost',
    tip: 'Tracks what every mode costs you, per provider and model.',
  },
  {
    x: '90%',
    y: '44%',
    side: 'r',
    label: 'any device',
    tip: 'Pair it with Tailscale and the whole hunt runs from your phone or tablet, on your own private network.',
  },
];
---

<section
  class="celestial"
  id="what-it-does"
  data-celestial
  aria-labelledby="wid-heading"
>
  <canvas class="cmap-stars" data-starfield aria-hidden="true"></canvas>
  <div class="cmap-grid" aria-hidden="true"></div>

  {
    /* ① atmosphere — nebula glow along the route, faint background
      constellations, and the occasional shooting star */
  }
  <div class="cmap-atmos" aria-hidden="true">
    <span class="cmap-neb cmap-neb--1"></span>
    <span class="cmap-neb cmap-neb--2"></span>
    <span class="cmap-neb cmap-neb--3"></span>
    {
      /* subtle, semi-transparent real asterisms (white glowing stars + thin
        faint lines) drifting in the margins — Big Dipper, Cassiopeia, a Y */
    }
    <div class="cmap-const cmap-const--a">
      <svg viewBox="0 0 120 56" fill="none">
        <path d="M8,18 L8,40 L38,46 L34,22 Z M34,22 L60,20 L84,15 L108,7"
        ></path>
        <circle cx="8" cy="18" r="1.5" class="s-bright"></circle>
        <circle cx="8" cy="40" r="1.1" class="s-mid"></circle>
        <circle cx="38" cy="46" r="1.1" class="s-mid"></circle>
        <circle cx="34" cy="22" r="0.8" class="s-dim"></circle>
        <circle cx="60" cy="20" r="1.1" class="s-mid"></circle>
        <circle cx="84" cy="15" r="1.5" class="s-bright"></circle>
        <circle cx="108" cy="7" r="1" class="s-mid"></circle>
        <circle cx="52" cy="38" r="0.5" class="s-faint"></circle>
        <circle cx="96" cy="30" r="0.5" class="s-faint"></circle>
        <circle cx="22" cy="10" r="0.5" class="s-faint"></circle>
      </svg>
    </div>
    <div class="cmap-const cmap-const--b">
      <svg viewBox="0 0 100 56" fill="none">
        <path d="M6,20 L26,40 L46,18 L66,42 L86,16"></path>
        <circle cx="6" cy="20" r="1.2" class="s-mid"></circle>
        <circle cx="26" cy="40" r="0.9" class="s-dim"></circle>
        <circle cx="46" cy="18" r="1.5" class="s-bright"></circle>
        <circle cx="66" cy="42" r="0.9" class="s-dim"></circle>
        <circle cx="86" cy="16" r="1.2" class="s-mid"></circle>
        <circle cx="58" cy="30" r="0.5" class="s-faint"></circle>
        <circle cx="16" cy="48" r="0.5" class="s-faint"></circle>
      </svg>
    </div>
    <div class="cmap-const cmap-const--c">
      <svg viewBox="0 0 84 84" fill="none">
        <path d="M12,18 L42,42 L18,72 M42,42 L70,30 L62,8 M70,30 L80,54"></path>
        <circle cx="42" cy="42" r="1.5" class="s-bright"></circle>
        <circle cx="12" cy="18" r="1.1" class="s-mid"></circle>
        <circle cx="18" cy="72" r="1.1" class="s-mid"></circle>
        <circle cx="70" cy="30" r="1.2" class="s-mid"></circle>
        <circle cx="62" cy="8" r="0.8" class="s-dim"></circle>
        <circle cx="80" cy="54" r="0.9" class="s-dim"></circle>
        <circle cx="30" cy="60" r="0.5" class="s-faint"></circle>
        <circle cx="56" cy="50" r="0.5" class="s-faint"></circle>
      </svg>
    </div>
    <span class="cmap-shoot cmap-shoot--1"></span>
    <span class="cmap-shoot cmap-shoot--2"></span>
  </div>
  <div class="cmap-vignette" aria-hidden="true"></div>

  <span class="cmap-tick cmap-tick--tl" aria-hidden="true">04ʰ 12ᵐ</span>
  <span class="cmap-tick cmap-tick--tr" aria-hidden="true">+19° 41′</span>
  <span class="cmap-tick cmap-tick--bl" aria-hidden="true">−06° 23′</span>
  <span class="cmap-tick cmap-tick--br" aria-hidden="true">21ʰ 48ᵐ</span>

  <div class="section-head cmap-head reveal">
    <span class="eyebrow">What it does</span>
    <h2 id="wid-heading">From first listing to signed offer.</h2>
    <p>Every stage of the hunt is covered, not just the application.</p>
  </div>

  <div class="cmap" data-map>
    {/* ④ chart framing — corner brackets + legend + compass + stage readout */}
    <div class="cmap-frame" aria-hidden="true">
      <span class="cmap-corner tl"></span>
      <span class="cmap-corner tr"></span>
      <span class="cmap-corner bl"></span>
      <span class="cmap-corner br"></span>
    </div>
    <div class="cmap-legend" aria-hidden="true">
      <span><i class="lg lg-j">✦</i> journey</span>
      <span><i class="lg lg-c">✧</i> capability</span>
    </div>
    <div class="cmap-progress" data-progress aria-hidden="true">
      stage <b>01</b> / 04
    </div>
    <div class="cmap-compass" aria-hidden="true">
      <span class="cmap-compass-n">N</span>
    </div>

    {
      /* ② living route — faint baseline, a path that draws to the comet, and
        the comet itself (positioned along the path in JS by scroll progress) */
    }
    <svg
      class="cmap-route"
      viewBox="0 0 600 1040"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        class="cmap-route-bg"
        d="M228,90 L372,300 L240,520 L372,720 L300,1000"></path>
      <path
        class="cmap-route-solid"
        data-route
        d="M228,90 L372,300 L240,520 L372,720 L300,1000"></path>
      <g class="cmap-comet" data-comet>
        <circle class="cmap-comet-glow" r="7"></circle>
        <circle class="cmap-comet-core" r="2.6"></circle>
      </g>
    </svg>

    {
      traits.map((t) => (
        <div
          class={`pstar pos-${t.side}`}
          data-pstar
          style={`--x:${t.x};--y:${t.y}`}
        >
          <button
            class="pstar-hit"
            type="button"
            aria-label={`${t.label}: ${t.tip}`}
          >
            <span class="pstar-glyph" aria-hidden="true">
              ✧
            </span>
            <span class="pstar-lab">{t.label}</span>
          </button>
          <span class="pstar-tip" role="tooltip">
            {t.tip}
          </span>
        </div>
      ))
    }

    {
      stages.map((s) => (
        <div
          class={`cstar ${s.side}`}
          data-star
          data-i={s.n}
          style={`--x:${s.x};--y:${s.y}`}
        >
          <button
            class="cstar-hit"
            type="button"
            aria-expanded="false"
            aria-label={`Stage ${s.n}: ${s.key} — ${s.title}`}
          >
            <span class="cstar-dot">
              <span class="cstar-ring" aria-hidden="true" />
            </span>
            <span class="cstar-lab">{s.key.toUpperCase()}</span>
          </button>
          <div class="cstar-card">
            <div class="cstar-art">
              <img src={s.img} alt="" loading="lazy" width="114" height="114" />
            </div>
            <div class="cstar-body">
              <span class="cstar-badge">{s.key}</span>
              <h3 class="cstar-th">{s.title}</h3>
              <p class="cstar-td">{s.detail}</p>
            </div>
          </div>
        </div>
      ))
    }

    {/* journey's-end destination node — the route lands on the Install CTA */}
    <div class="cmap-dest" style="--x:50%;--y:96.15%">
      <span class="cmap-dest-halo" aria-hidden="true"></span>
      <a class="btn btn-primary cmap-install" href="#install">Embark</a>
    </div>
  </div>
</section>

<script>
  import { initWhatItDoes } from '../scripts/what-it-does.js';
  initWhatItDoes();
</script>

<style>
  /* ── Section shell — its own dark beat: recolored gradient + glows ── */
  .celestial {
    position: relative;
    overflow: hidden;
    padding: 96px 24px 104px;
    isolation: isolate;
    background:
      radial-gradient(
        circle at 50% 13%,
        color-mix(in oklab, var(--beauty-ember), transparent 84%),
        transparent 420px
      ),
      radial-gradient(
        circle at 86% 72%,
        color-mix(in oklab, var(--beauty-olive), transparent 91%),
        transparent 280px
      ),
      linear-gradient(180deg, #080808, #12100e 55%, #1b1410);
  }

  .cmap-stars {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* faint cartographic grid, radial-masked so it fades at the edges */
  .cmap-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.026) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px);
    background-size: 34px 34px;
    -webkit-mask-image: radial-gradient(
      circle at 50% 40%,
      #000 0 60%,
      transparent 92%
    );
    mask-image: radial-gradient(circle at 50% 40%, #000 0 60%, transparent 92%);
  }

  /* ── ① Atmosphere — nebula glow, background constellations, shooting stars ── */
  .cmap-atmos {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  /* soft nebula blobs sitting along the zig-zag so the route glows */
  .cmap-neb {
    position: absolute;
    border-radius: 50%;
    filter: blur(46px);
    opacity: 0.55;
  }
  .cmap-neb--1 {
    top: 18%;
    left: 30%;
    width: 360px;
    height: 360px;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--beauty-ember), transparent 80%),
      transparent 70%
    );
  }
  .cmap-neb--2 {
    top: 52%;
    left: 56%;
    width: 320px;
    height: 320px;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--beauty-olive), transparent 84%),
      transparent 70%
    );
  }
  .cmap-neb--3 {
    top: 80%;
    left: 42%;
    width: 300px;
    height: 300px;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--beauty-ember), transparent 85%),
      transparent 70%
    );
  }
  /* subtle, semi-transparent real asterisms — white glowing stars joined by
     thin faint lines, drifting in the margins behind the journey */
  .cmap-const {
    position: absolute;
    z-index: 0;
    opacity: 0.4;
  }
  .cmap-const svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .cmap-const path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 0.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* crisp pinpoint stars: shrink each circle about its own centre, brighter */
  .cmap-const circle {
    fill: #fff;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.55);
    filter: drop-shadow(0 0 1.2px rgba(255, 255, 255, 0.9));
  }
  .cmap-const .s-bright {
    opacity: 0.85;
  }
  .cmap-const .s-mid {
    opacity: 0.6;
  }
  .cmap-const .s-dim {
    opacity: 0.45;
  }
  .cmap-const .s-faint {
    opacity: 0.28;
    filter: none;
  }
  /* placements in the empty margins (clear of the route + cards) */
  .cmap-const--a {
    top: 5%;
    left: 1%;
    width: 19%;
  }
  .cmap-const--b {
    top: 38%;
    right: 1%;
    width: 15%;
  }
  .cmap-const--c {
    bottom: 6%;
    left: 4%;
    width: 18%;
  }
  /* occasional shooting star streaking across the field */
  .cmap-shoot {
    position: absolute;
    width: 120px;
    height: 1.5px;
    background: linear-gradient(90deg, transparent, var(--beauty-ember-2));
    border-radius: 2px;
    opacity: 0;
    transform: rotate(18deg);
  }
  .cmap-shoot--1 {
    top: 22%;
    left: -10%;
    animation: cmapShoot 11s var(--ease-calm) infinite;
    animation-delay: 2.5s;
  }
  .cmap-shoot--2 {
    top: 64%;
    left: -10%;
    transform: rotate(-12deg);
    animation: cmapShoot 14s var(--ease-calm) infinite;
    animation-delay: 8s;
  }
  @keyframes cmapShoot {
    0% {
      opacity: 0;
      transform: translate(0, 0) rotate(18deg);
    }
    2% {
      opacity: 0.9;
    }
    9% {
      opacity: 0;
      transform: translate(70vw, 22vh) rotate(18deg);
    }
    100% {
      opacity: 0;
      transform: translate(70vw, 22vh) rotate(18deg);
    }
  }
  /* vignette darkens the edges so the chart reads as framed */
  .cmap-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 78% 64% at 50% 46%,
      transparent 60%,
      rgba(0, 0, 0, 0.55) 100%
    );
  }

  /* mono coordinate ticks in the corners */
  .cmap-tick {
    position: absolute;
    z-index: 2;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 9px;
    letter-spacing: 0.14em;
    color: var(--text-dark-dim);
  }
  .cmap-tick--tl {
    top: 14px;
    left: 16px;
  }
  .cmap-tick--tr {
    top: 14px;
    right: 16px;
  }
  .cmap-tick--bl {
    bottom: 14px;
    left: 16px;
  }
  .cmap-tick--br {
    bottom: 14px;
    right: 16px;
  }

  /* ── Heading — reuse global .section-head, recolor for the dark beat ── */
  .cmap-head {
    position: relative;
    z-index: 2;
    max-width: 760px;
    margin: 0 auto 8px;
  }
  .cmap-head .eyebrow {
    color: var(--beauty-ember);
  }
  .celestial .cmap-head h2 {
    color: var(--text-dark-hi);
  }
  .cmap-head p {
    color: var(--text-dark-muted);
  }

  /* ── Map canvas: the constellation lives here ── */
  .cmap {
    position: relative;
    z-index: 2;
    /* fill a generous share of the viewport on desktop so the constellation
       reads as a map, not a thumbnail; scales further at ≥1440 */
    width: min(960px, 82vw);
    height: 980px;
    /* top clearance so stage-1's (upward) card never collides with the
       heading; the first journey star sits ~10% into the map */
    margin: 80px auto 0;
  }

  /* ── ④ Chart framing: corner brackets, legend, compass, stage readout ── */
  .cmap-frame {
    position: absolute;
    inset: -10px -6px;
    z-index: 1;
    pointer-events: none;
  }
  .cmap-corner {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 0 solid color-mix(in oklab, var(--accent-dark), transparent 55%);
  }
  .cmap-corner.tl {
    top: 0;
    left: 0;
    border-top-width: 1.5px;
    border-left-width: 1.5px;
  }
  .cmap-corner.tr {
    top: 0;
    right: 0;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
  }
  .cmap-corner.bl {
    bottom: 0;
    left: 0;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
  }
  .cmap-corner.br {
    bottom: 0;
    right: 0;
    border-bottom-width: 1.5px;
    border-right-width: 1.5px;
  }
  .cmap-legend {
    position: absolute;
    left: 4px;
    bottom: 6px;
    z-index: 5;
    display: grid;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    color: var(--text-dark-muted);
  }
  .cmap-legend .lg {
    font-style: normal;
    margin-right: 4px;
  }
  .cmap-legend .lg-j {
    color: var(--accent-dark);
  }
  .cmap-legend .lg-c {
    color: var(--beauty-olive);
  }
  .cmap-progress {
    position: absolute;
    left: 4px;
    top: 4px;
    z-index: 5;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dark-muted);
  }
  .cmap-progress b {
    color: var(--beauty-ember-2);
    font-weight: 600;
  }
  .cmap-compass {
    position: absolute;
    right: 6px;
    top: 2px;
    z-index: 5;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
  }
  .cmap-compass::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--accent-dark), transparent 70%);
  }
  .cmap-compass::after {
    content: '';
    position: absolute;
    top: -3px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 6px solid var(--accent-dark);
  }
  .cmap-compass-n {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 9px;
    color: var(--text-dark-2);
  }

  /* route — faint dashed baseline + a solid path that DRAWS to the comet */
  .cmap-route {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .cmap-route-bg {
    fill: none;
    stroke: color-mix(in oklab, var(--beauty-ember), transparent 84%);
    stroke-width: 1.4;
    stroke-dasharray: 3 6;
  }
  .cmap-route-solid {
    fill: none;
    stroke: var(--beauty-ember);
    stroke-width: 1.7;
    /* dash array/offset are set in JS to draw the path up to scroll progress */
    filter: drop-shadow(
      0 0 5px color-mix(in oklab, var(--beauty-ember), transparent 35%)
    );
  }
  /* the comet that travels the route (JS positions the <g> along the path) */
  .cmap-comet {
    opacity: 0;
    transition: opacity 0.3s var(--ease-calm);
  }
  .cmap-comet.on {
    opacity: 1;
  }
  .cmap-comet-glow {
    fill: var(--beauty-ember-2);
    opacity: 0.5;
    filter: blur(2px);
  }
  .cmap-comet-core {
    fill: #fff6ee;
    filter: drop-shadow(
      0 0 6px color-mix(in oklab, var(--beauty-ember-2), transparent 10%)
    );
  }

  /* ── Journey star ── */
  .cstar {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    width: 120px;
    z-index: 3;
  }
  .cstar.is-shown {
    z-index: 8;
  }

  .cstar-hit {
    appearance: none;
    background: none;
    border: 0;
    padding: 4px;
    margin: 0;
    width: 100%;
    cursor: pointer;
    display: block;
    text-align: center;
    font-family: inherit;
    color: inherit;
  }
  .cstar-dot {
    position: relative;
    display: block;
    width: 18px;
    height: 18px;
    margin: 0 auto;
  }
  .cstar-dot::before {
    content: '\2726';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--accent-dark);
    font-size: 24px;
    text-shadow: 0 0 8px
      color-mix(in oklab, var(--beauty-ember), transparent 50%);
    transition:
      transform 0.2s var(--ease-soft),
      color 0.2s,
      text-shadow 0.2s;
  }
  .cstar-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 18px;
