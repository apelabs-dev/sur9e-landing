/* =====================================================================
   Section 4A: Comparison table — vanilla hi-fi (rewritten)
===================================================================== */
.compare {
  padding: 120px 24px 100px;
  background:
    radial-gradient(circle at 8% 10%, rgba(255, 90, 31, 0.08), transparent 18rem),
    radial-gradient(circle at 90% 24%, rgba(153, 184, 132, 0.12), transparent 20rem),
    var(--bg);
  position: relative;
  overflow: hidden;
}
.compare::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image: linear-gradient(to right, rgba(31, 29, 26, 0.045) 1px, transparent 1px);
  background-size: 64px 100%;
  background-position: 24px 0;
  opacity: 1;
  z-index: 0;
}
.compare-wrap { max-width: 1120px; margin: 0 auto; position: relative; z-index: 1; }
.compare-wrap p .accent { color: var(--accent); font-weight: 500; }
.compare-table-wrap { margin-top: 24px; overflow-x: auto; }
.cmp {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--text-2);
  background: var(--bg-paper);
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 1px 0 rgba(255,255,255,0.5) inset, 0 30px 70px -36px rgba(31,29,26,0.2);
}
.cmp-c-feat { width: 28%; }
.cmp-c-other { width: 16%; }
.cmp-c-sur9e { width: 24%; }
.cmp thead th {
  text-align: center;
  vertical-align: top;
  padding: 28px 18px 24px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  font-weight: 500;
}
.cmp thead th:first-child { background: transparent; border-bottom-color: transparent; }
.cmp .cmp-h-capability {
  text-align: left;
  font-family: var(--font-mono);
  font-size: 11.5px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-3);
  padding-left: 18px;
}
.cmp .cmp-h-capability .cmp-arrow { color: var(--text-muted); margin-left: 4px; }
.cmp thead th .cmp-h-cat {
  display: block;
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.012em;
  line-height: 1.15;
  min-height: 1.15em;
}
.cmp thead th .cmp-h-ex {
  display: block;
  font-family: var(--font-mono);
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  margin-top: 8px;
  min-height: 2.4em;
  line-height: 1.2;
}
.cmp thead .cmp-h-sur9e {
  background: linear-gradient(180deg, #fff0e4, #fdd9c0);
  border-bottom: 2px solid var(--accent);
  border-top: 3px solid var(--accent);
  position: relative;
}
.cmp thead .cmp-h-sur9e::after {
  content: "";
  position: absolute;
  inset: 0 0 -8px 0;
  box-shadow: 0 18px 36px -12px rgba(255,90,31,0.32);
  pointer-events: none;
  z-index: -1;
}
.cmp thead .cmp-h-sur9e .cmp-h-cat { color: var(--accent); font-size: 18px; }
.cmp thead .cmp-h-sur9e .cmp-h-ex { color: var(--accent-text); }

.cmp tbody td {
  padding: 18px 20px;
  border-bottom: 1px solid var(--border);
  vertical-align: middle;
  color: var(--text-2);
  text-align: center;
}
.cmp tbody td.cmp-feat { text-align: left; }
.cmp tbody td.cmp-yes { text-align: left; }
.cmp tbody tr:last-child td { border-bottom: none; }
/* Zebra striping — subtle, helps row scanning without competing with hover */
.cmp tbody tr:nth-child(even) td:not(.cmp-yes) { background: rgba(31, 29, 26, 0.018); }
.cmp tbody tr:hover td { background: rgba(255,90,31,0.035); }
.cmp tbody tr:hover td.cmp-yes { background: rgba(255,90,31,0.09); }
.cmp .cmp-feat {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.005em;
}

/* Unified cell language: — red (no) / ◐ amber (partial) / ✓ green (yes) */
.cmp .cmp-cell {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 13px;
  line-height: 1.3;
  font-style: normal;
}
.cmp .cmp-cell .cmp-mark {
  display: inline-grid; place-items: center;
  width: 20px; height: 20px;
  border-radius: 50%;
  flex-shrink: 0;
  font-size: 12px;
  font-weight: 600;
}
.cmp .cmp-cell .cmp-mark svg { width: 13px; height: 13px; display: block; }
.cmp .cmp-cell.no .cmp-mark svg { width: 15px; height: 15px; }
.cmp .cmp-cell.partial .cmp-mark svg { width: 14px; height: 14px; }
.cmp .cmp-cell.win .cmp-mark svg { width: 13px; height: 13px; stroke-width: 2.6; }
.cmp .cmp-cell.no      { color: var(--text-3); }
.cmp .cmp-cell.partial { color: var(--text-2); }
.cmp .cmp-cell.yes     { color: var(--text); }
/* "No" = bare em dash, no circle — communicates "absent" rather than "rejected" */
.cmp .cmp-cell.no      .cmp-mark { background: transparent; width: auto; height: auto; color: var(--text-muted); font-size: 16px; font-weight: 400; opacity: 0.45; }
/* "Partial" = half-filled glyph inside a tinted amber circle */
.cmp .cmp-cell.partial .cmp-mark { background: color-mix(in srgb, var(--tier-mid)  22%, transparent); color: color-mix(in srgb, var(--tier-mid)  70%, var(--text)); font-size: 13px; }
.cmp .cmp-cell.yes     .cmp-mark { background: color-mix(in srgb, var(--tier-high) 26%, transparent); color: color-mix(in srgb, var(--tier-high) 55%, var(--text)); }

.cmp tbody .cmp-yes {
  background: linear-gradient(180deg, rgba(255,90,31,0.05), rgba(255,90,31,0.07));
  color: var(--text);
  font-weight: 500;
  border-left: 1.5px solid color-mix(in srgb, var(--accent) 30%, transparent);
  border-right: 1.5px solid color-mix(in srgb, var(--accent) 30%, transparent);
}
.cmp tbody tr:last-child .cmp-yes { border-bottom: 1.5px solid color-mix(in srgb, var(--accent) 30%, transparent); }

/* Sur9e cell — orange check with text */
.cmp .cmp-cell.win {
  color: var(--text);
  font-weight: 500;
  font-size: 14px;
}
.cmp .cmp-cell.win .cmp-mark {
  background: var(--accent-cta);
  color: #fff;
  box-shadow: 0 2px 8px -2px rgba(255,90,31,0.4);
}

/* Reveal motion: Sur9e column ✓ pops in sequentially */
.cmp tbody .cmp-yes .cmp-cell.win .cmp-mark {
  transform: scale(0);
  opacity: 0;
  transition: transform 420ms var(--ease-calm), opacity 280ms var(--ease-calm);
}
.compare-table-wrap.reveal.in .cmp tbody .cmp-yes .cmp-cell.win .cmp-mark {
  transform: scale(1);
  opacity: 1;
}
.compare-table-wrap.reveal.in .cmp tbody tr:nth-child(1) .cmp-cell.win .cmp-mark { transition-delay: 200ms; }
.compare-table-wrap.reveal.in .cmp tbody tr:nth-child(2) .cmp-cell.win .cmp-mark { transition-delay: 300ms; }
.compare-table-wrap.reveal.in .cmp tbody tr:nth-child(3) .cmp-cell.win .cmp-mark { transition-delay: 400ms; }
.compare-table-wrap.reveal.in .cmp tbody tr:nth-child(4) .cmp-cell.win .cmp-mark { transition-delay: 500ms; }
.compare-table-wrap.reveal.in .cmp tbody tr:nth-child(5) .cmp-cell.win .cmp-mark { transition-delay: 600ms; }
.compare-table-wrap.reveal.in .cmp tbody tr:nth-child(6) .cmp-cell.win .cmp-mark { transition-delay: 700ms; }
.compare-table-wrap.reveal.in .cmp tbody tr:nth-child(7) .cmp-cell.win .cmp-mark { transition-delay: 800ms; }
.cmp-foot {
  margin-top: 18px;
  display: flex; justify-content: center; gap: 28px; flex-wrap: wrap;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--text-muted);
}
.cmp-foot-key { display: inline-flex; align-items: center; gap: 6px; }
@media (max-width: 820px) {
  .cmp { font-size: 13px; }
  .cmp thead th, .cmp tbody td { padding: 12px 12px; }
}
/* Phone + small tablet portrait — restructure table as stacked cards so the
   full comparison is readable without horizontal scroll. Full table view
   stays at ≥720 px (iPad portrait and up). */
@media (max-width: 720px) {
  .compare-table-wrap { overflow-x: visible; }
