    transition:
      background var(--dur-base),
      border-color var(--dur-base),
      box-shadow var(--dur-base);
  }
  .nav.scrolled {
    background: rgba(10, 10, 11, 0.85);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 14px 50px -10px rgba(0, 0, 0, 0.65);
  }
  .nav-logo {
    display: flex;
    align-items: center;
    padding-right: 6px;
  }
  .nav-logo svg {
    height: 18px;
    width: auto;
    display: block;
  }
  .nav-divider {
    width: 1px;
    height: 18px;
    background: rgba(255, 255, 255, 0.1);
    margin: 0 4px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-body);
  }
  .nav-links a {
    color: rgba(244, 244, 245, 0.82);
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 999px;
    white-space: nowrap;
    transition:
      color var(--dur-quick),
      background var(--dur-quick);
  }
  /* hover + active use the GitHub CTA's orange gradient at 80% opacity so the
     pill sits at the bar's translucency level and the menu shows through. Text
     stays fully opaque for contrast. Excludes the GitHub CTA button. */
  .nav-links a:not(.nav-link-cta):hover,
  .nav-links a:not(.nav-link-cta):focus-visible,
  .nav-links a:not(.nav-link-cta).active {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent-cta) 80%, transparent),
      color-mix(in srgb, var(--beauty-ember) 80%, transparent)
    );
    color: #fff;
  }
  /* GitHub CTA lives in the dropdown on mobile only; desktop uses the pill */
  .nav-links .nav-link-cta {
    display: none;
  }
  .nav-toggle {
    display: none;
    background: transparent;
    border: 0;
    width: 30px;
    height: 30px;
    padding: 0;
    cursor: pointer;
    position: relative;
  }
  /* Expand tap area to 44×44 without disturbing the burger/X geometry */
  .nav-toggle::after {
    content: '';
    position: absolute;
    inset: -7px;
  }
  .nav-toggle span {
    position: absolute;
    left: 7px;
    width: 16px;
    height: 2px;
    background: var(--text-dark);
    border-radius: 2px;
    transform-origin: center;
    /* Raycast-style: snappy translate first, rotate after */
    transition:
      top 260ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 260ms cubic-bezier(0.32, 0.72, 0, 1),
      opacity 140ms ease;
  }
  .nav-toggle span:nth-child(1) {
    top: 9px;
  }
  .nav-toggle span:nth-child(2) {
    top: 14px;
  }
  .nav-toggle span:nth-child(3) {
    top: 19px;
  }
  /* Closed → open: translate to center first, then rotate (stagger via delays) */
  .nav-toggle[aria-expanded='true'] span:nth-child(1) {
    top: 14px;
    transform: rotate(45deg);
    transition-delay: 0ms, 120ms, 0ms;
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
    transition-delay: 0ms, 0ms, 0ms;
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(3) {
    top: 14px;
    transform: rotate(-45deg);
    transition-delay: 0ms, 120ms, 0ms;
  }
  /* Open → closed: rotate back first, then translate apart */
  .nav-toggle[aria-expanded='false'] span:nth-child(1),
  .nav-toggle[aria-expanded='false'] span:nth-child(3) {
    transition-delay: 120ms, 0ms, 0ms;
  }
  .nav-toggle[aria-expanded='false'] span:nth-child(2) {
    transition-delay: 0ms, 0ms, 120ms;
  }

  /* Scroll progress indicator */
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 99;
    pointer-events: none;
    background: transparent;
  }
  .scroll-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(
      90deg,
      var(--accent),
      var(--accent-dark-t, #ff8551)
    );
    box-shadow: 0 0 8px rgba(255, 90, 31, 0.5);
    transform-origin: left center;
  }
  /* Floating back-to-top — dark glass, matches the nav pill (revived from the
     pre-revamp footer button); fades in once you scroll past the first viewport */
  .to-top {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 90;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--text-dark-2);
    background: rgba(18, 18, 20, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow:
      0 10px 30px -10px rgba(0, 0, 0, 0.5),
      0 1px 0 rgba(255, 255, 255, 0.06) inset;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition:
      opacity var(--dur-base) var(--ease-calm),
      transform var(--dur-base) var(--ease-calm),
      color var(--dur-quick),
      border-color var(--dur-quick);
  }
  .to-top.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .to-top:hover {
    color: var(--accent);
    border-color: rgba(255, 90, 31, 0.35);
  }
  .to-top:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .to-top svg {
    width: 18px;
    height: 18px;
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .to-top,
    .to-top.show {
      transform: none;
      transition: opacity var(--dur-base);
    }
  }
  @media (max-width: 480px) {
    .to-top {
      right: 14px;
      bottom: 14px;
    }
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent-cta), var(--beauty-ember));
    color: #fff;
    text-decoration: none;
    margin-left: 4px;
    white-space: nowrap;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.28) inset,
      0 18px 42px -18px rgba(255, 90, 31, 0.82);
    transition:
      background var(--dur-quick),
      transform var(--dur-quick);
  }
  .nav-cta-icon {
    width: 15px;
    height: 15px;
    margin-right: 6px;
    margin-top: -1px;
    flex-shrink: 0;
    vertical-align: -2px;
  }
  .nav-cta:hover {
    background: linear-gradient(135deg, var(--accent-cta-hover), #e9571d);
    transform: translateY(-1px);
  }
  .nav-cta:active {
    transform: translateY(0);
  }

  @media (max-width: 760px) {
    .nav {
      top: 10px;
      padding: 8px 10px 8px 18px;
      gap: 6px;
      min-width: min(70vw, 320px);
      justify-content: space-between;
    }
    .nav-logo svg {
      height: 16px;
    }
    .nav-divider {
      display: none;
    }
    /* mobile top bar = logo + hamburger; the GitHub pill is hidden here and
       reappears as the CTA button at the bottom of the dropdown */
    .nav > .nav-cta {
      display: none;
    }
    .nav-toggle {
      display: inline-grid;
      place-items: center;
    }
    .nav-links {
      display: flex;
      /* Anchor to the nav pill (position:fixed parent) so the dropdown stays
         attached directly below it — same width, small gap — instead of
         floating as a detached full-width panel. */
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      padding: 12px;
      background: rgba(10, 10, 11, 0.96);
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 16px;
      backdrop-filter: blur(28px) saturate(160%);
      -webkit-backdrop-filter: blur(28px) saturate(160%);
      box-shadow: 0 14px 50px -10px rgba(0, 0, 0, 0.6);
      transform-origin: top center;
      transform: translateY(-12px) scale(0.97);
      opacity: 0;
      visibility: hidden;
      transition:
        transform var(--dur-base) var(--ease-calm),
        opacity var(--dur-base),
        visibility var(--dur-base);
    }
    .nav-links.open {
      transform: translateY(0) scale(1);
      opacity: 1;
      visibility: visible;
    }
    .nav-links a {
      padding: 13px 14px;
      font-size: 15px;
      text-align: left;
    }
    /* GitHub CTA button at the bottom of the dropdown (mobile primary) */
    .nav-links .nav-link-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 6px;
      padding: 12px 14px;
      background: linear-gradient(
        135deg,
        var(--accent-cta),
        var(--beauty-ember)
      );
      color: #fff;
      font-weight: 600;
      border-radius: 10px;
      text-align: center;
    }
    .nav-links .nav-link-cta:hover {
      background: linear-gradient(135deg, var(--accent-cta-hover), #e9571d);
    }
    .nav-links .nav-link-cta .nav-cta-icon {
      margin-right: 0;
    }
  }
</style>

<script>
  (function () {
    const nav = document.getElementById('nav');
    if (!nav) return;
    const progress = document.getElementById('scrollProgress');
    const toTop = document.getElementById('toTop');
    const toggle = document.getElementById('navToggle');
    const navLinks = document.getElementById('navLinks');
    const linkEls = navLinks
      ? Array.from(navLinks.querySelectorAll('a[href^="#"]'))
      : [];

    function onScroll() {
      nav.classList.toggle('scrolled', window.scrollY > 12);
      if (progress) {
        const docHeight =
          document.documentElement.scrollHeight - window.innerHeight;
        const pct = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
        progress.style.width = pct + '%';
      }
      if (toTop) {
        // reveal once the user is roughly a viewport down the page
        const show = window.scrollY > window.innerHeight * 0.9;
        toTop.classList.toggle('show', show);
        toTop.setAttribute('tabindex', show ? '0' : '-1');
      }
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Mobile menu toggle
    if (toggle && navLinks) {
      toggle.addEventListener('click', () => {
        const isOpen = navLinks.classList.toggle('open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
      navLinks.addEventListener('click', (e) => {
        if (
          e.target instanceof HTMLAnchorElement &&
          navLinks.classList.contains('open')
        ) {
          navLinks.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Active section indicator
    if (linkEls.length && 'IntersectionObserver' in window) {
      const sections = linkEls
        .map((a) => {
          const href = a.getAttribute('href');
          return href ? document.querySelector(href) : null;
        })
        .filter((s) => s !== null);
      const linkBySection = new Map(sections.map((s, i) => [s, linkEls[i]]));
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              linkEls.forEach((a) => a.classList.remove('active'));
              const link = linkBySection.get(en.target);
              if (link) link.classList.add('active');
            }
          });
        },
        { rootMargin: '-40% 0px -55% 0px', threshold: 0 },
      );
      sections.forEach((s) => io.observe(s));
    }
  })();
</script>
