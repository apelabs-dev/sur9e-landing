<section class="waitlist" id="waitlist">
  <div class="waitlist-inner reveal">
    <h2>
      Your job search deserves better tools.<br /><span class="waitlist-sub"
        >Be first when Sur9e ships.</span
      >
    </h2>
    <p>
      Evaluates jobs, finds the hiring manager, drafts the intro, preps the
      interview. Built from a real career profile, not a template.
    </p>
    <label for="waitlist-email" class="email-label">Your email</label>
    <form class="email-form" id="emailForm" novalidate>
      <input
        id="waitlist-email"
        type="email"
        name="email"
        placeholder="you@example.com…"
        required
        autocomplete="email"
        inputmode="email"
        enterkeyhint="send"
        spellcheck="false"
      />
      <button type="submit" data-label="Join the waitlist" data-busy="Joining…"
        >Join the waitlist</button
      >
    </form>
    <p
      class="email-thanks"
      id="emailThanks"
      tabindex="-1"
      role="status"
      aria-live="polite"
    >
      ✓ You're on the list. We'll be in touch.
    </p>
    <ul class="waitlist-pills" aria-label="Promise">
      <li><span class="wp-check">✓</span> Free to start</li>
      <li><span class="wp-check">✓</span> Launching Q4 2026</li>
      <li><span class="wp-check">✓</span> No spam, ever</li>
    </ul>
  </div>
</section>

<style is:global>
  /* =====================================================================
   Section 5: Waitlist (dark)
===================================================================== */
  .waitlist {
    background: linear-gradient(180deg, #0a0a0b 0%, #131110 60%, #1a1411 100%);
    color: var(--text-dark);
    padding: 120px 24px 64px;
    text-align: center;
    border-top: 1px solid var(--border-dark-faint);
    position: relative;
    overflow: hidden;
  }
  .waitlist::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      60% 50% at 50% 0%,
      rgba(255, 106, 51, 0.07),
      transparent 70%
    );
    pointer-events: none;
  }
  .waitlist > * {
    position: relative;
    z-index: 1;
  }
  .waitlist-inner {
    max-width: 580px;
    margin: 0 auto;
  }
  .waitlist h2 {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.08;
    margin: 0 0 22px;
    text-wrap: balance;
  }
  .waitlist h2 .waitlist-sub {
    display: block;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.015em;
    margin-top: 10px;
    color: var(--accent);
  }
  .waitlist p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-dark-muted);
    max-width: 500px;
    margin: 0 auto 36px;
    text-wrap: pretty;
  }
  .email-label {
    display: block;
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dark-muted);
    margin: 0 auto 10px;
    max-width: 520px;
    text-align: left;
  }
  .email-form {
    display: flex;
    align-items: stretch;
    background: #1a1a1d;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 520px;
    margin: 0 auto 24px;
    transition:
      border-color var(--dur-quick),
      box-shadow var(--dur-base);
    padding: 6px;
    gap: 6px;
  }
  .email-form button[aria-busy='true'] {
    opacity: 0.75;
    cursor: progress;
  }
  .email-form:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px rgba(255, 90, 31, 0.12);
  }
  .email-form input {
    flex: 1;
    background: transparent;
    border: 0;
    outline: 0;
    padding: 14px 16px;
    color: var(--text-dark);
    font-family: var(--font-body);
    font-size: 15px;
    min-width: 0;
  }
  .email-form input::placeholder {
    color: var(--text-dark-dim);
  }
  /* Kill Chrome/Safari autofill's white background + dark text. We can't actually
   change the autofill background colour, but we can paint over it with a giant
   inset shadow that matches the form chrome, and force the text colour. */
  .email-form input:-webkit-autofill,
  .email-form input:-webkit-autofill:hover,
  .email-form input:-webkit-autofill:focus,
  .email-form input:-webkit-autofill:active {
    -webkit-text-fill-color: var(--text-dark) !important;
    -webkit-box-shadow: 0 0 0 1000px rgba(255, 255, 255, 0.04) inset !important;
    box-shadow: 0 0 0 1000px rgba(255, 255, 255, 0.04) inset !important;
    caret-color: var(--text-dark);
    border-radius: 0;
    transition: background-color 9999s ease-in-out 0s;
  }
  .email-form button {
    background: var(--accent-cta);
    color: #fff;
    border: 0;
    padding: 14px 24px;
    font-family: var(--font-display);
    font-size: 14.5px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    border-radius: var(--radius-md);
    transition:
      background var(--dur-quick),
      transform var(--dur-quick);
  }
  .email-form button:hover {
    background: var(--accent-cta-hover);
    transform: translateY(-1px);
  }

  /* Benefit pills under the form */
  .waitlist-pills {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dark-muted);
  }
  .waitlist-pills li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .waitlist-pills .wp-check {
    color: var(--tier-high);
    font-size: 12px;
    line-height: 1;
  }
  .email-thanks {
    display: none;
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--tier-high);
    margin: 0 auto 16px;
  }
  .email-thanks.show {
    display: block;
  }
  .email-error {
    display: none;
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--tier-low);
    margin: 8px auto 0;
  }
  .email-error.show {
    display: block;
  }
  @media (max-width: 560px) {
    .waitlist h2 {
      font-size: 28px;
    }
    .email-form {
      flex-direction: column;
    }
    .email-form button {
      width: 100%;
    }
    /* Drop the pill outer-radius when the form stacks vertically — a tall
       container at 999px clips the input into a stretched oval. */
    .waitlist .email-form {
      border-radius: var(--radius-lg);
    }
  }

  /* Waitlist input focus glow */
  .waitlist-form input:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(255, 90, 31, 0.18);
    border-color: var(--accent) !important;
  }

  /* ====================================================================
   Beauty pass — glass card container (orbs removed per request)
==================================================================== */
  .waitlist {
    padding-top: 112px;
    background: linear-gradient(180deg, #0a0a0b 0%, #131110 60%, #1a1411 100%);
  }

  .waitlist-inner {
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 26px;
    padding: clamp(34px, 6vw, 64px);
    background: rgba(255, 255, 255, 0.045);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 34px 100px -48px rgba(0, 0, 0, 0.86);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  /* Pill-shaped form elements inside the glass card */
  .waitlist .email-form {
    border-radius: 999px;
  }
  .waitlist .email-form button {
    border-radius: 999px;
  }
</style>

<script>
  (function () {
    const form = document.getElementById('emailForm');
    if (!form) return;
    const input = form.querySelector('input[name=email]');
    const submitBtn = form.querySelector('button[type=submit]');
    const thanks = document.getElementById('emailThanks');
    let errEl = document.getElementById('emailError');
    if (!errEl) {
      errEl = document.createElement('p');
      errEl.id = 'emailError';
      errEl.className = 'email-error';
      errEl.setAttribute('aria-live', 'polite');
      form.insertAdjacentElement('afterend', errEl);
    }
    const showError = (msg) => {
      errEl.textContent = msg;
      errEl.classList.add('show');
      input.setAttribute('aria-invalid', 'true');
    };
    const clearError = () => {
      errEl.classList.remove('show');
      input.removeAttribute('aria-invalid');
    };
    const setBusy = (busy) => {
      if (!submitBtn) return;
      if (busy) {
        submitBtn.disabled = true;
        submitBtn.setAttribute('aria-busy', 'true');
        submitBtn.textContent = submitBtn.dataset.busy || 'Joining…';
      } else {
        submitBtn.disabled = false;
        submitBtn.removeAttribute('aria-busy');
        submitBtn.textContent = submitBtn.dataset.label || 'Join the waitlist';
      }
    };
    input.addEventListener('input', clearError);
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const email = input.value.trim();
      if (!email) {
        showError('Please enter your email.');
        input.focus();
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError("That doesn't look like an email — try again.");
        input.focus();
        return;
      }
      clearError();
      setBusy(true);
      // No backend wired yet — simulate latency so the busy state is visible,
      // then show the thanks message and keep the form available for the
      // (extremely rare) case the user wants to amend it.
      window.setTimeout(() => {
        setBusy(false);
        form.style.display = 'none';
        thanks.classList.add('show');
        thanks.focus && thanks.focus();
      }, 600);
    });
  })();
</script>
