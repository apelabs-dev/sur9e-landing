  .qs-card-bar span {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: var(--surface-dark-2);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 360ms var(--ease-calm);
  }
  .qs-card-bar span.on {
    background: var(--tier-high);
  }
  .qs-step.is-active .qs-card-bar span,
  .qs-step.is-done .qs-card-bar span {
    transform: scaleX(1);
  }
  .qs-step.is-active .qs-card-bar span:nth-child(1) {
    transition-delay: 380ms;
  }
  .qs-step.is-active .qs-card-bar span:nth-child(2) {
    transition-delay: 460ms;
  }
  .qs-step.is-active .qs-card-bar span:nth-child(3) {
    transition-delay: 540ms;
  }
  .qs-step.is-active .qs-card-bar span:nth-child(4) {
    transition-delay: 620ms;
  }
  .qs-step.is-active .qs-card-bar span:nth-child(5) {
    transition-delay: 700ms;
  }
  .qs-card-tag {
    display: inline-flex;
    align-items: center;
    margin-top: 13px;
    padding: 3px 9px;
    border-radius: 999px;
    font: 500 9.5px var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tier-high);
    background: color-mix(in srgb, var(--tier-high) 12%, transparent);
    opacity: 0;
    transform: scale(0.82);
    transition:
      opacity 300ms var(--ease-calm),
      transform 300ms var(--ease-calm);
  }
  .qs-step.is-active .qs-card-tag,
  .qs-step.is-done .qs-card-tag {
    opacity: 1;
    transform: scale(1);
  }
  .qs-step.is-active .qs-card-tag {
    transition-delay: 780ms;
  }
  .command-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    background: var(--bg-dark);
