---
import DemoFrame from './DemoFrame.astro';
---

<section class="section" id="how">
  <div class="section-head reveal">
    <span class="eyebrow">How it works</span>
    <h2>Three steps, <span class="accent">thirty seconds</span>.</h2>
    <p>From a URL to a decision — without applying first to find out.</p>
  </div>

  <div class="wrap">
    <div class="steps">
      <div class="step reveal tier-low" data-step="1">
        <span class="tier-band" aria-hidden="true"></span>
        <div class="step-num">Step 1</div>
        <h3>Drop a link</h3>
        <p>
          Paste a URL. Score from the page with the Chrome extension. Or let
          Sur9e surface best-fit roles from Greenhouse, Lever, and more.
        </p>
      </div>
      <div class="step reveal tier-mid" data-step="2">
        <span class="tier-band" aria-hidden="true"></span>
        <div class="step-num">Step 2</div>
        <h3>Read the score</h3>
        <p>
          30 seconds. Scored against the CV, comp targets, dealbreakers, and
          career goals. With reasoning, not just a number.
        </p>
      </div>
      <div class="step reveal tier-high" data-step="3">
        <span class="tier-band" aria-hidden="true"></span>
        <div class="step-num">Step 3</div>
        <h3>Pick or pass</h3>
        <p>Apply with confidence — or move on. The second-guessing stops.</p>
      </div>
    </div>

    <!-- Animated demo -->
    <DemoFrame />
    <div class="how-cta reveal">
      <a href="#waitlist" class="btn btn-primary"
        >Score the first job when Sur9e ships</a
      >
    </div>
  </div>
</section>

<style>
  .section {
    padding: 96px 24px;
    background:
      radial-gradient(
        circle at 8% 10%,
        rgba(255, 90, 31, 0.08),
        transparent 18rem
      ),
      radial-gradient(
        circle at 90% 24%,
        rgba(153, 184, 132, 0.12),
        transparent 20rem
      ),
      var(--bg);
    position: relative;
    overflow: hidden;
  }
  .section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(
      to right,
      rgba(31, 29, 26, 0.045) 1px,
      transparent 1px
    );
    background-size: 64px 100%;
    background-position: 24px 0;
    opacity: 1;
    z-index: 0;
  }
  .section::after {
    content: '';
    position: absolute;
    top: 24px;
    left: 24px;
    width: 14px;
    height: 14px;
    pointer-events: none;
    border-left: 1px solid rgba(31, 29, 26, 0.32);
    border-top: 1px solid rgba(31, 29, 26, 0.32);
    z-index: 2;
  }
  .section > * {
    position: relative;
    z-index: 1;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto 80px;
    position: relative;
  }
  .step {
    position: relative;
    padding: 32px 28px 28px;
    background: var(--bg-paper);
    border: 1px solid var(--border);
    border-radius: 14px;
    z-index: 1;
    transition:
      transform var(--dur-base) var(--ease-calm),
      border-color var(--dur-base),
      box-shadow var(--dur-base);
    overflow: hidden;
    --tier: var(--accent);
  }
  .step.tier-low {
    --tier: var(--tier-low);
  }
  .step.tier-mid {
    --tier: var(--tier-mid);
  }
  .step.tier-high {
    --tier: var(--tier-high);
  }
  .step .tier-band {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--tier);
    opacity: 0.85;
  }
  .step::before {
    content: attr(data-step);
    position: absolute;
    top: -32px;
    right: -12px;
    font-family: var(--font-display);
    font-size: 240px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--tier);
    opacity: 0.32;
    pointer-events: none;
    transition:
      opacity var(--dur-base),
      transform var(--dur-base) var(--ease-calm);
  }
  .step::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 90% 10%,
      color-mix(in srgb, var(--tier) 14%, transparent),
      transparent 50%
    );
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-base);
  }
  .step:hover::after {
    opacity: 1;
  }
  .step:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--tier) 45%, var(--border));
    box-shadow:
      0 18px 48px -20px color-mix(in srgb, var(--tier) 35%, transparent),
      0 1px 0 color-mix(in srgb, var(--tier) 14%, transparent) inset;
  }
  .step:hover::before {
    opacity: 0.5;
    transform: translateY(-4px);
  }
  .step-arrow {
    display: none;
  }
  .step-num {
    width: auto;
    height: auto;
    background: transparent;
    color: var(--tier);
    border: none;
    border-radius: 0;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 18px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0;
  }
  .step-num::before {
    content: '';
    display: inline-block;
    width: 18px;
    height: 1px;
    background: var(--tier);
    margin-right: 10px;
    vertical-align: middle;
  }
  .step h3 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 12px;
    line-height: 1.2;
    text-wrap: balance;
    position: relative;
  }
  .step p {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-3);
    margin: 0;
    text-wrap: pretty;
    position: relative;
  }
  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 56px;
    }
    .step {
      padding: 28px 24px 24px;
    }
    .step::before {
      font-size: 160px;
      top: -16px;
      right: -4px;
    }
    .steps .step-arrow {
      display: none;
    }
    .step h3 {
      font-size: 22px;
    }
    .step p {
      font-size: 15px;
    }
  }

  /* End-of-section CTA after How It Works demo */
  .how-cta {
    display: flex;
    justify-content: center;
    margin-top: 48px;
    position: relative;
    z-index: 1;
  }
  .how-cta .btn {
    padding: 12px 24px;
    font-size: 13.5px;
  }

  /* B1 texture responsive cascade — section variant */
  @media (max-width: 1024px) {
    .section::before {
      background-size: 48px 100%;
    }
  }
  @media (max-width: 720px) {
    .section::before {
      background-size: 40px 100%;
      background-position: 16px 0;
    }
  }

  /* Stagger reveal delay for steps */
  .step.reveal.in {
    transition-delay: var(--rd, 0ms);
  }
</style>

<script>
  // Stagger reveal delay for steps
  document.querySelectorAll('.steps .step').forEach((el, i) => {
    el.style.setProperty('--rd', i * 140 + 'ms');
  });
</script>
