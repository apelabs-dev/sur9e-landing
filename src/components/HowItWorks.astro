  }
  .drawer-block {
    margin-top: 14px;
  }
  .score-table {
    margin-top: 14px;
    border-top: 1px solid var(--rule);
  }
  .score-table div {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--text-3);
    font: 600 12px var(--font-display);
  }
  .score-table b {
    color: var(--text);
  }
  @media (prefers-reduced-motion: reduce) {
    .qs-trajectory path,
    .qs-node,
    .qs-node svg,
    .qs-node svg path,
    .qs-card-bar span,
    .qs-card-tag,
    .qs-visual-img img {
      transition: none;
    }
    .qs-visual-img img {
      opacity: 1;
    }
    .qs-step.in .qs-node,
    .qs-step.is-active .qs-node {
      opacity: 1;
      transform: translateY(-50%);
    }
    .qs-step.is-active .qs-node svg {
      animation: none;
      transform: scale(1);
    }
    .qs-node svg path {
      fill: url(#qsAccentGrad);
      stroke: url(#qsAccentGrad);
    }
    .qs-card-bar span {
      transform: scaleX(1);
    }
    .qs-card-tag {
      opacity: 1;
      transform: scale(1);
    }
    .command-line code.qs-typing::after,
    .cli-event,
    .cli-input-caret,
    .materialized,
    .report-drawer {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 980px) {
    .qs-steps {
      gap: 34px;
    }
    .qs-step,
    .qs-step:nth-of-type(2),
    .split-demo {
      grid-template-columns: 1fr;
    }
    .qs-step,
    .qs-step:nth-of-type(2) {
      grid-template-columns: 54px minmax(0, 1fr);
      grid-template-areas:
        'rail text'
        'rail visual';
      column-gap: 14px;
      row-gap: 16px;
    }
    .qs-step:nth-of-type(2) .qs-text {
      order: 0;
    }
    .qs-step {
      align-items: start;
      padding: 10px 0 18px;
    }
    .qs-rail {
      grid-area: rail;
      align-self: stretch;
      min-height: 48px;
    }
    .qs-node {
      position: absolute;
      top: 0;
      left: 0;
      width: 48px;
      height: 48px;
      opacity: 1;
      transform: none;
    }
    .qs-step.in .qs-node {
      transform: none;
    }
    .qs-step.is-active .qs-node svg {
      animation-name: qs-node-pulse-mobile;
    }
    .qs-node-num {
      font-size: 12px;
    }
    .qs-text {
      grid-area: text;
      max-width: none;
    }
    .qs-visual {
      grid-area: visual;
      justify-items: stretch;
    }
    .terminal-body {
      min-height: auto;
    }
    @keyframes qs-node-pulse-mobile {
      0%,
      100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.06);
      }
    }
  }
  @media (max-width: 980px) and (prefers-reduced-motion: reduce) {
    .qs-step.in .qs-node,
    .qs-step.is-active .qs-node {
      transform: none;
    }
    .qs-step.is-active .qs-node svg {
      transform: scale(1);
    }
  }
  @media (max-width: 720px) {
    .mechanic-inner {
      padding: 86px 24px 68px;
    }
    .mechanic-head {
      margin-bottom: 34px;
    }
    .qs-text h3 {
      font-size: 22px;
    }
    .qs-text p {
      font-size: 16px;
    }
    .demo-band {
      padding: 72px 18px 78px;
    }
    .split-demo {
      gap: 16px;
    }
    .cli-topline,
    .cli-command {
      padding-inline: 14px;
      white-space: normal;
    }
    .cli-topline {
      font-size: 12px;
    }
    .cli-command {
      font-size: 13px;
    }
    .terminal-body {
      min-height: 520px;
      padding: 15px 14px 10px;
      gap: 15px;
      font-size: 12px;
    }
    .cli-input-window {
      margin-inline: 14px;
      padding: 10px;
    }
    .cli-event {
      grid-template-columns: 13px minmax(0, 1fr);
      gap: 6px;
    }
    .terminal-diff {
      font-size: 11px;
    }
    .ui-shell {
      grid-template-columns: 1fr;
      min-height: 620px;
    }
    .ui-sidebar {
      display: none;
    }
    .kanban {
      grid-template-columns: 1fr;
    }
    .ghost-col {
      display: none;
    }
    .report-drawer {
      inset: auto 12px 12px;
      width: auto;
      max-height: 300px;
    }
  }
</style>

<script>
  import { initScriptCopyButtons } from '../scripts/script-copy-button.js';
  import { initHowItWorksDeck } from '../scripts/how-it-works-deck.js';

  initScriptCopyButtons(document);
  initHowItWorksDeck(document);

  // One scroll spine drives the node state, trajectory fill, and step visuals.
  (function () {
    const stepsWrap = document.querySelector('.qs-steps');
    const svg = stepsWrap?.querySelector('.qs-trajectory');
    const donePath = svg?.querySelector('.qs-path-done');
    const nextPath = svg?.querySelector('.qs-path-next');
    const stepEls = stepsWrap
      ? [...stepsWrap.querySelectorAll('.qs-step')]
      : [];
    const nodes = stepsWrap ? [...stepsWrap.querySelectorAll('.qs-node')] : [];
    if (!stepsWrap || !svg || !donePath || !nextPath || stepEls.length < 1) {
      return;
    }

    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    const scoreEl = stepsWrap.querySelector('.qs-card-num');
    const scoreTarget = scoreEl ? parseFloat(scoreEl.textContent) || 4.4 : 4.4;
    const played = new WeakSet();
    let hasEntered = false;
    let activeIndex = -1;
    let segmentDs = [];
    let raf = 0;

    if (scoreEl && !reduce) scoreEl.textContent = '0.0';
    let typingRun = 0;

    function terminalParts(step) {
      const shell = step.querySelector('.command-shell');
      const url = step.querySelector('.command-url');
      const code = step.querySelector('.command-line code');
      if (!shell || !url) return null;
      shell.dataset.fullText = shell.dataset.fullText || shell.textContent;
      url.dataset.fullText = url.dataset.fullText || url.textContent;
      return {
        shell,
        url,
        code,
        shellText: shell.dataset.fullText,
        urlText: url.dataset.fullText,
      };
    }

    stepEls.forEach((step) => {
      const parts = terminalParts(step);
      if (parts && !reduce) {
        parts.shell.textContent = '';
        parts.url.textContent = '';
      }
    });

    function pathForSegments(from, to) {
      return segmentDs.slice(from, to).join(' ');
    }

    function updateLine(index, allDone) {
      const completed = allDone ? segmentDs.length : Math.max(0, index);
      donePath.setAttribute('d', pathForSegments(0, completed));
      nextPath.setAttribute('d', pathForSegments(completed, segmentDs.length));
    }

    function draw() {
      if (nodes.length < 2) return;
      const base = stepsWrap.getBoundingClientRect();
      svg.setAttribute('viewBox', `0 0 ${base.width} ${base.height}`);
      // Span the vertical (userSpaceOnUse) line gradient over the full height so
      // the connector reads orange→peach→orange like the hero accent headline.
      const gradV = svg.querySelector('#qsAccentGradV');
      if (gradV) gradV.setAttribute('y2', base.height.toFixed(1));
      const pts = nodes.map((n) => {
        const r = n.getBoundingClientRect();
        const x = r.left - base.left + r.width / 2;
        const y = r.top - base.top;
        // Tuck a hair *into* the star at each tip so the connector ends sit
        // behind the marker (the trajectory SVG is z-index 0, the nodes 1).
        // Small enough that it never pokes through a hollow (un-filled) star.
        const overlap = Math.max(2, r.height * 0.04);
        return {
          x: +x.toFixed(1),
          // These match the star path's centerline attachment points:
          // top tip (32, 4) and bottom tip (32, 60). Pulling toward the star
          // body (+ at the top tip, − at the bottom tip) hides the connector
          // ends under the tip stroke — no visible gap, no bleed past the tip.
          topY: +(y + r.height * (4 / 64) + overlap).toFixed(1),
          bottomY: +(y + r.height * (60 / 64) - overlap).toFixed(1),
        };
      });
      segmentDs = [];
      for (let i = 1; i < pts.length; i++) {
        const a = pts[i - 1];
        const b = pts[i];
        const ay = a.bottomY;
        const by = b.topY;
        if (by <= ay) continue;
        const ym = +((ay + by) / 2).toFixed(1);
        segmentDs.push(
          `M ${a.x} ${ay} C ${a.x} ${ym}, ${b.x} ${ym}, ${b.x} ${by}`,
        );
      }
      updateProgress();
    }

    function finishTerminal(step) {
      const parts = terminalParts(step);
      if (!parts) return;
      step.dataset.typingRun = '';
      parts.shell.textContent = parts.shellText;
      parts.url.textContent = parts.urlText;
      if (parts.code) parts.code.classList.remove('qs-typing');
    }

    function resetTerminal(step) {
      const parts = terminalParts(step);
      if (!parts || reduce) return;
      step.dataset.typingRun = '';
      parts.shell.textContent = '';
      parts.url.textContent = '';
      if (parts.code) parts.code.classList.remove('qs-typing');
    }

    function finishScore(step) {
      const el = step.querySelector('.qs-card-num');
      if (el) el.textContent = scoreTarget.toFixed(1);
    }

    function typeInto(step, el, text, speed, run, done) {
      let i = 0;
      (function tick() {
        if (step.dataset.typingRun !== run) return;
        el.textContent = text.slice(0, i);
        if (i < text.length) {
          i++;
          setTimeout(tick, speed);
        } else if (done) {
          done();
        }
      })();
    }

    function typeTerminal(step) {
      const parts = terminalParts(step);
      if (!parts) return;
      if (reduce) {
        finishTerminal(step);
        return;
      }
      const run = String(++typingRun);
      step.dataset.typingRun = run;
      parts.shell.textContent = '';
      parts.url.textContent = '';
      if (parts.code) parts.code.classList.add('qs-typing');
      typeInto(step, parts.shell, parts.shellText, 55, run, () =>
        typeInto(step, parts.url, parts.urlText, 26, run, () => {
          if (parts.code) parts.code.classList.remove('qs-typing');
        }),
      );
    }

    function countScore(step) {
      const el = step.querySelector('.qs-card-num');
      if (!el) return;
      if (reduce) {
        finishScore(step);
        return;
      }
      const dur = 950;
      const start = performance.now();
      requestAnimationFrame(function tick(now) {
        const t = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = (scoreTarget * eased).toFixed(1);
        if (t < 1) requestAnimationFrame(tick);
      });
    }

    function playVisual(step) {
      if (step.querySelector('.command-shell')) {
        typeTerminal(step);
        return;
      }
      if (played.has(step)) return;
      played.add(step);
      if (step.querySelector('.qs-card-num')) countScore(step);
    }

    function resolveVisual(step) {
      if (step.querySelector('.command-shell')) finishTerminal(step);
      if (step.querySelector('.qs-card-num')) {
        played.add(step);
        finishScore(step);
      }
    }

    function setStepState(index, allDone) {
      stepEls.forEach((step, i) => {
        const done = allDone || i < index;
        const active = !allDone && i === index;
        step.classList.toggle('is-done', done);
        step.classList.toggle('is-active', active);
        step.classList.toggle('is-next', !done && !active);
        if (active) playVisual(step);
        if (!active && !done) resetTerminal(step);
        if (done) resolveVisual(step);
      });
      updateLine(index, allDone);
    }

    function setPreEntryState() {
      stepEls.forEach((step) => {
        step.classList.remove('is-done', 'is-active');
        step.classList.add('is-next');
      });
      updateLine(0, false);
    }

    function sectionIsVisible() {
      const r = stepsWrap.getBoundingClientRect();
      return r.top < window.innerHeight && r.bottom > 0;
    }

    function updateProgress() {
      if (reduce) {
        hasEntered = true;
        svg.classList.add('in');
        setStepState(-1, true);
        return;
      }

      if (!hasEntered && sectionIsVisible()) {
        hasEntered = true;
        svg.classList.add('in');
      }
      if (!hasEntered) {
        setPreEntryState();
        return;
      }

      const triggerY = window.innerHeight * 0.45;
      const markerYs = nodes.map((node) => {
        const r = node.getBoundingClientRect();
        return r.top + r.height / 2;
      });
      const nextIndex = markerYs.findIndex((y) => y >= triggerY);
      const allDone = nextIndex === -1;
      const nextActive = allDone ? -1 : nextIndex;

      if (allDone || nextActive !== activeIndex) {
        activeIndex = nextActive;
        setStepState(nextActive, allDone);
      } else {
        updateLine(nextActive, false);
      }
    }

    function requestUpdate() {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        updateProgress();
      });
    }

    draw();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', draw);
    window.addEventListener('load', draw);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(draw);
    // The .reveal entrance animates each step from translateY(20px) → 0. That
    // shift happens after the initial draw(), so the node tips move ~20px and
    // the frozen path no longer lines up (gap below one star, bleed past the
    // next). Recompute once the transform settles.
    stepsWrap.addEventListener('transitionend', (e) => {
      if (e.propertyName === 'transform') draw();
    });
    if (window.ResizeObserver) {
      new ResizeObserver(draw).observe(stepsWrap);
    }
    stepsWrap.querySelectorAll('img').forEach((img) => {
      if (!img.complete) img.addEventListener('load', draw, { once: true });
    });
  })();
</script>
