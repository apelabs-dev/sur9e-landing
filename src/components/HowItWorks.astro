---
import PipelineCard from '../report-vendor/PipelineCard';
import '../report-vendor/styles/report-light.css';
import '../report-vendor/styles/scoped/report-hero.css';
import '../report-vendor/styles/scoped/report-snapshot.css';
import '../report-vendor/styles/scoped/report-inline.css';
import '../report-vendor/styles/scoped/tiptap-editor.css';
import '../report-vendor/styles/scoped/chrome.css';
import '../report-vendor/styles/scoped/pipeline-inline.css';
import '../report-vendor/styles/scoped/board-drawer.css';
import '../report-vendor/styles/deck-pipeline.css';

const installCommand = 'bash -c "$(curl -fsSL https://sur9e.com/install)"';
const demoCommand = '/sur9e apply';

const cliEvents = [
  {
    kind: 'narration',
    text: "Got it. I'll run Sur9e: screen cheap, evaluate deep, then write the report.",
  },
  {
    kind: 'read',
    text: 'Read 3 files (CLAUDE.md, content/modes/screen.md, content/modes/evaluate.md)',
  },
  {
    kind: 'narration',
    text: 'The AI agent is the CLI. Modes are prompts in content/modes; the web UI reads the same files.',
  },
  {
    kind: 'tool',
    name: 'Bash',
    command: 'npx tsx --conditions=react-server cli/resolve-mode.mjs evaluate',
    output: 'mode evaluate -> provider claude · model default',
  },
  {
    kind: 'tool',
    name: 'Mode',
    command: 'screen https://jobs.ashbyhq.com/siftstack/gtm-engineer',
    output: 'screen · passes threshold',
  },
  {
    kind: 'tool',
    name: 'Mode',
    command: 'evaluate --deep --num 5',
    output: 'eval · 4.3 / 5.0 high confidence',
  },
  {
    kind: 'update',
    file: 'artifacts/reports/005-siftstack-2026-06-05.md',
    summary: 'Added 1 report, updated 1 tracker row',
  },
  {
    kind: 'tool',
    name: 'Bash',
    command: 'open http://localhost:3000/report/005-siftstack',
    output: 'local report opened · pipeline refreshed from disk',
  },
];
---

<section class="mechanic" id="how-it-works" aria-labelledby="how-heading">
  <div class="mechanic-paper" aria-hidden="true"></div>
  <div class="mechanic-inner">
    <div class="section-head mechanic-head reveal">
      <span class="eyebrow">01 · How it works</span>
      <h2 id="how-heading">
        There's no app to sign up for. It runs inside the coding agent you
        already use.
      </h2>
    </div>

    <div class="qs-steps">
      <svg class="qs-trajectory" aria-hidden="true">
        <defs>
          <!-- Same orange→peach→orange sweep as the hero "worth your time"
               headline accent (tokens: --accent #ff5a1f, #ffb88a highlight). -->
          <linearGradient id="qsAccentGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#ff5a1f"></stop>
            <stop offset="50%" stop-color="#ffb88a"></stop>
            <stop offset="100%" stop-color="#ff5a1f"></stop>
          </linearGradient>
          <!-- userSpaceOnUse: the connector is a zero-width vertical path, so an
               objectBoundingBox gradient would be degenerate and drop the stroke.
               y2 is set to the steps' height in draw(). -->
          <linearGradient
            id="qsAccentGradV"
            gradientUnits="userSpaceOnUse"
            x1="0"
            y1="0"
            x2="0"
            y2="600"
          >
            <stop offset="0%" stop-color="#ff5a1f"></stop>
            <stop offset="50%" stop-color="#ffb88a"></stop>
            <stop offset="100%" stop-color="#ff5a1f"></stop>
          </linearGradient>
        </defs>
        <path class="qs-path-done"></path>
        <path class="qs-path-next"></path>
      </svg>
      <article class="qs-step reveal">
        <div class="qs-rail" aria-hidden="true">
          <span class="qs-node">
            <svg viewBox="0 0 64 64" aria-hidden="true">
              <path
                d="M32 4 39.5 24.5 60 32 39.5 39.5 32 60 24.5 39.5 4 32 24.5 24.5Z"
              ></path>
            </svg>
            <span class="qs-node-num">01</span>
          </span>
        </div>
        <div class="qs-text">
          <h3>Run one command</h3>
          <p>
            One command checks your prerequisites, clones the repo, and launches
            the guided setup. Needs Node 20+, Git, and one AI coding CLI (<code
              >claude code</code
            >, <code>codex</code>, or <code>opencode</code>). Python 3.10+
            powers the job scanner. Runs anywhere your agent does.
          </p>
        </div>
        <div class="qs-visual qs-visual-term">
          <div class="qs-term">
            <div class="qs-term-bar" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <div class="command-row">
              <pre
                class="command-line"><code><span class="command-shell">bash -c</span> <span class="command-url">"$(curl -fsSL https://sur9e.com/install)"</span></code></pre>
              <button
                type="button"
                class="copy-button"
                aria-label="Copy install command"
                data-copy-button
                data-copy-value={installCommand}
                data-copied-label="Copied"
              >
                <span class="copy-icon" aria-hidden="true">
                  <svg class="copy-glyph" viewBox="0 0 20 20" fill="none">
                    <rect x="7" y="5" width="9" height="11" rx="2"></rect>
                    <path d="M4 12.5V4a2 2 0 0 1 2-2h7.5"></path>
                  </svg>
                </span>
              </button>
            </div>
          </div>
        </div>
      </article>

      <article class="qs-step reveal">
        <div class="qs-rail" aria-hidden="true">
          <span class="qs-node">
            <svg viewBox="0 0 64 64" aria-hidden="true">
              <path
                d="M32 4 39.5 24.5 60 32 39.5 39.5 32 60 24.5 39.5 4 32 24.5 24.5Z"
              ></path>
            </svg>
            <span class="qs-node-num">02</span>
          </span>
        </div>
        <div class="qs-text">
          <h3>The agent onboards you</h3>
          <p>
            Open your agent inside the folder. It reads its own docs, interviews
            you about your CV, goals, and dealbreakers, and builds your profile.
            The product onboards itself.
          </p>
        </div>
        <div class="qs-visual qs-visual-img">
          <img
            src="/assets/download-box-icon-ai-sparkle-transparent.png"
            alt="Your LinkedIn, CV, and wins flowing into Sur9e"
            width="300"
            height="300"
            loading="lazy"
            decoding="async"
          />
        </div>
      </article>

      <article class="qs-step reveal">
        <div class="qs-rail" aria-hidden="true">
          <span class="qs-node">
            <svg viewBox="0 0 64 64" aria-hidden="true">
              <path
                d="M32 4 39.5 24.5 60 32 39.5 39.5 32 60 24.5 39.5 4 32 24.5 24.5Z"
              ></path>
            </svg>
            <span class="qs-node-num">03</span>
          </span>
        </div>
        <div class="qs-text">
          <h3>Evaluate your first offer</h3>
          <p>
            Paste a job. Sur9e screens it cheap, then evaluates deep, scoring it
            against your real profile: fit, comp, seniority, and dealbreakers,
            with the reasoning behind every call.
          </p>
        </div>
        <div class="qs-visual qs-visual-card">
          <div class="qs-card">
            <div class="qs-card-head">
              <div class="qs-card-mark">
                <svg
                  viewBox="100 100 312 312"
                  fill="currentColor"
                  aria-hidden="true"
                  ><path d="m120 392 272-57.683V120l-272 58.357z"></path></svg
                >
              </div>
              <div>
                <div class="qs-card-co">Stripe</div>
                <div class="qs-card-role">Technical Account Mgr</div>
              </div>
            </div>
            <div class="qs-card-score">
              <div class="qs-card-num">4.4</div>
              <div class="qs-card-denom">/ 5.0</div>
            </div>
            <div class="qs-card-bar">
              <span class="on"></span><span class="on"></span><span class="on"
              ></span><span class="on"></span><span></span>
            </div>
            <div class="qs-card-tag">Apply · strong fit</div>
          </div>
        </div>
      </article>
    </div>
  </div>

  <div class="demo-band" aria-labelledby="demo-heading">
    <div class="demo-band-inner">
      <div class="demo-copy reveal">
        <span class="demo-kicker">same run, two views</span>
        <h3 id="demo-heading">Watch it work. Read what it wrote.</h3>
        <p>
          One evaluate run, two ways to see it: the agent reasoning in your
          terminal, and the report it writes. That report is a markdown file you
          own, edited inline in the real Sur9e viewer, not a mockup. Flip
          between them.
        </p>
      </div>

      <div class="demo-deck" data-deck>
        <div class="deck-tabs" role="tablist" aria-label="Demo views">
          <button
            type="button"
            class="deck-tab is-active"
            data-deck-tab="report"
            id="deck-tab-report"
            role="tab"
            aria-selected="true"
            aria-controls="deck-card-report"
          >
            <span class="deck-tab-dot" aria-hidden="true"></span>Web
          </button>
          <button
            type="button"
            class="deck-tab"
            data-deck-tab="agent"
            id="deck-tab-agent"
            role="tab"
            aria-selected="false"
            aria-controls="deck-card-agent"
          >
            <span class="deck-tab-dot" aria-hidden="true"></span>Terminal
          </button>
        </div>

        <div class="deck-stage">
          <div
            class="deck-card is-back"
            data-deck-card="agent"
            id="deck-card-agent"
            role="tabpanel"
            aria-labelledby="deck-tab-agent"
          >
            <div class="agent-terminal" aria-hidden="true">
              <div class="cli-topline">
                v24.15.0 ~/career/sur9e git:(main) 0 • +0 -0 (14s)
              </div>
              <div class="cli-rule"></div>
              <div class="terminal-body">
                {
                  cliEvents.map((event) => (
                    <div class={`cli-event event-${event.kind}`}>
                      {event.kind === 'narration' && (
                        <>
                          <span class="event-dot">•</span>
                          <p>{event.text}</p>
                        </>
                      )}
                      {event.kind === 'read' && (
                        <p class="read-line">{event.text}</p>
                      )}
                      {event.kind === 'tool' && (
                        <>
                          <span class="event-dot green">•</span>
                          <div class="tool-call">
                            <p>
                              <strong>{event.name}</strong>({event.command})
                            </p>
                            <span class="tool-output">└ {event.output}</span>
                          </div>
                        </>
                      )}
                      {event.kind === 'update' && (
                        <>
                          <span class="event-dot green">•</span>
                          <div class="tool-call">
                            <p>
                              <strong>Update</strong>({event.file})
                            </p>
                            <span class="tool-output">└ {event.summary}</span>
                            <div class="terminal-diff">
                              <span class="diff-line context">5</span>
                              <span class="diff-line removed">
                                - Status: Screened · fit unknown
                              </span>
                              <span class="diff-line added">
                                + Status: Evaluated · score 4.3/5.0 · high
                                confidence
                              </span>
                              <span class="diff-line added">
                                + Next: send hiring-manager note, build the RAG
                                demo deck
                              </span>
                            </div>
                          </div>
                        </>
                      )}
                    </div>
                  ))
                }
              </div>
              <div class="cli-input-window">
                <div class="cli-input-meta" aria-hidden="true">
                  <span>v24.15.0</span>
                  <span>~/career/sur9e</span>
                  <span>main</span>
                  <span>+0</span>
                </div>
                <div class="cli-user-input">
                  <code>{demoCommand}</code>
                  <span class="cli-input-caret"></span>
                </div>
              </div>
            </div>
          </div>

          <div
            class="deck-card is-front"
            data-deck-card="report"
            id="deck-card-report"
            role="tabpanel"
            aria-labelledby="deck-tab-report"
          >
            <PipelineCard client:visible />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mechanic {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 14% 10%,
        rgba(255, 106, 42, 0.07),
        transparent 38%
      ),
      radial-gradient(
        circle at 88% 84%,
        rgba(153, 184, 132, 0.06),
        transparent 42%
      ),
      var(--bg);
    color: var(--text);
  }
  /* faint starfield specks */
  .mechanic::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(
        1.5px 1.5px at 12% 20%,
        rgba(255, 122, 68, 0.4),
        transparent 60%
      ),
      radial-gradient(
        1px 1px at 79% 13%,
        rgba(120, 120, 120, 0.22),
        transparent 60%
      ),
      radial-gradient(
        1.5px 1.5px at 63% 72%,
        rgba(255, 122, 68, 0.3),
        transparent 60%
      ),
      radial-gradient(
        1px 1px at 31% 85%,
        rgba(120, 120, 120, 0.2),
        transparent 60%
      ),
      radial-gradient(
        1px 1px at 92% 58%,
        rgba(255, 122, 68, 0.28),
        transparent 60%
      ),
      radial-gradient(
        1px 1px at 46% 8%,
        rgba(120, 120, 120, 0.18),
        transparent 60%
      );
  }
  .mechanic-paper {
    position: absolute;
    inset: 0 0 auto;
    height: 54%;
    pointer-events: none;
    background:
      radial-gradient(rgba(31, 29, 26, 0.055) 1px, transparent 1.4px),
      linear-gradient(90deg, rgba(255, 90, 31, 0.05) 1px, transparent 1px),
      linear-gradient(rgba(17, 17, 17, 0.035) 1px, transparent 1px);
    background-size:
      24px 24px,
      96px 96px,
      96px 96px;
    -webkit-mask-image: linear-gradient(#000 0%, transparent 92%);
    mask-image: linear-gradient(#000 0%, transparent 92%);
  }
  .mechanic-inner {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    padding: 112px 24px 88px;
  }
  .mechanic-head {
    margin-bottom: 54px;
  }
  /* ── 3-step quickstart: stepped trajectory · text left, visual right ── */
  .qs-steps {
    position: relative;
    display: grid;
    gap: 0;
    /* matches the hero "worth your time" accent gradient base */
    --qs-spine: var(--accent);
    /* pending grey — identical to the un-reached (empty) star outline so the
       line follows the same colour rule as the markers it connects */
    --qs-pending: color-mix(in srgb, var(--text) 24%, transparent);
  }
  /* JS-drawn right-angle staircase linking the orbit nodes (robust to height) */
  .qs-trajectory {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 900ms var(--ease-calm) 150ms;
  }
  .qs-trajectory.in {
    opacity: 1;
  }
  .qs-trajectory path {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: opacity 250ms var(--ease-calm);
    vector-effect: non-scaling-stroke;
  }
  .qs-path-done {
    stroke: url(#qsAccentGradV);
  }
  .qs-path-next {
    stroke: var(--qs-pending);
    stroke-dasharray: 14 8;
  }
  .qs-step {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) minmax(300px, 0.86fr);
    gap: 32px;
    align-items: center;
    padding: 38px 0;
  }
  .qs-step:nth-of-type(2) {
    transition-delay: 90ms;
    /* alternate: artefact on the left, text on the right */
    grid-template-columns: 72px minmax(300px, 0.86fr) minmax(0, 1fr);
  }
  .qs-step:nth-of-type(2) .qs-text {
    order: 1;
  }
  .qs-step:nth-of-type(3) {
    transition-delay: 180ms;
  }
  .qs-rail {
    position: relative;
    align-self: stretch;
  }
  .qs-node {
    position: absolute;
    top: 50%;
    left: 4px;
    width: 64px;
    height: 64px;
    opacity: 0;
    transform: translateY(-50%);
    transition:
      opacity 460ms var(--ease-calm),
      transform 460ms var(--ease-calm);
  }
  .qs-node svg {
    position: absolute;
    inset: 0;
    width: auto;
    height: auto;
    overflow: visible;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .qs-node svg path {
    fill: none;
    stroke: var(--qs-pending);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
    transition:
      fill 250ms var(--ease-calm),
      stroke 250ms var(--ease-calm);
    shape-rendering: geometricPrecision;
    vector-effect: non-scaling-stroke;
  }
  .qs-node-num {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 900 14px/1 var(--font-display);
    color: color-mix(in srgb, var(--text) 48%, transparent);
    letter-spacing: -0.01em;
    text-rendering: geometricPrecision;
    transition: color 250ms var(--ease-calm);
  }
  .qs-step.in .qs-node {
    opacity: 1;
    transform: translateY(-50%);
    transition-delay: 240ms;
  }
  .qs-step.is-active .qs-node svg {
    animation: qs-node-pulse 1.6s ease-in-out infinite;
  }
  .qs-step.is-active .qs-node svg path {
    fill: none;
    stroke: url(#qsAccentGrad);
  }
  .qs-step.is-active .qs-node-num,
  .qs-step.is-done .qs-node-num {
    color: var(--qs-spine);
  }
  .qs-step.is-done .qs-node svg path {
    fill: url(#qsAccentGrad);
    stroke: url(#qsAccentGrad);
  }
  /* warm accent glow — only on the filled (done) stars */
  .qs-step.is-done .qs-node svg {
    filter: drop-shadow(
        0 0 5px color-mix(in srgb, var(--accent) 58%, transparent)
      )
      drop-shadow(0 0 13px color-mix(in srgb, var(--accent) 30%, transparent));
  }
  .qs-step.is-done .qs-node-num {
    color: var(--bg);
  }
  @keyframes qs-node-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.06);
    }
  }
  .qs-text {
    max-width: 460px;
  }
  .qs-text h3 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .qs-text p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    letter-spacing: -0.01em;
    color: var(--text-2);
    text-wrap: pretty;
  }
  .qs-text code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    color: var(--accent-text);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
    border-radius: var(--radius-sm);
    padding: 1px 5px;
  }
  .qs-visual {
    align-self: center;
    display: grid;
    place-items: center;
    min-width: 0;
  }

  /* Step 1 — terminal panel */
  .qs-term {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-lg);
    background: var(--bg-dark);
    box-shadow:
      0 34px 60px -22px rgba(0, 0, 0, 0.6),
      0 8px 18px -10px rgba(0, 0, 0, 0.45),
      0 0 60px -10px rgba(255, 106, 42, 0.22);
  }
  .qs-term-bar {
    display: flex;
    gap: 7px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border-dark);
  }
  .qs-term-bar span {
    width: 11px;
    height: 11px;
    border-radius: 999px;
  }
  .qs-term-bar span:nth-child(1) {
    background: #ff5f57;
  }
  .qs-term-bar span:nth-child(2) {
    background: #febc2e;
  }
  .qs-term-bar span:nth-child(3) {
    background: #28c840;
  }
  .qs-term .command-row {
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 16px;
  }

  /* Step 2 — onboarding image */
  .qs-visual-img img {
    width: min(100%, 260px);
    height: auto;
    display: block;
    opacity: 0;
    filter: drop-shadow(0 0 20px rgba(255, 106, 42, 0.14))
      drop-shadow(0 6px 10px rgba(0, 0, 0, 0.08));
    animation: qs-float 5.5s ease-in-out infinite;
    transition: opacity 720ms var(--ease-calm);
  }
  .qs-step.is-active .qs-visual-img img,
  .qs-step.is-done .qs-visual-img img {
    opacity: 1;
  }
  @keyframes qs-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }

  /* Step 3 — sample evaluation card (hero-style) */
  .qs-card {
    width: min(100%, 280px);
    border: 1px solid var(--border-dark);
    border-radius: 14px;
    padding: 16px 18px;
    background: linear-gradient(180deg, rgb(28, 28, 31), rgb(19, 19, 21));
    box-shadow:
      0 34px 60px -22px rgba(0, 0, 0, 0.6),
      0 8px 18px -10px rgba(0, 0, 0, 0.45),
      0 0 60px -10px rgba(255, 106, 42, 0.22);
    font-family: var(--font-body);
  }
  .qs-card-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .qs-card-mark {
    position: relative;
    overflow: hidden;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 7px;
    background: linear-gradient(140deg, #6f5cff, #533afd);
    color: #fff;
  }
  /* signature orange corner — same accent as the hero score-cards */
  .qs-card-mark::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-top-left-radius: 4px;
  }
  .qs-card-mark svg {
    width: 16px;
    height: 16px;
    display: block;
  }
  .qs-card-co {
    font: 600 13.5px var(--font-display);
    letter-spacing: -0.01em;
    color: var(--text-dark);
  }
  .qs-card-role {
    margin-top: 2px;
    font: 600 9.5px var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-dark-muted);
  }
  .qs-card-score {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 6px;
  }
  .qs-card-num {
    font: 600 36px var(--font-display);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--tier-high);
  }
  .qs-card-denom {
