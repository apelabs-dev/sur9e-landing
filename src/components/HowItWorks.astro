  .demo-copy p {
    max-width: 620px;
    margin: 18px auto 0;
    color: rgba(244, 244, 245, 0.68);
    font-size: 16px;
    line-height: 1.55;
  }
  /* ── flip deck — two stacked cards, one focused at a time ── */
  .demo-deck {
    max-width: 960px;
    margin: 0 auto;
  }
  .deck-tabs {
    display: flex;
    width: fit-content;
    margin: 0 auto 24px;
    gap: 4px;
    padding: 5px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .deck-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 0;
    border-radius: var(--radius-pill);
    padding: 9px 20px;
    background: transparent;
    color: rgba(244, 244, 245, 0.66);
    font: 700 13px var(--font-display);
    letter-spacing: -0.01em;
    cursor: pointer;
    transition:
      background var(--dur-quick),
      color var(--dur-quick);
  }
  .deck-tab:hover {
    color: #fff;
  }
  .deck-tab.is-active {
    background: var(--accent-cta);
    color: #fff;
  }
  .deck-tab-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.85;
  }
  .deck-stage {
    position: relative;
    height: 700px;
    /* headroom so the back card can peek above the front without
       colliding with the tabs */
    margin-top: 34px;
  }
  /* Alcove-style window frame: generous radius, a clean diffuse lift shadow
     (no glow), a hairline border + faint top highlight. Calm + polished. */
  .deck-card {
    position: absolute;
    inset: 0;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow:
      0 44px 84px -30px rgba(0, 0, 0, 0.62),
      0 14px 36px -18px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition:
      transform 460ms var(--ease-calm),
      opacity 460ms var(--ease-calm);
    will-change: transform, opacity;
  }
  /* the white report card gets a defined hairline edge — the inverted
     equivalent of the terminal's light border (same weight, dark on light) */
  .deck-card[data-deck-card='report'] {
    border-color: rgba(0, 0, 0, 0.14);
    box-shadow:
      0 44px 84px -30px rgba(0, 0, 0, 0.5),
      0 14px 36px -18px rgba(0, 0, 0, 0.35);
  }
  .deck-card.is-front {
    transform: translate(0, 0) scale(1);
    opacity: 1;
    z-index: 2;
    pointer-events: auto;
  }
  /* the back card peeks above + to the right of the front, dimmed — reads as a
     physical stack. Its exposed corner is clickable to bring it to the front. */
  .deck-card.is-back {
    transform: translate(40px, -26px) scale(0.965);
    opacity: 0.62;
    z-index: 1;
    pointer-events: auto;
    cursor: pointer;
    box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.9);
  }
  /* brighten the dark terminal's edge when it's the back card peeking against
     the dark band (the report card's own light border already reads) */
  .deck-card[data-deck-card='agent'].is-back {
    border-color: rgba(255, 255, 255, 0.3);
  }
  .deck-card > .agent-terminal {
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: inherit;
  }
  /* terminal scrolls inside the fixed-height card if the run overflows */
  .deck-card .terminal-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .report-scroll {
    height: 100%;
    overflow-y: auto;
    background: #fff;
    -webkit-overflow-scrolling: touch;
  }
  .agent-terminal,
  .local-ui {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    background: rgba(10, 10, 11, 0.76);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 36px 96px -48px rgba(0, 0, 0, 0.82);
  }
  .agent-terminal {
    min-width: 0;
    overflow: hidden;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 0;
    background: #000;
    box-shadow: 0 28px 90px -52px rgba(0, 0, 0, 0.92);
    color: rgba(255, 255, 255, 0.88);
    font-family: var(--font-mono);
  }
  .cli-topline,
  .cli-command {
    padding: 0 18px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cli-topline {
    padding-top: 14px;
    color: rgba(255, 255, 255, 0.52);
    font: 600 13px/1.4 var(--font-mono);
  }
  .cli-command {
    margin-top: 2px;
    color: #fff;
    font: 800 15px/1.5 var(--font-mono);
  }
  .cli-rule {
    height: 1px;
    margin-top: 14px;
    background: rgba(255, 255, 255, 0.11);
  }
  .terminal-body {
    min-width: 0;
    min-height: 500px;
    padding: 14px 18px 10px;
    display: grid;
    align-content: start;
    gap: 14px;
    font: 500 13px/1.38 var(--font-mono);
    cursor: text;
  }
  .cli-event {
    min-width: 0;
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: 8px;
    opacity: 0;
    transform: translateY(6px);
  }
  /* terminal auto-plays its run once when the deck scrolls into view
     (JS adds .is-seen); before that the events stay hidden */
  .demo-deck.is-seen .cli-event {
    animation: cli-event 720ms var(--ease-calm) both;
  }
  @media (prefers-reduced-motion: reduce) {
    /* instant card swaps; terminal shows its final state, no typing */
    .deck-card {
      transition: none;
    }
    .cli-event {
      opacity: 1;
      transform: none;
    }
    .demo-deck .cli-event {
      animation: none;
    }
  }
  @media (max-width: 720px) {
    .deck-stage {
      height: 72vh;
      min-height: 460px;
    }
