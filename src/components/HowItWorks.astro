  .cli-event:nth-child(1) {
    animation-delay: 0ms;
  }
  .cli-event:nth-child(2) {
    animation-delay: 620ms;
  }
  .cli-event:nth-child(3) {
    animation-delay: 1180ms;
  }
  .cli-event:nth-child(4) {
    animation-delay: 1740ms;
  }
  .cli-event:nth-child(5) {
    animation-delay: 2360ms;
  }
  .cli-event:nth-child(6) {
    animation-delay: 2980ms;
  }
  .cli-event:nth-child(7) {
    animation-delay: 3600ms;
  }
  .cli-event:nth-child(8) {
    animation-delay: 4220ms;
  }
  .cli-event:nth-child(9) {
    animation-delay: 4840ms;
  }
  .cli-event p {
