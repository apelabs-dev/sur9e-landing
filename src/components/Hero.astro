<style>
  .hero {
    /* Beauty-pass background: 3 radial orbs over a deeper dark gradient */
    background:
      radial-gradient(
        circle at 50% 26%,
        rgba(255, 106, 42, 0.22),
        transparent 18rem
      ),
      radial-gradient(
        circle at 18% 65%,
        rgba(153, 184, 132, 0.15),
        transparent 18rem
      ),
      radial-gradient(
        circle at 82% 68%,
        rgba(255, 154, 98, 0.13),
        transparent 17rem
      ),
      linear-gradient(180deg, #080808 0%, #12100e 52%, #201610 100%);
    color: var(--text-dark);
    padding: 112px 24px 92px;
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    --mx: 50%;
    --my: 50%;
    --ha: 0;
  }
  /* Crossed-line grid texture, masked to fade at edges */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.024) 1px, transparent 1px);
    background-size: 58px 58px;
    -webkit-mask-image: radial-gradient(
      circle at 50% 44%,
      #000 0 38%,
      transparent 74%
    );
    mask-image: radial-gradient(circle at 50% 44%, #000 0 38%, transparent 74%);
  }
  .hero-bridge {
    height: 110px;
    background: linear-gradient(
      180deg,
      #201610 0%,
      #5b3c26 26%,
      #cfb99b 70%,
      var(--bg) 100%
    );
    pointer-events: none;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      420px 320px at var(--mx) var(--my),
      rgba(255, 120, 50, 0.55),
      rgba(255, 90, 31, 0.18) 35%,
      transparent 65%
    );
    pointer-events: none;
    mix-blend-mode: screen;
    opacity: var(--ha);
    transition: opacity 320ms ease;
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 200px);
    z-index: 3;
  }

  /* Funnel stats — typical year of applying numerals */
  .funnel-stats {
    margin: 0 auto 24px;
    max-width: 640px;
    text-align: center;
  }
  .funnel-stats .fs-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dark-muted);
    margin: 0 0 14px;
  }
  .funnel-stats .fs-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    justify-items: stretch;
    gap: 8px;
  }
  .funnel-stats .fs-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .funnel-stats .fs-num {
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter: drop-shadow(0 10px 28px rgba(0, 0, 0, 0.45));
  }
  .funnel-stats .fs-zero-cell {
    position: relative;
  }
  .funnel-stats .fs-zero-wrap {
    display: block;
    filter: drop-shadow(0 10px 28px rgba(0, 0, 0, 0.45));
  }
  .funnel-stats .fs-zero-svg {
    display: block;
    width: clamp(44px, 5vw, 64px);
    height: auto;
    margin: 0 auto;
    overflow: visible;
  }
  .funnel-stats .fs-zero-svg text {
    font-family: var(--font-display);
    font-size: 60px;
    font-weight: 700;
    letter-spacing: -0.045em;
    fill: url('#offerZeroGradient');
  }
  /* Solid overlay zero — sits on top of the shard pieces so their seams never
     show; the 0 reads as one whole glyph until the strike, then it vanishes to
     reveal the shards as they crack and fall. */
  .funnel-stats .zero-solid {
    transition: opacity 60ms linear;
  }
  .funnel-stats.is-cracked .zero-solid {
    opacity: 0;
    transition: opacity 60ms linear 170ms;
  }
  .funnel-stats .zero-shard {
    transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }
  .funnel-stats .zero-crack {
    fill: none;
    stroke: var(--beauty-ember-2);
    stroke-linejoin: miter;
    opacity: 0;
  }
  .funnel-stats .crack-main {
    stroke-width: 1.2;
    stroke-dasharray: 130;
    stroke-dashoffset: 130;
  }
  .funnel-stats .crack-b {
    stroke-width: 0.9;
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
  }
  .funnel-stats.is-cracked .crack-main {
    animation: crack-draw 200ms cubic-bezier(0.4, 0, 1, 1) forwards;
  }
  .funnel-stats.is-cracked .crack-b1 {
    animation: crack-draw 130ms cubic-bezier(0.4, 0, 1, 1) 150ms forwards;
  }
  .funnel-stats.is-cracked .crack-b2 {
    animation: crack-draw 140ms cubic-bezier(0.4, 0, 1, 1) 210ms forwards;
  }
  .funnel-stats.is-cracked .crack-b3 {
    animation: crack-draw 100ms cubic-bezier(0.4, 0, 1, 1) 110ms forwards;
  }
  .funnel-stats.is-cracked .shard-tl {
    transform: translate(-2.4px, -0.8px) rotate(-1.3deg);
    transition-delay: 230ms;
  }
  .funnel-stats.is-cracked .shard-tr {
    transform: translate(2.6px, 0.5px) rotate(1.5deg);
    transition-delay: 250ms;
  }
  .funnel-stats.is-cracked .shard-mr {
    transform: translate(3.6px, 1.8px) rotate(2.1deg);
    transition-delay: 280ms;
  }
  .funnel-stats.is-cracked .shard-bl {
    transform: translate(-1.8px, 1.3px) rotate(-0.9deg);
    transition-delay: 260ms;
  }
  .funnel-stats.is-cracked .shard-br {
    animation: zero-shard-fall 760ms cubic-bezier(0.35, 0, 0.9, 0.6) 330ms
      forwards;
  }
  .funnel-stats.is-cracked .fs-zero-svg {
    animation: zero-tremor 240ms linear 170ms;
  }
  .funnel-stats.is-cracked .fs-zero-svg text {
    animation: zero-impact-flash 360ms cubic-bezier(0.22, 0.61, 0.36, 1) 180ms;
  }
  .funnel-stats.is-settled .zero-crack {
    stroke: #3a3a3f;
    transition: stroke 800ms ease 100ms;
  }
  .funnel-stats .zero-debris {
    fill: #5a5a62;
    opacity: 0;
  }
  .funnel-stats.is-cracked .debris-1 {
    animation: zero-debris-fall 560ms cubic-bezier(0.35, 0, 0.9, 0.6) 300ms
      forwards;
  }
  .funnel-stats.is-cracked .debris-2 {
    animation: zero-debris-fall 700ms cubic-bezier(0.35, 0, 0.9, 0.6) 360ms
      forwards;
  }
  .funnel-stats.is-cracked .debris-3 {
    animation: zero-debris-fall 480ms cubic-bezier(0.35, 0, 0.9, 0.6) 410ms
      forwards;
  }
  @keyframes crack-draw {
    0% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      stroke-dashoffset: 0;
    }
  }
  @keyframes zero-shard-fall {
    0% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 1;
    }
    55% {
      opacity: 1;
    }
    100% {
      transform: translate(5px, 20px) rotate(10deg);
      opacity: 0;
    }
  }
  @keyframes zero-debris-fall {
    0% {
      opacity: 0.9;
      transform: translate(0, 0);
    }
    100% {
      opacity: 0;
      transform: translate(2px, 16px);
    }
  }
  @keyframes zero-impact-flash {
    30% {
      fill: #d6d6dd;
    }
    100% {
      fill: url('#offerZeroGradient');
    }
  }
  @keyframes zero-tremor {
    0%,
    100% {
      transform: translate(0, 0);
    }
    20% {
      transform: translate(-1px, 0.3px);
    }
    45% {
      transform: translate(0.9px, -0.2px);
    }
    70% {
      transform: translate(-0.5px, 0.2px);
    }
  }
  .funnel-stats .fs-lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-dark-muted);
  }
  .funnel-stats .s-low {
    background-image: linear-gradient(
      180deg,
      color-mix(in srgb, var(--tier-low) 55%, white) 0%,
      var(--tier-low) 50%,
      color-mix(in srgb, var(--tier-low) 40%, black) 100%
    );
  }
  .funnel-stats .s-mid {
    background-image: linear-gradient(
      180deg,
      color-mix(in srgb, var(--tier-mid) 55%, white) 0%,
      var(--tier-mid) 50%,
      color-mix(in srgb, var(--tier-mid) 40%, black) 100%
    );
  }
  .funnel-stats .s-high {
    background-image: linear-gradient(
      180deg,
      color-mix(in srgb, var(--tier-high) 55%, white) 0%,
      var(--tier-high) 50%,
      color-mix(in srgb, var(--tier-high) 40%, black) 100%
    );
  }
  .funnel-stats .fs-drop {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dark-faint);
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    gap: 6px;
    padding-top: 22px;
    white-space: nowrap;
  }
  .funnel-stats .fs-arrow {
    color: var(--text-dark-faint);
    font-size: 14px;
  }
  .funnel-stats .fs-bars {
    display: grid;
    grid-template-columns: 100fr 7fr 1fr;
    gap: 6px;
    margin-top: 18px;
    height: 6px;
  }
  .funnel-stats .fs-bar {
    display: block;
    border-radius: 3px;
    height: 100%;
  }
  .funnel-stats .fs-bar.b1 {
    background: var(--tier-low);
    opacity: 0.85;
  }
  .funnel-stats .fs-bar.b2 {
    background: var(--tier-mid);
    opacity: 0.85;
  }
  .funnel-stats .fs-bar.b3 {
    background: var(--tier-high);
    opacity: 0.95;
  }
  .funnel-stats .fs-line {
    font-family: var(--font-body);
    font-size: 18px;
    letter-spacing: -0.01em;
    margin: 14px 0 0;
    font-style: italic;
    font-weight: 500;
    text-wrap: balance;
    background-image: linear-gradient(
      90deg,
      color-mix(in srgb, var(--tier-low) 60%, white) 0%,
      var(--tier-low) 50%,
      color-mix(in srgb, var(--tier-low) 45%, black) 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--tier-low);
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.35));
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 600ms var(--ease-calm),
      transform 600ms var(--ease-calm);
  }
  .funnel-stats.is-cracked .fs-line {
    opacity: 1;
    transform: translateY(0);
  }
  @media (max-width: 720px) {
    .funnel-stats {
      margin-bottom: 26px;
      padding: 16px 14px 14px;
    }
    .funnel-stats .fs-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      justify-content: stretch;
      gap: 8px;
    }
    .funnel-stats .fs-cell {
      gap: 5px;
    }
    .funnel-stats .fs-num {
      letter-spacing: -0.05em;
    }
    .funnel-stats .fs-zero-svg {
      width: 30px;
    }
