<script>
  import { setupCardPhysics } from '../scripts/card-physics.js';

  (function () {
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const reduceMotion = () => motionQuery.matches;
    const scrollBehavior = () => (reduceMotion() ? 'auto' : 'smooth');

    // Hero spotlight follows cursor — skip entirely for reduced-motion users
    const hero = document.querySelector('.hero');
    if (hero instanceof HTMLElement && !reduceMotion()) {
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        const x = ((e.clientX - r.left) / r.width) * 100;
        const y = ((e.clientY - r.top) / r.height) * 100;
        hero.style.setProperty('--mx', x + '%');
        hero.style.setProperty('--my', y + '%');
        hero.style.setProperty('--ha', '1');
      });
      hero.addEventListener('pointerleave', () => {
        hero.style.setProperty('--ha', '0');
      });
    }

    // Speed-tiered count-up for hero funnel stats
    const FUNNEL_SPEEDS = { fast: 700, mid: 1150, slow: 1550 };
    function crackFunnel(panel) {
      if (!(panel instanceof HTMLElement)) return;
      panel.classList.add('is-cracked');
      if (reduceMotion()) {
        panel.classList.add('is-settled');
        return;
      }
      setTimeout(() => panel.classList.add('is-settled'), 1000);
    }

    function funnelCountUp(el, target, dur, done) {
      if (reduceMotion()) {
        el.textContent = String(target);
        if (done) done();
        return;
      }
      const start = performance.now();
      function tick(now) {
        const t = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = String(Math.round(target * eased));
        if (t < 1) {
          requestAnimationFrame(tick);
          return;
        }
        if (done) done();
      }
      requestAnimationFrame(tick);
    }
    const funnelObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            en.target.querySelectorAll('.fs-num').forEach((el) => {
              if (!(el instanceof HTMLElement)) return;
              const target = parseInt(el.dataset.target || '0', 10);
              const dur = FUNNEL_SPEEDS[el.dataset.speed] || 1400;
              funnelCountUp(el, target, dur, () => {
                if (target !== 4) return;
                const delay = reduceMotion() ? 0 : 90;
                setTimeout(() => crackFunnel(en.target), delay);
              });
            });
            funnelObserver.unobserve(en.target);
          }
        });
      },
      { threshold: 0.3 },
    );
    const funnelRow = document.querySelector('.funnel-stats');
    if (funnelRow) funnelObserver.observe(funnelRow);

    // Magnetic primary CTA — gentle pull toward cursor (skip for reduced motion)
    if (!reduceMotion()) {
      document
        .querySelectorAll('.cta-primary, .btn-primary, .waitlist-form button')
        .forEach((btn) => {
          if (!(btn instanceof HTMLElement)) return;
          btn.addEventListener('pointermove', (e) => {
            const r = btn.getBoundingClientRect();
            const dx = (e.clientX - r.left - r.width / 2) / r.width;
            const dy = (e.clientY - r.top - r.height / 2) / r.height;
            btn.style.transform = `translate(${dx * 6}px, ${dy * 6}px) translateY(-2px)`;
          });
          btn.addEventListener('pointerleave', () => {
            btn.style.transform = '';
          });
        });
    }

    // Smooth scroll for in-page anchors — respects prefers-reduced-motion
    document.querySelectorAll('a[href^="#"]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = a.getAttribute('href');
        if (id && id.length > 1) {
          const target = document.querySelector(id);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({
              behavior: scrollBehavior(),
              block: 'start',
            });
          }
        }
      });
    });

    // Stagger reveal delays managed elsewhere stay where they are; only hero-local ones go here.

    setupCardPhysics();
  })();
</script>
