---
import FeatureShotOutreach from './FeatureShotOutreach.astro';
import FeatureShotPipeline from './FeatureShotPipeline.astro';
import FeatureShotPrep from './FeatureShotPrep.astro';
import FeatureShotReport from './FeatureShotReport.astro';
---

<section class="features" id="features">
  <div class="wrap">
    <div class="section-head features-head reveal">
      <span class="eyebrow">Not another job search tool</span>
      <h2>
        Other tools fix resumes.<br /><span class="accent"
          >Sur9e scores the job.</span
        >
      </h2>
      <p>
        Keyword matchers check if a resume fits a JD. Sur9e checks if the role
        is worth the time — against career history, goals, and dealbreakers.
      </p>
    </div>

    <div class="feature-list">
      <!-- F1: Evaluate -->
      <article class="feature reveal tier-low">
        <div class="feature-copy">
          <div class="feature-icon g1" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 14 16 10"></path><path
                d="M3.34 19a10 10 0 1 1 17.32 0"></path></svg
            >
          </div>
          <h3>Reasoning you can read, <em>not a match percentage</em></h3>
          <p>
            Every role scored across <span class="accent"
              >10 weighted dimensions</span
            > against the CV, projects, and career signals. Full reasoning for why
            it fits — or doesn't. Not "78% match."
          </p>
          <div class="tag-row">
            <span class="pill">10 dimensions</span>
            <span class="pill">Comp analysis</span>
            <span class="pill">Dealbreaker flags</span>
            <span class="pill">Archetype detection</span>
          </div>
        </div>
        <div class="feature-shot">
          <FeatureShotReport />
        </div>
      </article>

      <!-- F2: Connect -->
      <article class="feature flip reveal tier-mid">
        <div class="feature-copy">
          <div class="feature-icon g2" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="10" cy="7" r="4"></circle><path
                d="M10.3 15H7a4 4 0 0 0-4 4v2"></path><circle
                cx="17"
                cy="17"
                r="3"></circle><path d="m21 21-1.9-1.9"></path></svg
            >
          </div>
          <h3>Find <em>the person</em> behind the posting</h3>
          <p>
            Every open role gets buried under <span
              style="color: var(--score-low)">400+</span
            > resumes nobody reads. Sur9e skips the pile — finds the hiring manager
            and drafts the warm intro, grounded in real experience, not a template.
          </p>
          <div class="tag-row">
            <span class="pill">HM discovery</span>
            <span class="pill">LinkedIn outreach</span>
            <span class="pill">Warm-path messaging</span>
          </div>
        </div>
        <div class="feature-shot">
          <FeatureShotOutreach />
        </div>
      </article>

      <!-- F3: Track -->
      <article class="feature reveal tier-high">
        <div class="feature-copy">
          <div class="feature-icon g3" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect width="18" height="18" x="3" y="3" rx="2"></rect><path
                d="M8 7v7"></path><path d="M12 7v4"></path><path d="M16 7v9"
              ></path></svg
            >
          </div>
          <h3>Score from <em>any job page</em>. Track everything.</h3>
          <p>
            Chrome extension scores roles on LinkedIn, Greenhouse, Lever,
            Indeed. Every score flows into the pipeline. Kanban tracker,
            follow-up alerts, rejection-pattern detection. <span class="accent"
              >No spreadsheets.</span
            >
          </p>
          <div class="tag-row">
            <span class="pill">Chrome extension</span>
            <span class="pill">Pipeline inbox</span>
            <span class="pill">Kanban tracker</span>
            <span class="pill">Follow-ups</span>
          </div>
        </div>
        <div class="feature-shot">
          <FeatureShotPipeline />
        </div>
      </article>

      <!-- F4: Prep -->
      <article class="feature flip reveal tier-accent">
        <div class="feature-copy">
          <div class="feature-icon g4" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 21V7"></path><path d="m16 12 2 2 4-4"></path><path
                d="M22 6V4a1 1 0 0 0-1-1h-5a4 4 0 0 0-4 4 4 4 0 0 0-4-4H3a1 1 0 0 0-1 1v13a1 1 0 0 0 1 1h6a3 3 0 0 1 3 3 3 3 0 0 1 3-3h6a1 1 0 0 0 1-1v-1.3"
              ></path></svg
            >
          </div>
          <h3>Walk in <em>ready</em>, not nervous</h3>
          <p>
            Custom cheat sheets for every interview round — technical,
            behavioral, hiring manager. Built against real projects, the
            company's interview loop, and a personal story bank. <span
              class="accent">The competitors don't go this deep.</span
            >
          </p>
          <div class="tag-row">
            <span class="pill">Interview prep</span>
            <span class="pill">STAR stories</span>
            <span class="pill">Company research</span>
            <span class="pill">Rejection patterns</span>
          </div>
        </div>
        <div class="feature-shot">
          <FeatureShotPrep />
        </div>
      </article>
    </div>
  </div>
</section>

<style is:global>
  /* =====================================================================
   Shared feature-shot frame — used by all 4 FeatureShot* components
===================================================================== */
  .shot {
    background: var(--bg-paper);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow:
      0 24px 48px -24px rgba(31, 29, 26, 0.18),
      0 2px 4px rgba(31, 29, 26, 0.03);
    overflow: hidden;
    font-family: var(--font-body);
    color: var(--text);
    position: relative;
  }
  .shot-chrome {
    height: 32px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 12px;
    min-width: 0;
    overflow: hidden;
  }
  .shot-chrome .d {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border-strong);
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.12);
    flex-shrink: 0;
  }
  .shot-chrome .d:nth-child(1) {
    background: #c44a3f;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.2);
  }
  .shot-chrome .d:nth-child(2) {
    background: #c08a2a;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.2);
  }
  .shot-chrome .d:nth-child(3) {
    background: #2e8a44;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.2);
  }
  .shot-chrome .crumbs {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
    margin-left: 12px;
    min-width: 0;
    flex: 1 1 auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* =====================================================================
   Mobile-only feature shots
   The desktop renders pack too much detail for a 375 px column. Below
   720 px we hide them and show purpose-built mobile variants instead.
===================================================================== */
  .shot-m {
    display: none;
  }
  /* Mobile demo also takes over at tablet widths — desktop demo only at ≥1025 px */
  /* Shared mobile shot styling — matches the desktop chrome + card system */
  .shot-m {
    background: var(--bg-paper);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    font-family: var(--font-body);
    color: var(--text);
    box-shadow:
      0 18px 36px -22px rgba(31, 29, 26, 0.18),
      0 2px 4px rgba(31, 29, 26, 0.03);
  }
  .shot-m .shot-chrome {
    height: 30px;
  }
  .shot-m-body {
    padding: 18px 16px 20px;
  }
  .shot-m-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .shot-m h4 {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .shot-m .role,
  .shot-m .meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin: 2px 0 0;
  }
  .shot-m .mark {
    width: 40px;
    height: 40px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.02em;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }
  .shot-m .mark::after {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: 9px;
    height: 9px;
    background: var(--accent);
    border-top-left-radius: 5px;
  }
  .shot-m-score {
    display: inline-flex;
    align-items: flex-start;
    gap: 2px;
    margin-left: auto;
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--score-high);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .shot-m-score .num {
    font-size: 36px;
  }
  .shot-m-score .denom {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-top: 6px;
    letter-spacing: 0;
  }
  .shot-m-segbar {
    display: flex;
    gap: 3px;
    margin-top: 8px;
  }
  .shot-m-segbar .seg {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: var(--surface-2);
  }
  .shot-m-segbar .seg.on {
    background: var(--score-high);
  }
  .shot-m-lede {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-2);
    margin: 14px 0 0;
  }
  .shot-m-divider {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 14px 0;
  }
  .shot-m-dims {
    display: grid;
    gap: 8px;
  }
  .shot-m-dim {
    display: grid;
    grid-template-columns: 80px 1fr 28px;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: var(--text-2);
  }
  .shot-m-dim .bar {
    height: 4px;
    background: var(--surface-2);
    border-radius: 2px;
    overflow: hidden;
  }
  .shot-m-dim .bar span {
    display: block;
    height: 100%;
    background: var(--score-high);
    border-radius: 2px;
  }
  .shot-m-dim.warn .bar span {
    background: var(--score-mid);
  }
  .shot-m-dim .v {
    font-family: var(--font-mono);
    text-align: right;
    color: var(--text);
    font-weight: 500;
  }
  .shot-m-dim.warn .v {
    color: var(--score-mid);
  }
  /* Funnel chips for pipeline shot */
  .shot-m-funnel {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    padding: 14px 12px;
    background: color-mix(in srgb, var(--bg-paper) 96%, var(--text-muted) 4%);
    border-radius: 8px;
    border: 1px solid var(--border);
  }
  .shot-m-fstep {
    text-align: center;
  }
  .shot-m-fstep .d {
    /* Always render the dot as its own block above the label so all 4
     funnel cells align identically. Inline-block wrapped inconsistently:
     long labels (APPLIED, RESPONDED, INTERVIEW) pushed the dot to its
     own row; short labels (OFFER) kept it inline. */
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin: 0 auto 5px;
  }
  .shot-m-fstep .lbl {
    display: block;
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .shot-m-fstep .v {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    color: var(--text);
  }
  .shot-m-fstep .c {
    display: block;
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin-top: 2px;
  }
  /* Sample pipeline rows */
  .shot-m-pcards {
    display: grid;
    gap: 8px;
    margin-top: 12px;
  }
  .shot-m-pcard {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 12px;
    padding: 10px 12px;
    background: var(--bg-paper);
    border: 1px solid var(--border);
    border-radius: 8px;
    align-items: center;
  }
  .shot-m-pcard .co {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
  }
  .shot-m-pcard .ro {
    font-size: 12px;
    color: var(--text-2);
    grid-row: 2;
  }
  .shot-m-pcard .sc {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    color: var(--score-high);
  }
  .shot-m-pcard .pmeta {
    grid-column: 1;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .shot-m-pcard .pstatus {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-2);
    padding: 3px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-paper) 92%, var(--text-muted) 8%);
    border: 1px solid var(--border);
    white-space: nowrap;
    justify-self: end;
  }
  .shot-m-pcard .pstatus .d {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  /* Prep metric tiles */
  .shot-m-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 14px;
  }
  .shot-m-stat {
    background: color-mix(in srgb, var(--bg-paper) 96%, var(--text-muted) 4%);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 6px;
    text-align: center;
  }
  .shot-m-stat .v {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    color: var(--text);
    line-height: 1.1;
  }
  .shot-m-stat .lbl {
    display: block;
    font-family: var(--font-mono);
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-top: 4px;
  }
  .shot-m-rounds {
    display: grid;
    gap: 6px;
    margin-top: 14px;
  }
  .shot-m-round {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    gap: 10px;
    padding: 10px 12px;
    background: var(--bg-paper);
    border: 1px solid var(--border);
    border-radius: 8px;
    align-items: center;
  }
  .shot-m-round .tag {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 14%, var(--bg-paper));
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 12px;
  }
  .shot-m-round .label {
    font-size: 12.5px;
    color: var(--text);
    line-height: 1.35;
  }
  .shot-m-round .ct {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-align: right;
  }
  .shot-m-star {
    margin: 6px 0 0 14px;
    padding: 10px 12px;
    background: color-mix(in srgb, var(--bg-paper) 96%, var(--text-muted) 4%);
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: 6px;
  }
  .shot-m-star-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .shot-m-star p {
    margin: 6px 0 0;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--text-2);
  }
  .shot-m-star b {
    color: var(--text);
    font-weight: 600;
  }
  /* Outreach-specific mobile bits */
  .shot-m-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #3d5dab, #7a9fd4);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    flex-shrink: 0;
  }
  .shot-m-verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--score-high);
    padding: 3px 8px 3px 4px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--score-high) 12%, transparent);
    margin-left: auto;
  }
  .shot-m-verified::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--score-high);
    display: inline-block;
  }
  .shot-m-tabs {
    display: flex;
    gap: 14px;
    padding: 12px 0 0;
    font-size: 11.5px;
    border-top: 1px solid var(--border);
    margin-top: 12px;
  }
  .shot-m-tabs span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 10px;
  }
  .shot-m-tabs .active {
    color: var(--accent-text);
    position: relative;
    padding-bottom: 8px;
    border-bottom: 1.5px solid var(--accent);
    margin-bottom: -1px;
  }
  .shot-m-draft {
    margin-top: 12px;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .shot-m-draft p {
    margin: 0 0 8px;
  }
  .shot-m-draft .hl {
    color: var(--text);
    font-weight: 600;
  }
  .shot-m-actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .shot-m-actions .btn-send,
  .shot-m-actions .btn-ghost {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 8px;
  }
  .shot-m-actions .btn-send {
    background: var(--accent-cta);
    color: #fff;
  }
  .shot-m-actions .btn-ghost {
    background: transparent;
    color: var(--text-2);
    border: 1px solid var(--border);
  }

  /* Stagger reveal delay for feature cards */
  .feature.reveal.in {
    transition-delay: var(--rd, 0ms);
  }

  /* =====================================================================
   Section 3: Feature Teasers (light)
===================================================================== */
  .features {
    padding: 96px 24px;
    background:
      radial-gradient(
        circle at 8% 10%,
        rgba(255, 90, 31, 0.08),
        transparent 18rem
      ),
      radial-gradient(
        circle at 90% 24%,
        rgba(153, 184, 132, 0.12),
        transparent 20rem
      ),
      var(--bg);
    border-top: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  .features::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(
      to right,
      rgba(31, 29, 26, 0.045) 1px,
      transparent 1px
    );
    background-size: 64px 100%;
    background-position: 24px 0;
    opacity: 1;
    z-index: 0;
  }
  .features-head h2 {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin: 0 0 14px;
    text-wrap: balance;
  }
  .features-head h2 .accent {
    color: var(--accent);
  }
  .features-head p {
    font-size: 17px;
    color: var(--text-3);
    line-height: 1.55;
    max-width: 620px;
    margin: 0 auto;
    text-wrap: pretty;
  }
  .features-head {
    text-align: center;
    margin-bottom: 24px;
    padding-bottom: 64px;
  }
  .features-head h2 {
    margin-left: auto;
    margin-right: auto;
    max-width: 880px;
  }
  .features-head p {
    margin-left: auto;
    margin-right: auto;
    max-width: 620px;
  }

  /* === Features — editorial numbered slabs === */
  .feature-list {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
    counter-reset: feat;
    border-top: 1px solid var(--border);
  }
  .feature {
    counter-increment: feat;
    position: relative;
    display: grid;
    grid-template-columns: 96px minmax(0, 0.82fr) minmax(0, 1.18fr);
    column-gap: 48px;
    row-gap: 28px;
    align-items: start;
    padding: 88px 0 96px;
    border-bottom: 1px solid var(--border);
  }
  .feature::before {
    content: '0' counter(feat);
    grid-column: 1;
    grid-row: 1 / span 3;
    font-family: var(--font-mono);
