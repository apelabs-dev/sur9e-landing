---
// SECTION 05 · "FAQ" — BRIGHT accordion beat (cream). Same token family +
// paper texture as §4 Backstory, but the texture is a single-column accordion
// (native <details name="faq"> → exclusive open, zero-JS, full a11y) instead of
// a card grid — that contrast carries the bright-section rhythm. Copy is
// canonical here (copy-FINAL §5).

const faqs = [
  {
    q: 'What does it cost?',
    a: 'Sur9e is free. <code>MIT</code> license. You pay your AI provider, nothing else; Sur9e adds <code>$0</code> on top. Screening runs on cheap models on purpose: a screen costs a few cents, and a deep evaluation usually lands well under a dollar. Sur9e shows an estimate before each run and tracks spend per mode in analytics.',
  },
  {
    q: 'Does my CV leave my machine?',
    a: 'Your data lives in plain files on your disk: gitignored, no servers, no telemetry, no accounts. The only third party that ever sees it is the AI provider you already chose, when your agent evaluates a role.',
  },
  {
    q: 'Does it auto-apply for me?',
    a: "Never. That's a product principle, not a missing feature. Sur9e drafts, tailors, fills, and preps, and always stops before Submit. PRs that automate that last step get rejected.",
  },
  {
    q: 'What do I need to run it?',
    a: '<code>Node 20+</code>, Git, and one AI coding CLI: Claude Code, Codex, or OpenCode. <code>Python 3.10+</code> for the job scanner; setup installs it on macOS. One install command, then your agent walks you through the rest.',
  },
  {
    q: 'Do I have to be a developer?',
    a: 'Light technical comfort helps today. If you can install a CLI and hold a chat, the agent does the rest. It was built to be talked to, not configured.',
  },
  {
    q: 'Is the LinkedIn scanning okay?',
    a: "It fetches public job listings, on your machine, with no LinkedIn account, powered by JobSpy. Platform terms are your responsibility, so read the legal disclaimer before you turn it on. We won't pretend a FAQ entry overrides anyone's terms of service.",
  },
  {
    q: 'Which models does it use?',
    a: 'Whatever your agent supports. Sur9e ships recommended defaults per mode: cheap models for screening, capable ones for deep evaluations. Override any of it in Settings.',
  },
  {
    q: 'How is this related to career-ops?',
    a: "Sur9e was inspired by career-ops. It's credited in the README and the LICENSE. It took the core idea in its own direction: a local web UI over the same files, more than one AI agent, and a cheap screening pass before every deep evaluation.",
  },
];

// schema.org FAQPage — built from the same source, tags stripped for plain text
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: a.replace(/<[^>]+>/g, ''),
    },
  })),
};
---

<section class="faq" id="faq" aria-labelledby="faq-heading">
  <div class="faq-paper" aria-hidden="true"></div>

  <div class="faq-inner">
    <div class="section-head reveal">
      <span class="eyebrow">04 · FAQ</span>
      <h2 id="faq-heading">Before you install.</h2>
    </div>

    <div class="faq-list">
      {
        faqs.map((f, i) => (
          <details
            class="faq-row reveal"
            name="faq"
            open={i === 0}
            style={`--i:${i}`}
          >
            <summary class="faq-q">
              <span class="faq-star" aria-hidden="true" />
              <span class="faq-qt">{f.q}</span>
            </summary>
            <div class="faq-a">
              <p set:html={f.a} />
            </div>
          </details>
        ))
      }
    </div>

    <p class="faq-foot">
      Still have a question?
      <a href="mailto:hello@sur9e.com">→ hello@sur9e.com</a>
    </p>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  /* ── Full-width bright beat — same cream paper texture as §4 ── */
  .faq {
    position: relative;
    overflow: hidden;
    padding: 96px 24px 104px;
    /* flat cream — no colored side glow, so it blends seamlessly with the
       bright §4 above (the paper texture below is the only treatment) */
    background: var(--bg);
    color: var(--text);
  }
  .faq-paper {
    position: absolute;
    inset: 0 0 auto;
    height: 54%;
    pointer-events: none;
    background:
      radial-gradient(rgba(31, 29, 26, 0.055) 1px, transparent 1.4px),
      linear-gradient(90deg, rgba(255, 90, 31, 0.05) 1px, transparent 1px),
      linear-gradient(rgba(17, 17, 17, 0.035) 1px, transparent 1px);
    background-size:
      24px 24px,
      96px 96px,
      96px 96px;
    -webkit-mask-image: linear-gradient(#000 0%, transparent 92%);
    mask-image: linear-gradient(#000 0%, transparent 92%);
  }
  .faq-inner {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto;
  }
  .faq-inner .section-head {
    margin-bottom: 48px;
  }

  /* ── Accordion ── */
  .faq-list {
    border-top: 1px solid var(--rule);
  }
  .faq-row {
    border-bottom: 1px solid var(--rule);
  }

  /* summary row = star + fixed-width coord + question */
  .faq-q {
    display: flex;
    align-items: baseline;
    gap: 16px;
    min-height: 44px;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-q:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* outlined ✧ → filled ✦, rotates + brightens on open (pure [open] CSS) */
  .faq-star {
    flex: 0 0 auto;
    align-self: center;
    width: 24px;
    text-align: center;
    transition:
      transform 0.2s var(--ease-soft),
      color 0.2s var(--ease-soft);
  }
  .faq-star::before {
    content: '✧';
    font-size: 21px;
    color: var(--text-3);
  }
  .faq-row[open] .faq-star {
    transform: rotate(72deg);
  }
  .faq-row[open] .faq-star::before {
    content: '✦';
    color: var(--accent);
  }

  .faq-qt {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.012em;
    color: var(--text);
    line-height: 1.35;
  }
  .faq-row[open] .faq-qt {
    color: var(--accent-cta);
  }

  /* answer — indented under the question (past star + gap), fades in on open */
  .faq-a {
    padding: 0 4px 24px calc(24px + 16px);
  }
  .faq-a p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 16px;
    line-height: 1.62;
    color: var(--text-3);
    text-wrap: pretty;
  }
  .faq-row[open] .faq-a {
    animation: faqIn 0.2s var(--ease-soft) both;
  }
  @keyframes faqIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* inline mono chips (costs, license, runtime versions). The answer HTML is
     injected via set:html, so the <code> has no scoped attr — :global() lets
     this scoped rule reach it (still confined to .faq-a). */
  .faq-a :global(code) {
    font: 600 12.5px var(--font-mono);
    color: var(--accent-cta);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-sm);
    padding: 1px 6px;
    white-space: nowrap;
  }

  /* ── Footer line — slim, must not compete with the §6 install CTA ── */
  .faq-foot {
    margin: 28px 0 0;
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--text-3);
    text-align: center;
  }
  .faq-foot a {
    color: var(--accent-cta);
    font-weight: 600;
    white-space: nowrap;
  }
  .faq-foot a:hover {
    text-decoration: underline;
  }

  /* ── Responsive ── */
  @media (max-width: 720px) {
    .faq {
      padding: 60px 16px 72px;
    }
    .faq-q {
      gap: 12px;
      padding: 18px 2px;
    }
    .faq-qt {
      font-size: 17px;
    }
    .faq-a {
      padding-left: calc(24px + 12px);
    }
    .faq-a p {
      font-size: 15px;
    }
  }

  /* ── Reduced motion: instant toggle, native <details> intact ── */
  @media (prefers-reduced-motion: reduce) {
    .faq-star {
      transition: none;
    }
    .faq-row[open] .faq-a {
      animation: none;
    }
  }
</style>
