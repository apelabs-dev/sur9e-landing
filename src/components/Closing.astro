---
// SECTION 06 · "Closing" (dark) — the void, bookending the hero. A dashed ember
// trajectory arrives from off-screen and draws to a single bright waypoint star
// ("destination reached"), over the recolored §3 starfield. Below: the eyebrow,
// H2, the install-command box (primary CTA), a ghost GitHub button, the subscribe
// field (→ the subscribe Worker), and the micro-proof row. Copy is canonical.

const installCommand = 'bash -c "$(curl -fsSL https://sur9e.com/install)"';
const repoUrl = 'https://github.com/apelabs-dev/sur9e';
---

<section
  class="closing"
  id="install"
  data-closing
  aria-labelledby="closing-heading"
>
  <canvas class="cl-stars" data-starfield aria-hidden="true"></canvas>

  <div class="cl-inner">
    {
      /* destination comet — gradient trail arrives + draws to a bright sparkle */
    }
    <div class="cl-sky" aria-hidden="true">
      <svg class="cl-route" viewBox="0 0 600 300" preserveAspectRatio="none">
        <defs>
          <linearGradient
            id="clTrail"
            gradientUnits="userSpaceOnUse"
            x1="84"
            y1="-16"
            x2="300"
            y2="250"
          >
            <stop offset="0" stop-color="#ff6a2a" stop-opacity="0"></stop>
            <stop offset="0.5" stop-color="#ff6a2a" stop-opacity="0.4"></stop>
            <stop offset="0.86" stop-color="#ff8a4a" stop-opacity="0.95"></stop>
            <stop offset="1" stop-color="#fff1e4" stop-opacity="1"></stop>
          </linearGradient>
        </defs>
        <path class="cl-route-bg" d="M84,-16 C 210,40 250,150 300,250"></path>
        <path
          class="cl-route-draw"
          data-route
          d="M84,-16 C 210,40 250,150 300,250"></path>
      </svg>
      <span class="cl-star" data-star>
        <span class="cl-star-core"></span>
        <span class="cl-flare cl-flare-h"></span>
        <span class="cl-flare cl-flare-v"></span>
        <span class="cl-flare cl-flare-d1"></span>
        <span class="cl-flare cl-flare-d2"></span>
      </span>
    </div>

    <span class="cl-eyebrow">Install</span>
    <h2 id="closing-heading" class="cl-h2">
      One command, and your agent starts hunting with you.
    </h2>

    {/* install command box — primary CTA */}
    <div class="cl-cmd">
      <code class="cl-cmd-text">{installCommand}</code>
      <button
        type="button"
        class="cl-copy"
        data-copy-button
        data-copy-value={installCommand}
        data-copied-label="Copied!"
        aria-label="Copy install command"
      >
        <span class="cl-copy-ic cl-copy-ic--copy" aria-hidden="true">⧉</span>
        <span class="cl-copy-ic cl-copy-ic--done" aria-hidden="true">✓</span>
        <span class="cl-copy-label sr-only" data-copy-label aria-live="polite"
          >Copy</span
        >
      </button>
    </div>

    {/* secondary — star on GitHub */}
    <a
      class="cl-ghost"
      href={repoUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span aria-hidden="true">★</span> Star on GitHub
    </a>

    {/* subscribe → subscribe Worker (POST /api/subscribe) */}
    <form class="cl-sub" data-subscribe novalidate>
      <p class="cl-sub-cap">
        Release notes, occasionally. No spam, it’s a promise.
      </p>
      <div class="cl-sub-row">
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@email.com"
          aria-label="Email address"
        />
        {/* honeypot — hidden from humans, traps bots */}
        <input
          type="text"
          name="company"
          class="cl-hp"
          data-hp
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <button type="submit">Subscribe</button>
      </div>
      <p class="cl-sub-status" data-sub-status role="status" aria-live="polite">
      </p>
    </form>

    <ul class="cl-proof">
      <li>Free</li>
      <li>MIT</li>
      <li>Self-hosted</li>
      <li>Never auto-submits</li>
    </ul>
  </div>
</section>

<script>
  import { initScriptCopyButtons } from '../scripts/script-copy-button.js';
  import { initClosing } from '../scripts/closing.js';
  initClosing();
  initScriptCopyButtons();
</script>

<style>
  /* ── Dark section — the void (matches hero / §3) ── */
  .closing {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 120px 24px 132px;
    background:
      radial-gradient(
        circle at 50% 8%,
        color-mix(in oklab, var(--beauty-ember), transparent 82%),
        transparent 440px
      ),
      linear-gradient(180deg, #080808, #12100e 55%, #1b1410);
    color: var(--text-dark);
  }
  .cl-stars {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .cl-inner {
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── Destination star + arriving trajectory ── */
  .cl-sky {
    position: relative;
    width: min(460px, 82%);
    height: 176px;
    margin-bottom: 26px;
  }
  .cl-route {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .cl-route-bg {
    fill: none;
    stroke: color-mix(in oklab, var(--beauty-ember), transparent 82%);
    stroke-width: 1.4;
    stroke-dasharray: 3 6;
  }
  /* comet trail — fades from faint (origin) to bright (head), strong glow */
  .cl-route-draw {
    fill: none;
    stroke: url(#clTrail);
    stroke-width: 2.6;
    stroke-linecap: round;
    filter: drop-shadow(
      0 0 6px color-mix(in oklab, var(--beauty-ember), transparent 25%)
    );
  }

  /* waypoint comet head — a bright cross-flare sparkle at the route end.
     .cl-star is a 0×0 anchor at (50%, 83.3%); children center on the point. */
  .cl-star {
    position: absolute;
    left: 50%;
    top: 83.3%;
    width: 0;
    height: 0;
    opacity: 0;
    transition: opacity 0.45s var(--ease-calm) 0.45s;
  }
  .cl-star.is-lit {
    opacity: 1;
    animation: clStarPulse 3.4s var(--ease-calm) 1.1s infinite;
  }
  .cl-star-core {
    position: absolute;
    left: 0;
    top: 0;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: #fff6ee;
    box-shadow:
      0 0 6px 1px var(--beauty-ember-2),
      0 0 16px 5px color-mix(in oklab, var(--beauty-ember), transparent 35%),
      0 0 40px 14px color-mix(in oklab, var(--beauty-ember), transparent 62%);
  }
  .cl-flare {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%);
    background: linear-gradient(
      90deg,
      transparent,
      #fff1e4 47%,
      #fff 50%,
      #fff1e4 53%,
      transparent
    );
  }
  .cl-flare-h {
    width: 96px;
    height: 2px;
  }
  .cl-flare-v {
    width: 2px;
    height: 96px;
    background: linear-gradient(
      180deg,
      transparent,
      #fff1e4 47%,
      #fff 50%,
      #fff1e4 53%,
      transparent
    );
  }
  .cl-flare-d1 {
    width: 52px;
    height: 1.5px;
    opacity: 0.55;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .cl-flare-d2 {
    width: 52px;
    height: 1.5px;
    opacity: 0.55;
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  @keyframes clStarPulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.16);
      opacity: 0.92;
    }
  }

  /* ── Eyebrow + H2 ── */
  .cl-eyebrow {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--beauty-ember);
  }
  .cl-h2 {
    font-family: var(--font-display);
    font-size: clamp(30px, 5vw, 52px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--text-dark-hi);
    margin: 14px 0 32px;
    text-wrap: balance;
  }

  /* ── Install command box (primary CTA) ── */
  .cl-cmd {
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: 520px;
    background: var(--surface-dark);
    border: 1px solid var(--border-dark-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 18px 48px -24px rgba(0, 0, 0, 0.8);
  }
  .cl-cmd:focus-within {
    border-color: var(--accent-dark);
  }
  .cl-cmd-text {
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    padding: 15px 16px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-dark-2);
    text-align: left;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }
  .cl-copy {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    border-left: 1px solid var(--border-dark-strong);
    background: color-mix(in oklab, var(--accent-dark), transparent 86%);
    color: var(--accent-dark-t);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background var(--dur-quick),
      color var(--dur-quick);
  }
  .cl-copy:hover {
    background: color-mix(in oklab, var(--accent-dark), transparent 78%);
    color: #fff;
  }
  .cl-copy:focus-visible {
    outline: 2px solid var(--accent-dark);
    outline-offset: -2px;
  }
  .cl-copy-ic {
    font-size: 16px;
    line-height: 1;
  }
  /* icon-only: show the copy glyph by default, swap to a check once copied */
  .cl-copy-ic--done {
    display: none;
  }
  .cl-copy.is-copied {
    color: var(--tier-high);
    background: color-mix(in oklab, var(--tier-high), transparent 86%);
  }
  .cl-copy.is-copied .cl-copy-ic--copy {
    display: none;
  }
  .cl-copy.is-copied .cl-copy-ic--done {
    display: inline;
  }

  /* ── Ghost GitHub button (secondary) ── */
  .cl-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid var(--border-dark-strong);
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-dark-2);
    transition:
      border-color var(--dur-quick),
      color var(--dur-quick),
      background var(--dur-quick);
  }
  .cl-ghost:hover {
    border-color: var(--accent-dark);
    color: #fff;
    background: rgba(255, 255, 255, 0.03);
  }
  .cl-ghost:focus-visible {
    outline: 2px solid var(--accent-dark);
    outline-offset: 3px;
  }
  .cl-ghost span {
    color: var(--beauty-ember-2);
  }

  /* ── Subscribe ── */
  .cl-sub {
    width: 100%;
    max-width: 440px;
    margin-top: 40px;
  }
  .cl-sub-cap {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: 13.5px;
    color: var(--text-dark-muted);
  }
  .cl-sub-row {
    display: flex;
    gap: 8px;
  }
  .cl-sub-row input[type='email'] {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 46px;
    padding: 0 14px;
    background: var(--surface-dark);
    border: 1px solid var(--border-dark-strong);
    border-radius: var(--radius);
    color: var(--text-dark);
    font-family: var(--font-display);
    font-size: 14px;
  }
  .cl-sub-row input::placeholder {
    color: var(--text-dark-dim);
  }
  .cl-sub-row input:focus-visible {
    outline: none;
    border-color: var(--accent-dark);
    box-shadow: 0 0 0 3px
      color-mix(in oklab, var(--accent-dark), transparent 75%);
  }
  .cl-sub-row button {
    flex: 0 0 auto;
    min-height: 46px;
    padding: 0 20px;
    border: 0;
    border-radius: var(--radius);
    background: var(--accent-cta);
    color: #fff;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--dur-quick);
  }
  .cl-sub-row button:hover {
    background: var(--accent-cta-hover);
  }
  .cl-sub-row button:focus-visible {
    outline: 2px solid var(--accent-dark);
    outline-offset: 2px;
  }
  .cl-sub-row button:disabled {
    opacity: 0.6;
    cursor: default;
  }
  /* honeypot — off-screen, never shown */
  .cl-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .cl-sub-status {
    margin: 10px 0 0;
    min-height: 1.2em;
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--text-dark-muted);
  }
  .cl-sub[data-state='error'] .cl-sub-status {
    color: var(--tier-low);
  }
  .cl-sub[data-state='success'] .cl-sub-status {
    color: var(--tier-high);
  }
  /* once subscribed, retire the field and show only the confirmation */
  .cl-sub[data-state='success'] .cl-sub-row {
    display: none;
  }

  /* ── Micro-proof — pill chips matching the hero CTA chips ── */
  .cl-proof {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .cl-proof li {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(244, 244, 245, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(10, 10, 11, 0.72);
    border-radius: var(--radius-pill);
    padding: 7px 14px;
    box-shadow: 0 14px 34px -22px rgba(255, 106, 42, 0.8);
  }

  /* ── Responsive ── */
  @media (max-width: 720px) {
    .closing {
      padding: 88px 18px 96px;
    }
    .cl-sky {
      width: min(320px, 84%);
      height: 130px;
    }
    .cl-cmd {
      max-width: 100%;
    }
    .cl-cmd-text {
      font-size: 13px;
      padding: 14px;
    }
    .cl-sub-row {
      flex-wrap: wrap;
    }
    .cl-sub-row input[type='email'] {
      flex: 1 1 100%;
    }
    .cl-sub-row button {
      flex: 1 1 100%;
    }
  }

  /* ── Reduced motion: completed route + lit star, no draw/pulse/twinkle ── */
  @media (prefers-reduced-motion: reduce) {
    .cl-route-draw {
      transition: none;
    }
    .cl-star {
      opacity: 1;
      transition: none;
    }
    .cl-star.is-lit {
      animation: none;
    }
  }
</style>
