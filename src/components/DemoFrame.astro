  min-width: 0;
}
.m-phase-3 .m-legit-pill {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 8px;
  background: rgba(142,186,137,0.12);
  color: var(--tier-high);
  border-radius: 999px;
  font-family: var(--font-mono);
