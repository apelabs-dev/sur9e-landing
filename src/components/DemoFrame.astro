/* ===== Animated demo ===== */
.demo-frame {
  max-width: 1100px;
  margin: 0 auto;
  background: linear-gradient(180deg, #0e0d0e 0%, #151210 100%);
  border: 1px solid var(--border-dark);
  border-radius: 14px;
  overflow: hidden;
  /* Presentational shadow stack — reads as an elevated "screen" rather
     than a flat panel. Layers (inside → out):
       1. inset top sheen   — suggests glass/screen highlight
       2. contact shadow    — tight, anchors the frame
       3. mid-lift          — soft drop, the main "elevation"
       4. deep ambient      — long-distance halo, gives premium weight
       5. accent halo       — branded glow, separates from the page bg */
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.08),
    0 1px 2px rgba(0, 0, 0, 0.18),
    0 14px 32px -8px rgba(0, 0, 0, 0.42),
    0 52px 100px -28px rgba(0, 0, 0, 0.55),
    0 0 80px -20px rgba(255, 90, 31, 0.22);
  position: relative;
  aspect-ratio: 16 / 12;
  color: var(--text-dark);
  font-family: var(--font-body);
}
/* Branded halo behind the screen — polish layer */
.demo-frame::after {
  content: "";
  position: absolute; inset: -3px;
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(255,90,31,0.38), transparent 45%, rgba(255,90,31,0.28) 100%);
  z-index: -1;
  filter: blur(22px);
  opacity: 0.75;
  pointer-events: none;
}
.demo-chrome {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 36px;
  display: flex; align-items: center; gap: 6px;
  padding: 0 14px;
  border-bottom: 1px solid var(--border-dark-faint);
  background: rgba(255,255,255,0.02);
  z-index: 4;
  min-width: 0;
  overflow: hidden;
}
.demo-chrome .dot {
  width: 11px; height: 11px; border-radius: 50%;
  background: var(--border-dark);
  border: 1px solid rgba(0,0,0,0.3);
  box-shadow: 0 1px 0 rgba(255,255,255,0.04) inset;
  flex-shrink: 0;
}
.demo-chrome .dot.close    { background: #c44a3f; border-color: #8a322a; }
.demo-chrome .dot.minimize { background: #c08a2a; border-color: #7d5817; }
.demo-chrome .dot.maximize { background: #2e8a44; border-color: #1d5a2c; }
.demo-chrome .url {
