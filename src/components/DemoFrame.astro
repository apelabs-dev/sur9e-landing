  font-size: 11px;
  color: var(--text-dark-muted);
  flex-shrink: 0;
}
.m-phase-2 .m-loader-phases {
  padding: 4px 14px 16px;
  display: flex; flex-direction: column; gap: 8px;
  font-family: var(--font-body);
  font-size: 12.5px;
