  margin-bottom: 10px;
}
.m-phase-3 .m-score-block { display: flex; flex-direction: column; gap: 5px; }
.m-phase-3 .m-score-numeral {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 48px;
  line-height: 0.85;
