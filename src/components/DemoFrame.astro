/* Pause / collapse animation if user prefers reduced motion */
@media (prefers-reduced-motion: reduce) {
  .demo-mobile .m-phase-1,
  .demo-mobile .m-phase-2 { display: none; }
  .demo-mobile .m-phase-3 { animation: none; opacity: 1; }
  .phase-1, .phase-2 { display: none; }
  .phase-3 { animation: none; opacity: 1; transform: none; }
  .demo-progress .seg::after { animation: none; inset: 0 0 0 0; }
  .demo-cursor { display: none; }
  .demo-pause { display: none; }
}

/* Demo pause control */
.demo-pause {
  position: absolute;
  top: 44px;
  right: 8px;
  z-index: 6;
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  padding: 0;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.14);
  color: var(--text-dark-2);
  border-radius: 999px;
  cursor: pointer;
  transition: background var(--dur-quick), border-color var(--dur-quick), color var(--dur-quick);
}
.demo-pause:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.22);
  color: var(--text-dark);
}
.demo-pause svg { width: 14px; height: 14px; display: block; }
.demo-pause .pause-glyph { display: block; }
.demo-pause .play-glyph { display: none; }
.demo-pause[aria-pressed="true"] .pause-glyph { display: none; }
.demo-pause[aria-pressed="true"] .play-glyph { display: block; }
.demo-frame.paused .phase,
.demo-frame.paused .demo-progress .seg::after,
.demo-frame.paused .demo-cursor,
.demo-frame.paused .loader-phases li,
.demo-frame.paused .radar-poly,
.demo-frame.paused .phase-1 .input-wrap,
.demo-frame.paused .demo-mobile .m-phase {
  animation-play-state: paused !important;
}
</style>

<script>
  // Demo pause toggle
  const demoFrame = document.getElementById('demoFrame');
  const demoPauseBtn = document.getElementById('demoPause');
  if (demoFrame && demoPauseBtn) {
    demoPauseBtn.addEventListener('click', () => {
      const willPause = !demoFrame.classList.contains('paused');
      demoFrame.classList.toggle('paused', willPause);
      demoPauseBtn.setAttribute('aria-pressed', willPause ? 'true' : 'false');
      demoPauseBtn.setAttribute('aria-label', willPause ? 'Play demo animation' : 'Pause demo animation');
    });
  }

  // Parallax on demo frame — skip for reduced motion
  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const demo = document.querySelector('.demo-frame');
  if (demo && !motionQuery.matches) {
    window.addEventListener('scroll', () => {
      const r = demo.getBoundingClientRect();
      const vh = window.innerHeight;
      const t = Math.max(-1, Math.min(1, (r.top + r.height/2 - vh/2) / vh));
      demo.style.transform = `translateY(${t * -8}px)`;
    }, { passive: true });
  }
</script>
