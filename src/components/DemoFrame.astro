.m-phase-2 .m-loader-phases li:nth-child(1) { animation: phaseProgress 8s linear infinite; }
.m-phase-2 .m-loader-phases li:nth-child(2) { animation: phaseProgress2 8s linear infinite; }
.m-phase-2 .m-loader-phases li:nth-child(3) { animation: phaseProgress3 8s linear infinite; }
.m-phase-2 .m-loader-phases li:nth-child(4) { animation: phaseProgress4 8s linear infinite; }

/* ---------- Phase 3 — report (mirrors desktop .rpt-* / .snapshot-merged) ---------- */
