}
.m-phase-3 .m-legit-pill svg { width: 10px; height: 10px; flex-shrink: 0; }
.m-phase-3 .m-archetype-tag {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--text-dark-muted);
