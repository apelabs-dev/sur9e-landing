  animation: pulseDot 1.2s ease-in-out infinite;
}
.loader-title {
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 500;
  color: var(--text-dark);
}
.loader-sub {
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--text-dark-muted);
  margin-left: auto;
}
.loader-phases {
  padding: 6px 22px 22px;
  display: flex; flex-direction: column; gap: 9px;
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--text-dark-muted);
}
.loader-phases li {
  display: flex; align-items: center; gap: 8px;
  list-style: none;
  opacity: 0.35;
  transition: opacity 240ms;
}
.loader-phases li::before {
  content: "";
  width: 5px; height: 5px;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.5;
}
.loader-phases li.done {
  opacity: 0.5; color: var(--tier-high);
}
.loader-phases li.done::before {
  background: var(--tier-high);
  opacity: 1;
}
.loader-phases li.active {
  opacity: 1; color: var(--text-dark);
}
.loader-phases li.active::before {
  background: var(--accent);
}
.loader-phases li:nth-child(1) { animation: phaseProgress 8s linear infinite; }
.loader-phases li:nth-child(2) { animation: phaseProgress2 8s linear infinite; }
.loader-phases li:nth-child(3) { animation: phaseProgress3 8s linear infinite; }
.loader-phases li:nth-child(4) { animation: phaseProgress4 8s linear infinite; }

/* PHASE 3 — Report (mirrors real hero + snapshot from report-render-v2.js) */
.phase-3 {
  justify-content: center;
  align-items: center;
  padding: 0;
  overflow: hidden;
}
.phase-3-inner {
  width: 100%;
  max-width: 1040px;
  padding: 18px 36px;
  transform: scale(0.96);
  transform-origin: center center;
}
.rpt-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 28px;
  align-items: end;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border-dark);
}
.rpt-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--font-display);
  font-size: 13px;
  font-weight: 500;
  color: var(--text-dark-muted);
  margin-bottom: 14px;
}
.rpt-eyebrow .e-dot {
  width: 3px; height: 3px;
  background: var(--text-dark-faint);
  border-radius: 50%;
}
.rpt-pill {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 3px 10px;
  border: 1px solid var(--tier-high);
  color: var(--tier-high);
  border-radius: 999px;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.04em;
}
.rpt-pill::before {
  content: "";
  width: 5px; height: 5px;
  background: currentColor;
  border-radius: 50%;
}
.rpt-id-row {
  display: flex; align-items: center; gap: 12px;
  margin-bottom: 14px;
}
.company-mark {
  width: 54px; height: 54px;
  border-radius: 12px;
  background: #1f1d20;
  border: 1px solid var(--border-dark);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 24px;
  letter-spacing: -0.02em;
  color: var(--text-dark);
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}
.company-mark::after {
  content: "";
  position: absolute;
  bottom: 0; right: 0;
  width: 11px; height: 11px;
  background: var(--accent);
  border-top-left-radius: 6px;
}
.company-mark svg {
  width: 28px; height: 28px;
  color: var(--text-dark);
  display: block;
}
.rpt-id-row h3 {
  font-family: var(--font-display);
  font-size: 28px;
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.02;
  margin: 0;
  color: var(--text-dark);
}
.rpt-role {
  font-size: 15px;
  color: var(--text-dark-2);
  margin: 4px 0 0;
}
.rpt-meta-strip {
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1px solid var(--border-dark);
  font-family: var(--font-display);
  font-size: 13.5px;
  color: var(--text-dark-2);
  display: flex; flex-wrap: wrap;
  column-gap: 8px; row-gap: 4px;
}
.rpt-meta-strip .sep { color: var(--text-dark-faint); }
.rpt-hero-right {
  display: flex; flex-direction: column;
  align-items: flex-end;
  gap: 9px;
  padding-bottom: 2px;
}
.score-numeral {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 108px;
  line-height: 0.85;
  letter-spacing: -0.055em;
  color: var(--tier-high);
  display: inline-flex; align-items: flex-start; gap: 4px;
  /* Subtle glow — polish layer */
  text-shadow: 0 0 40px rgba(142,186,137,0.25);
}
.score-numeral .denom {
  font-family: var(--font-mono);
  font-weight: 500;
  font-size: 16px;
  color: var(--text-dark-muted);
  margin-top: 14px;
  align-self: flex-start;
}
.score-bar { display: flex; gap: 4px; width: 180px; }
.score-bar .seg {
  flex: 1; height: 5px; border-radius: 2px;
  background: var(--border-dark);
}
.score-bar .seg.on { background: var(--tier-high); }
.legit-pill {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 4px 11px;
  background: rgba(142,186,137,0.12);
  color: var(--tier-high);
  border-radius: 999px;
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.02em;
}
.legit-pill svg {
  width: 12px; height: 12px;
  stroke: currentColor; fill: none;
  stroke-width: 2; stroke-linejoin: round;
}
.archetype-tag {
  font-family: var(--font-mono);
  font-size: 11.5px;
  color: var(--text-dark-muted);
  letter-spacing: 0.02em;
}
.rpt-block-head {
  display: flex; align-items: baseline; justify-content: space-between;
  margin: 16px 0 0;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border-dark);
}
.rpt-block-title {
  font-family: var(--font-display);
  font-size: 19px;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--text-dark);
  margin: 0;
}
.rpt-block-meta {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-dark-muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.rpt-lede {
  margin: 10px 0 0;
  padding: 14px 16px;
  border-top: 1px solid var(--border-dark);
  border-bottom: 1px solid var(--border-dark);
  background: rgba(255,255,255,0.03);
  font-family: var(--font-display);
  font-size: 15.5px;
  font-weight: 500;
  line-height: 1.55;
  letter-spacing: -0.012em;
  color: var(--text-dark);
  text-wrap: pretty;
}
.snapshot-merged {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 16px;
  row-gap: 6px;
  margin-top: 12px;
  padding: 11px 14px 12px;
  border: 1px solid var(--border-dark);
  border-radius: 8px;
  background: rgba(255,255,255,0.015);
  align-items: center;
}
.matrix-label {
  grid-column: 1 / -1;
  font-family: var(--font-display);
  font-size: 12.5px;
  font-weight: 500;
  color: var(--text-dark-muted);
  margin-bottom: -2px;
}
.verdict-stack {
  display: flex; flex-direction: column;
  gap: 8px;
}
.gap-card {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 11px;
  padding: 10px 12px;
  border: 1px solid var(--border-dark);
  border-radius: 8px;
  align-items: center;
  background: rgba(10,10,11,0.5);
}
.gap-sev-bar {
  width: 3px;
  align-self: stretch;
  border-radius: 2px;
  background: var(--tier-high);
}
.gap-card.watch .gap-sev-bar { background: var(--tier-low); }
.gap-title {
  font-family: var(--font-display);
  font-size: 13px;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 3px;
  letter-spacing: -0.005em;
}
.gap-mit {
  font-size: 12.5px;
  color: var(--text-dark-2);
  line-height: 1.45;
}
.gap-mit strong { color: var(--text-dark); font-weight: 600; }
.sev {
  font-family: var(--font-mono);
  font-size: 10.5px;
  padding: 3px 7px;
  border-radius: 4px;
  letter-spacing: 0.04em;
  text-transform: lowercase;
  white-space: nowrap;
}
.sev.low { background: rgba(142,186,137,0.14); color: var(--tier-high); }
.sev.high { background: rgba(214,138,126,0.16); color: var(--tier-low); }
.matrix-pane {
  display: flex; flex-direction: column;
  gap: 4px; width: 100%;
}
.cd-radar { padding: 0 6px; box-sizing: border-box; }
.cd-radar svg { display: block; width: 100%; height: auto; max-height: 220px; }
.cd-radar-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 16px;
}
.cd-radar-list .row {
  display: flex; justify-content: space-between;
  padding: 5px 0;
  border-bottom: 1px dashed var(--border-dark);
  align-items: baseline;
}
.cd-radar-list .row:nth-last-child(-n+2) { border-bottom: none; }
.cd-radar-list .k {
  font-family: var(--font-display);
  color: var(--text-dark-muted);
  font-size: 12.5px;
}
.cd-radar-list .v {
  font-family: var(--font-display);
  font-weight: 500;
  color: var(--text-dark);
  font-variant-numeric: tabular-nums;
  font-size: 13.5px;
}

/* Phase orchestration: 8s loop. */
.phase-1 { animation: phase1 8s linear infinite; }
.phase-2 { animation: phase2 8s linear infinite; }
.phase-3 { animation: phase3 8s linear infinite; }

.radar-poly {
  opacity: 0;
  animation: radarReveal 8s linear infinite;
  transform-origin: center;
  transition: filter 400ms;
}
.cd-radar:hover .radar-poly { filter: drop-shadow(0 0 6px rgba(255,90,31,0.6)); }

@media (max-width: 720px) {
  .demo-frame { aspect-ratio: auto; min-height: 720px; }
  .score-numeral { font-size: 56px; }
  .rpt-hero { grid-template-columns: 1fr; gap: 12px; align-items: start; }
  .rpt-hero-right { align-items: flex-start; }
  .snapshot-merged { grid-template-columns: 1fr; row-gap: 10px; }
  .cd-radar-list { grid-template-columns: 1fr 1fr; }
}

.demo-mobile { display: none; }
/* Mobile demo also takes over at tablet widths — desktop demo only at ≥1025 px */
@media (max-width: 1024px) {
  .demo-frame > .demo-chrome ~ *:not(.demo-mobile) { display: none; }
  .demo-frame > .demo-chrome { display: flex; }
  .demo-frame { min-height: 0; aspect-ratio: auto; }
  .demo-frame .demo-mobile { display: block; }
}

/* ===== Mobile demo — 3-phase animation, mirrors desktop (8s linear infinite)
        Reuses desktop keyframes: phase1/2/3, typing8, focusGlow, blink, pulse8,
        loaderFill8, pulseDot, phaseProgress1..4 — so timing matches exactly. */
.demo-mobile {
  position: relative;
  margin: 60px 14px 22px;
  min-height: 620px;
  color: var(--text-dark);
  font-family: var(--font-body);
}
.demo-mobile .m-phase {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  will-change: opacity, transform;
}
.demo-mobile .m-phase-1 { animation: phase1 8s linear infinite; }
.demo-mobile .m-phase-2 { animation: phase2 8s linear infinite; }
.demo-mobile .m-phase-3 { animation: phase3 8s linear infinite; }

/* ---------- Phase 1 — paste a job URL ---------- */
.m-phase-1 { justify-content: center; align-items: center; text-align: center; padding: 0 12px; }
.m-phase-1 .m-label {
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-dark-muted);
  font-weight: 500;
  margin-bottom: 22px;
}
.m-phase-1 .m-input-wrap {
  display: flex; align-items: center; gap: 8px;
  background: #1a1a1d;
  border: 1px solid var(--border-dark);
  border-radius: 12px;
  padding: 8px 8px 8px 14px;
  width: 100%;
  box-shadow: 0 0 0 0 rgba(255,90,31,0.3);
  animation: focusGlow 8s var(--ease-calm) infinite;
}
.m-phase-1 .m-url-text {
  flex: 1;
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--text-dark);
  white-space: nowrap;
  overflow: hidden;
  text-align: left;
  position: relative;
  min-width: 0;
}
.m-phase-1 .m-placeholder {
  position: absolute; left: 0; top: 0;
  color: var(--text-dark-faint);
  pointer-events: none;
  animation: hidePlaceholder8 8s linear infinite;
}
.m-phase-1 .m-typed {
  display: inline-block;
  overflow: hidden;
  white-space: nowrap;
  width: 0;
  vertical-align: bottom;
  animation: typing8 8s linear infinite;
}
.m-phase-1 .m-cursor {
  display: inline-block;
  width: 2px; height: 14px;
  background: var(--accent);
  vertical-align: middle;
  margin-left: 2px;
  animation: blink 0.8s steps(2, start) infinite;
}
.m-phase-1 .m-score-btn {
  background: var(--accent-cta);
  color: #fff;
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 500;
  padding: 8px 12px;
  border-radius: 7px;
  white-space: nowrap;
  flex-shrink: 0;
  animation: pulse8 8s linear infinite;
}
/* Animated cursor that glides to the Score button and clicks (mobile/tablet).
   Final position is anchored to a fixed pixel offset from the right edge so
   the tip lands on the Score button at any viewport width. */
.m-phase-1 .m-demo-cursor {
  position: absolute;
  top: 50%;
  left: 28%;
  width: 20px; height: 20px;
  pointer-events: none;
  opacity: 0;
  z-index: 6;
  color: #fff;
  filter: drop-shadow(0 3px 6px rgba(0,0,0,0.55));
  animation: mCursorMove 8s var(--ease-calm) infinite;
}
.m-phase-1 .m-demo-cursor svg { width: 100%; height: 100%; display: block; }
.m-phase-1 .m-click-ring {
  position: absolute;
  top: 2px; left: 2px;
  width: 10px; height: 10px;
  border-radius: 50%;
  border: 2px solid var(--accent);
  transform: scale(0);
  transform-origin: center;
  opacity: 0;
  animation: mCursorClickRing 8s linear infinite;
}

/* ---------- Phase 2 — loading modal ---------- */
.m-phase-2 { justify-content: center; align-items: center; padding: 0 8px; }
.m-phase-2 .m-loader-card {
  width: 100%;
  background: #18171a;
  border: 1px solid var(--border-dark);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 18px 36px -16px rgba(0,0,0,0.6);
}
.m-phase-2 .m-loader-bar {
  position: relative; height: 2px; width: 100%;
  background: var(--border-dark);
}
.m-phase-2 .m-loader-fill {
  position: absolute; inset: 0 auto 0 0;
  background: var(--accent);
  width: 0;
  animation: loaderFill8 8s linear infinite;
}
.m-phase-2 .m-loader-head {
  padding: 14px 14px 10px;
  display: flex; align-items: center; gap: 10px;
}
.m-phase-2 .m-loader-dot {
  width: 7px; height: 7px; border-radius: 50%;
